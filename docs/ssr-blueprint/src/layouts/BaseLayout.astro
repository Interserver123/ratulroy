---
// Document shell: meta, Open Graph, canonical, JSON-LD, fonts and LCP preload.
// Ships zero JavaScript unless a child component opts into hydration.
import { Font, getImage } from "astro:assets";
import { jsonLdString, normalizeSeo, type Seo } from "../lib/seo";

interface Props {
  seo: Seo;
  /** The above-the-fold hero image: preloaded so LCP starts with the HTML. */
  lcpImage?: { src: string; width: number; height: number };
}
const { lcpImage } = Astro.props;
const seo = normalizeSeo(Astro.props.seo);
const siteName = "Example Site";

// Same optimised URL the <Image> in the page will request, so the preload is reused.
const lcp = lcpImage
  ? await getImage({ src: lcpImage.src, width: lcpImage.width, height: lcpImage.height, widths: [480, 800, 1200], format: "webp" })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={seo.noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />

    <!-- Open Graph / social -->
    <meta property="og:type" content={seo.type ?? "website"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {
      seo.image && (
        <>
          <meta property="og:image" content={seo.image.url} />
          <meta property="og:image:width" content={String(seo.image.width)} />
          <meta property="og:image:height" content={String(seo.image.height)} />
          <meta property="og:image:alt" content={seo.image.alt} />
        </>
      )
    }
    {seo.publishedAt && <meta property="article:published_time" content={seo.publishedAt} />}
    {seo.updatedAt && <meta property="article:modified_time" content={seo.updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: self-hosted, preloaded, size-adjusted fallback to avoid layout shift -->
    <Font cssVariable="--font-sans" preload />

    <!-- LCP image starts downloading in parallel with CSS -->
    {lcp && <link rel="preload" as="image" href={lcp.src} imagesrcset={lcp.srcSet.attribute} imagesizes="(min-width: 1024px) 800px, 100vw" fetchpriority="high" />}

    {seo.jsonLd?.length ? <script type="application/ld+json" set:html={jsonLdString(seo.jsonLd)} /> : null}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  :root { --font: var(--font-sans), system-ui, sans-serif; color-scheme: light; }
  body { margin: 0; font-family: var(--font); line-height: 1.6; color: #111; background: #fff; }
  img { max-width: 100%; height: auto; } /* keeps intrinsic ratio from width/height attributes */
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 1rem; top: 1rem; }
</style>
