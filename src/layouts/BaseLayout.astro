---
import "../styles/global.css";
import FontFaces from "../components/FontFaces.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { ogCardUrl, OG_SIZE } from "../lib/og";
import SchemaGraph from "../components/SchemaGraph.astro";

interface Props {
  title: string;
  description: string;
  /** Override the page's generated 1200x630 card (public/og/<route>.jpg). Rarely needed. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** JSON-LD objects; they are merged into one @graph. */
  schema?: Record<string, unknown>[];
}

const { title, description, ogImage, ogImageAlt, ogType = "website", noindex = false, schema = [] } =
  Astro.props;

// Canonical is always the production origin (Astro.site), never the host being served,
// so staging clones (*.pages.dev, *.vercel.app, *.lovable.app) canonicalise to ratulroy.com.
const origin = (Astro.site ?? new URL(site.url)).origin;
const path =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/(^|\/)index$/, "")
    .replace(/\/$/, "") || "/";
const canonical = new URL(path, origin).href;

// Anything not served from ratulroy.com (or www) is a preview/staging clone: never index it.
// Dev server and the static build both use localhost/production hosts, so only the request
// host of a deployed SSR preview can trip this; static previews are covered by public/_headers.
const host = Astro.url.hostname;
const isProd = host === new URL(origin).hostname || host === `www.${new URL(origin).hostname}`;
const isLocal = host === "localhost" || host === "127.0.0.1";
const blockIndexing = noindex || (!isProd && !isLocal);

// Every page gets a share image: an explicit override, else its generated card, else the site card.
const ogImageUrl = ogImage ? new URL(ogImage, origin).href : ogCardUrl(Astro.url.pathname);
const ogAlt = ogImageAlt ?? `${title} · ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Failsafe: if the motion script never runs, show everything.
      setTimeout(function () {
        if (!window.__motion) document.documentElement.classList.remove("js");
      }, 2500);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={blockIndexing ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    {/* Static builds are rendered at build time with the production host, so the server-side check above
        can't see a preview URL. This guard flips robots to noindex when the page is served elsewhere. */}
    <script is:inline define:vars={{ prodHost: new URL(origin).hostname }}>
      (function () {
        var h = location.hostname;
        if (h === prodHost || h === "www." + prodHost || h === "localhost" || h === "127.0.0.1") return;
        var m = document.querySelector('meta[name="robots"]');
        if (m) m.setAttribute("content", "noindex, nofollow");
        var c = document.querySelector('link[rel="canonical"]');
        if (c) c.setAttribute("href", "https://" + prodHost + location.pathname);
      })();
    </script>
    <meta name="theme-color" content="#f4f7f6" />
    <FontFaces />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <SchemaGraph nodes={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div data-nosnippet><Header /></div>
    <main id="main-content">
      <slot />
    </main>
    <div data-nosnippet><Footer /></div>
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
