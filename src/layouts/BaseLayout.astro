---
import "../styles/global.css";
import FontFaces from "../components/FontFaces.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { ogCardUrl, OG_SIZE } from "../lib/og";
import { completeGraph } from "../lib/schema";
import { getImage } from "astro:assets";
import { img } from "../lib/img";

interface Props {
  title: string;
  description: string;
  /** Override the page's generated 1200x630 card (public/og/<route>.jpg). Rarely needed. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** JSON-LD objects; they are merged into one @graph. */
  schema?: Record<string, unknown>[];
}

const { title, description, ogImage, ogImageAlt, ogType = "website", noindex = false, schema = [] } =
  Astro.props;

// Canonical without trailing slash, matching the live URLs.
const path =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/(^|\/)index$/, "")
    .replace(/\/$/, "") || "/";
const canonical = new URL(path, site.url).href;
// Every page gets a share image: an explicit override, else its generated card, else the site card.
const ogImageUrl = ogImage ? new URL(ogImage, site.url).href : ogCardUrl(Astro.url.pathname);
const ogAlt = ogImageAlt ?? `${title} · ${site.name}`;

// One JSON-LD graph per page; referenced site entities are always defined on the page.
const portraitImg = await getImage({ src: img("people/ratul-roy-portrait.jpg"), width: 400, format: "jpg" });
const entityImage = new URL(portraitImg.src, site.url).href;
const graph = schema.length ? completeGraph(schema, entityImage) : [];
// Escape "<" so content can never close the script tag early.
const jsonLd = graph.length ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Failsafe: if the motion script never runs, show everything.
      setTimeout(function () {
        if (!window.__motion) document.documentElement.classList.remove("js");
      }, 2500);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#f4f7f6" />
    <FontFaces />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
