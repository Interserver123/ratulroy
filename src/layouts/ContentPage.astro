---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import Sections from "../components/page/Sections.astro";
import PageFaq from "../components/page/PageFaq.astro";
import Pricing from "../components/page/Pricing.astro";
import Related from "../components/page/Related.astro";
import FinalCta from "../components/page/FinalCta.astro";
import Results from "../components/home/Results.astro";
import CaseStudies from "../components/home/CaseStudies.astro";
import JumpNav from "../components/page/JumpNav.astro";
import TrustBar from "../components/page/TrustBar.astro";
import HubGrid from "../components/page/HubGrid.astro";
import { getCollection, getEntry } from "astro:content";
import StickyCta from "../components/page/StickyCta.astro";
import { Image } from "astro:assets";
import { img } from "../lib/img";
import { ogCardUrl, OG_SIZE } from "../lib/og";
import { md, plain, slugify } from "../lib/md";
import { site } from "../data/site";
import type { CollectionEntry } from "astro:content";

interface Props {
  data: CollectionEntry<"pages">["data"];
  path: string; // e.g. "/technical-seo"
  kind?: "service" | "industry" | "case" | "page";
  extraSchema?: Record<string, unknown>[]; // page-specific JSON-LD (e.g. JobPosting)
}
const { data: d, path, kind = "page", extraSchema = [] } = Astro.props;
const url = `${site.url}${path}`;

// Social share image: the page's hero screenshot, else the default.
const ogUrl = ogCardUrl(path);
const portrait = img("people/ratul-roy-portrait.jpg");
const updatedIso = d.updated?.toISOString().slice(0, 10);
const fmtDate = (x: Date) => x.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

// Price offers from any pricing section, for the Service schema.
const tiers = d.sections.filter((s) => s.type === "pricing").flatMap((s) => s.tiers ?? []);
const offers = tiers.map((t) => {
  const n = t.price.match(/\$\s?([\d,]+)/)?.[1]?.replace(/,/g, "");
  return {
    "@type": "Offer",
    name: t.name,
    description: t.for ?? t.text,
    priceCurrency: "USD",
    ...(n ? { priceSpecification: { "@type": "PriceSpecification", minPrice: n, priceCurrency: "USD" } } : {}),
    url: `${url}#pricing`,
  };
});

const jump = d.jumpNav
  ? [
      ...d.sections.filter((s) => s.nav).map((s) => ({ id: s.id ?? slugify(s.nav), label: s.nav! })),
      ...(d.faqs.length ? [{ id: "faq", label: "FAQ" }] : []),
    ]
  : [];

// Proof-first: chosen case studies (and the screenshot portfolio) right after the hero.
const proofCases = (await Promise.all(d.proofFirst.map((id) => getEntry("cases", id))))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .map((e) => ({
    href: `/case-studies/${e.id}`,
    title: e.data.card?.title ?? e.data.h1,
    text: e.data.card?.text ?? e.data.description,
    category: e.data.card?.category,
    value: e.data.card?.value,
    label: e.data.card?.label,
    image: e.data.card?.image ?? e.data.heroImage,
  }));
const proofFirst = proofCases.length > 0;

const crumbs = d.breadcrumb ?? [
  { label: "Home", href: "/" },
  { label: d.eyebrow ?? d.h1, href: path },
];

// Hub pages list what they link to (CollectionPage + ItemList); contact pages are ContactPage.
const hubItems: { name: string; url: string }[] =
  path === "/blog"
    ? (await getCollection("blog")).sort((a, b) => +b.data.date - +a.data.date).map((e) => ({ name: e.data.title, url: `${site.url}/blog/${e.id}` }))
    : path === "/industries"
      ? (await getCollection("industries")).map((e) => ({ name: e.data.eyebrow ?? e.data.h1, url: `${site.url}/industries/${e.id}` }))
      : path === "/case-studies"
        ? (await getCollection("cases")).map((e) => ({ name: e.data.card?.title ?? e.data.h1, url: `${site.url}/case-studies/${e.id}` }))
        : path === "/services"
          ? d.sections
              .filter((x) => x.type === "cards")
              .flatMap((x) => x.items ?? [])
              .filter((i) => i.href?.startsWith("/") && !i.href.startsWith("/blog"))
              .map((i) => ({ name: i.title, url: `${site.url}${i.href}` }))
              .filter((it, i, all) => all.findIndex((x) => x.url === it.url) === i)
          : [];
const pageType = kind === "case" ? "Article" : hubItems.length ? "CollectionPage" : ["/contact", "/book-strategy-call"].includes(path) ? "ContactPage" : "WebPage";

const schema: Record<string, unknown>[] = [
  {
    "@type": pageType,
    "@id": `${url}#webpage`,
    url,
    name: d.title,
    ...(kind === "case" ? { headline: d.h1, author: { "@id": `${site.url}/#person` } } : {}),
    ...(updatedIso ? { dateModified: updatedIso, author: { "@id": `${site.url}/#person` } } : {}),
    primaryImageOfPage: { "@type": "ImageObject", url: ogUrl, width: OG_SIZE.width, height: OG_SIZE.height },
    ...(d.entities.length ? { about: d.entities.map((e) => ({ "@type": "Thing", name: e.name, sameAs: e.sameAs })) } : {}),
    description: d.description,
    inLanguage: "en",
    isPartOf: { "@id": `${site.url}/#website` },
    breadcrumb: { "@id": `${url}#breadcrumb` },
    ...(pageType === "ContactPage" ? { mainEntity: { "@id": `${site.url}/#business` } } : {}),
    ...(hubItems.length
      ? {
          mainEntity: {
            "@type": "ItemList",
            numberOfItems: hubItems.length,
            itemListElement: hubItems.map((it, i) => ({ "@type": "ListItem", position: i + 1, name: it.name, url: it.url })),
          },
        }
      : {}),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.label,
      item: `${site.url}${c.href === "/" ? "/" : c.href}`,
    })),
  },
];
if (kind === "service" || kind === "industry") {
  schema.push({
    "@type": "Service",
    "@id": `${url}#service`,
    name: d.eyebrow ?? d.h1,
    description: d.description,
    serviceType: d.eyebrow ?? d.h1,
    provider: { "@id": `${site.url}/#business` },
    ...(kind === "industry" && d.card?.title ? { audience: { "@type": "BusinessAudience", audienceType: `${d.card.title} businesses` } } : {}),
    areaServed: [{ "@type": "Country", name: "Bangladesh" }, "Worldwide"],
    ...(offers.length
      ? {
          hasOfferCatalog: { "@type": "OfferCatalog", name: `${d.eyebrow ?? d.h1} packages`, itemListElement: offers },
          offers: { "@type": "AggregateOffer", priceCurrency: "USD", lowPrice: "299", offerCount: offers.length },
        }
      : { offers: { "@type": "Offer", priceCurrency: "USD", price: "299", description: "Packages start from $299" } }),
    ...(d.entities.length ? { about: d.entities.map((e) => ({ "@type": "Thing", name: e.name, sameAs: e.sameAs })) } : {}),
  });
}
schema.push(...extraSchema);
if (d.faqs.length) {
  schema.push({
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: d.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: plain(f.a) } })),
  });
}
---

<BaseLayout title={d.title} description={d.description} schema={schema} ogType={kind === "case" ? "article" : "website"}>
  <PageHero
    breadcrumb={crumbs}
    eyebrow={d.eyebrow}
    h1={d.h1}
    em={d.em}
    lead={d.lead}
    sub={d.sub}
    heroBullets={d.heroBullets}
    heroChips={d.heroChips}
    heroStats={d.heroStats}
    heroImage={d.heroImage}
    ctas={d.ctas}
    heroForm={d.heroForm}
    heroShowcase={d.heroShowcase}
  />
  {d.trustBar && <TrustBar />}
  {
    proofFirst && (
      <>
        <HubGrid
          items={proofCases}
          variant="case"
          eyebrow="Proof first"
          heading="Real results before the sales pitch"
          intro="Case studies from real campaigns, with the screenshots to back them up. Read the method after, if the numbers are what you are after."
        />
        {d.showResults && <Results />}
      </>
    )
  }

  {
    d.intro && (
      <section class="section pintro">
        <div class="container">
          <div class="pintro__box" data-reveal>
            {d.intro.map((p) => <p set:html={md(p)} />)}
            {
              updatedIso && (
                <p class="pintro__by">
                  <Image src={portrait} alt="" width={64} height={64} />
                  <span>
                    Written by <a href="/about">Ratul Roy</a>, Local SEO specialist · Updated <time datetime={updatedIso}>{fmtDate(d.updated!)}</time>
                  </span>
                </p>
              )
            }
          </div>
        </div>
      </section>
    )
  }

  {jump.length > 0 && <JumpNav items={jump} />}
  <slot name="before" />
  <Sections sections={d.sections} />
  <slot />
  {d.showResults && !proofFirst && <Results />}
  {d.showCases && !proofFirst && <CaseStudies />}
  <PageFaq heading={d.faqHeading} faqs={d.faqs} />
  {d.pricing === "default" && <Pricing />}
  <Related keys={d.related} />
  <FinalCta {...(d.finalCta ?? {})} />
  {d.stickyCta && <StickyCta href={d.heroForm ? "#free-audit" : undefined} />}
</BaseLayout>

<style>
  .pintro {
    padding-top: 0;
  }
  .pintro__box {
    max-width: 880px;
    padding: clamp(22px, 3.5vw, 36px) clamp(22px, 3.5vw, 40px);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--paper);
    box-shadow: var(--shadow);
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .pintro__box p:last-child {
    margin: 0;
  }
  .pintro__by {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px !important;
    padding-top: 16px;
    border-top: 1px dashed var(--line-2);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .pintro__by :global(img) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }
  .pintro__box :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
