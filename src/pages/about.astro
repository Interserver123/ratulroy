---
import { languages, sameAs } from "../lib/schema";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { img } from "../lib/img";
import { site } from "../data/site";
import {
  quickFacts,
  factSheet,
  journey,
  credentials,
  method,
  stack,
  generalist,
  specialist,
  expectations,
  aboutFaqs,
} from "../data/about";

const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/ratul-roy.{jpg,jpeg,png,webp}",
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;
// A stable JPEG for social sharing and the Person schema.
const shareImg = portrait ? await getImage({ src: portrait, width: 1000, format: "jpg" }) : undefined;
const imageUrl = shareImg ? new URL(shareImg.src, site.url).href : undefined;

const title = "About Ratul Roy | Local SEO Expert in Bangladesh";
const description =
  "Ratul Roy is a Local SEO Expert in Bangladesh and founder of DigiPolli. Fiverr Level 2, 4.9 from 243 reviews. Google Maps, GBP and AI search.";
const url = `${site.url}/about`;

const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: "en",
    isPartOf: { "@id": `${site.url}/#website` },
    mainEntity: { "@id": `${site.url}/#person` },
    breadcrumb: { "@id": `${url}#breadcrumb` },
  },
  {
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: "Ratul Roy",
    url: site.url + "/",
    ...(imageUrl ? { image: imageUrl } : {}),
    jobTitle: "Local SEO Specialist",
    description:
      "Local SEO expert in Bangladesh and founder of DigiPolli. Helps service businesses in Bangladesh and worldwide improve Google Maps visibility, Google Business Profile performance, website SEO and qualified inbound calls.",
    email: `mailto:${site.email}`,
    telephone: site.phone,
    address: { "@type": "PostalAddress", addressLocality: site.locality, addressCountry: site.countryCode },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "Islamic University" },
      { "@type": "CollegeOrUniversity", name: "Gov PC College" },
    ],
    founder: { "@type": "Organization", name: "DigiPolli" },
    worksFor: { "@id": `${site.url}/#business` },
    knowsLanguage: languages,
    nationality: { "@type": "Country", name: site.country },
    sameAs: sameAs(),
    knowsAbout: stack.flatMap((g) => g.items),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "About", item: url },
    ],
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: aboutFaqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const pin =
  '<path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor"/>';
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- ============ HERO ============ -->
  <section class="ahero" aria-labelledby="about-title">
    <div class="ahero__topo" aria-hidden="true"></div>
    <div class="container ahero__grid">
      <div class="ahero__copy">
        <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
          <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span>
        </nav>
        <p class="eyebrow" data-reveal>About Ratul Roy</p>
        <h1 id="about-title" data-reveal style="--d:1">
          The Local SEO specialist behind <span class="em">the ranking system</span>
        </h1>
        <p class="lead" data-reveal style="--d:2">
          I'm Ratul Roy, a Local SEO expert in Bangladesh. I help local service businesses improve
          Google Maps visibility, strengthen website SEO, and turn local searches into qualified
          inbound calls.
        </p>
        <p data-reveal style="--d:2">
          My work rests on one belief: local businesses don't need random SEO tasks. They need a
          clear search visibility system that helps Google, AI platforms, and real customers
          understand why they should be trusted.
        </p>
        <ul class="chips facts" data-reveal style="--d:3">
          {quickFacts.map((f) => <li class="chip chip--line">{f}</li>)}
        </ul>
        <div class="btn-row" data-reveal style="--d:4">
          <a class="btn btn--dark" href="/contact"><span class="disc" aria-hidden="true">↗</span>Work With Ratul</a>
          <a class="btn btn--ghost" href="/#free-audit">Get Free Audit</a>
        </div>
        <div data-reveal style="--d:5"><SocialLinks labels /></div>
      </div>

      <figure class="idcard" data-reveal style="--d:2">
        <div class="idcard__photo">
          {
            portrait ? (
              <Image
                src={portrait}
                alt="Portrait of Ratul Roy, Local SEO specialist and founder of DigiPolli"
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 380px, 86vw"
                loading="eager"
                fetchpriority="high"
                class="idcard__img"
              />
            ) : (
              <svg viewBox="0 0 20 26" class="idcard__pin" aria-hidden="true" set:html={pin} />
            )
          }
          <span class="idcard__badge"><svg viewBox="0 0 20 26" width="11" height="14" aria-hidden="true" set:html={pin} />Founder · DigiPolli</span>
        </div>
        <figcaption class="idcard__body">
          <p class="idcard__name">Ratul Roy</p>
          <p class="idcard__role">Local SEO · Google Maps · GBP · AI Search</p>
          <dl class="idcard__stats">
            <div><dt>Fiverr</dt><dd>4.9★</dd></div>
            <div><dt>Reviews</dt><dd class="num" data-count>243</dd></div>
            <div><dt>Netmark</dt><dd>2 yr</dd></div>
          </dl>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ STORY ============ -->
  <section class="section" aria-labelledby="story-title">
    <div class="container story">
      <div class="story__main">
        <p class="eyebrow" data-reveal>The Story</p>
        <h2 id="story-title" data-reveal>From curious student to <span class="em">local search architect</span></h2>
        <div class="prose" data-reveal>
          <p>
            My SEO journey started in school, long before I called it a career. While most people
            used Google to find answers, I wanted to know why some businesses appeared everywhere
            online while others stayed invisible. I wrote about
            <a href="/blog/youngest-seo-expert-bangladesh-story">what starting SEO at 16 taught me</a>.
          </p>
          <p>
            That curiosity turned into experiments, freelance projects, and hands-on client work. I
            studied at Gov PC College while learning how search engines respond to content,
            websites, business signals, and user intent. Later, as an ICT student at Islamic
            University, I kept combining analytical thinking with practical SEO execution.
          </p>
          <p>
            Two formative years at Netmark gave me deeper exposure to competitive SEO campaigns,
            ranking patterns, and strategy execution. As a Fiverr Level 2 Seller with a 4.9★ rating
            across 243 reviews, I worked with clients in many industries and kept seeing the same
            problem: <strong>local service businesses were underserved by generalist SEO providers.</strong>
          </p>
          <p>
            That insight led me to build DigiPolli and go deep on Local SEO, Google Maps ranking,
            Google Business Profile optimization, website SEO, and AI search visibility. You can see
            the system in practice in my <a href="/#services">Local SEO services</a> and
            <a href="/case-studies">case studies</a>.
          </p>
        </div>
      </div>

      <aside class="story__side" data-reveal style="--d:2">
        <figure class="candid">
          <Image src={img("people/ratul-roy-portrait.jpg")} alt="Ratul Roy, Local SEO specialist, looking at his phone" widths={[320, 480, 640]} sizes="(min-width: 1024px) 340px, 90vw" loading="lazy" class="candid__img" />
          <figcaption>Ratul Roy · Founder, DigiPolli</figcaption>
        </figure>
        <dl class="sheet card">
          {
            factSheet.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mission">
          <p class="mission__label">Mission</p>
          <p class="mission__text">
            Help local service businesses become <span class="hl">easier to find</span>,
            <span class="hl">easier to trust</span>, and <span class="hl">easier to choose</span>, on
            Google Maps, on websites, and across AI search.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ JOURNEY ============ -->
  <section class="section wash" aria-labelledby="journey-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Journey</p>
        <h2 id="journey-title">The path that built my <span class="em">Local SEO thinking</span></h2>
      </div>
      <div class="route" data-route>
        <div class="route__line" aria-hidden="true"><span></span></div>
        <ol class="steps">
          {
            journey.map((j, i) => (
              <li class="step" data-reveal>
                <span class="step__pin" aria-hidden="true"><span>{i < 5 ? String(i + 1).padStart(2, "0") : "★"}</span></span>
                <div class="card card--hover step__card" data-spot>
                  <p class="tag">{j.label}</p>
                  <h3>{j.title}</h3>
                  <p>{j.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ CREDENTIALS ============ -->
  <section class="section" aria-labelledby="cred-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Credentials</p>
        <h2 id="cred-title">Proof built through <span class="em">real client work</span></h2>
      </div>
      <ul class="grid grid--3 creds">
        {
          credentials.map((c, i) => (
            <li class="card card--hover" data-reveal style={`--d:${i % 3}`} data-spot>
              <span class="creds__value num" data-count={/^\d+$/.test(c.value) ? "" : undefined}>{c.value}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="proofshots">
        <figure class="card" data-reveal>
          <Image src={img("fiverr/fiverr-level-one.jpg")} alt="Fiverr notification: Ratul reached seller Level One" widths={[480, 720]} sizes="(min-width: 900px) 540px, 90vw" loading="lazy" class="proofshots__img" />
          <figcaption><b>Started here</b> · Fiverr Level One</figcaption>
        </figure>
        <span class="proofshots__arrow" aria-hidden="true">→</span>
        <figure class="card" data-reveal style="--d:1">
          <Image src={img("fiverr/fiverr-level-two.png")} alt="Ratul's Fiverr profile: Level 2 seller, 4.9 rating from 243 reviews, Bangladesh" widths={[480, 720]} sizes="(min-width: 900px) 540px, 90vw" loading="lazy" class="proofshots__img" />
          <figcaption><b>Where I am now</b> · Level 2 · 4.9★ · 243 reviews</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ METHOD ============ -->
  <section class="section wash" aria-labelledby="method-title">
    <div class="container">
      <div class="method-head" data-reveal>
        <div>
          <p class="eyebrow">The Method</p>
          <h2 id="method-title">Why my SEO approach is <span class="em">different</span></h2>
        </div>
        <p>
          I don't treat SEO as a checklist. I treat it as a visibility system where Google Maps,
          website SEO, Business Profile signals, citations, reviews, schema, entity signals, and AI
          search readiness work together.
        </p>
      </div>
      <ol class="grid grid--4 method">
        {
          method.map((m, i) => (
            <li class="card card--hover" data-reveal style={`--d:${i}`} data-spot>
              <span class="method__n num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ EXPERTISE ============ -->
  <section class="section" aria-labelledby="stack-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Expertise</p>
        <h2 id="stack-title">The search visibility stack <span class="em">I work with</span></h2>
      </div>
      <div class="grid grid--4 stack">
        {
          stack.map((g, i) => (
            <div class="card" data-reveal style={`--d:${i}`}>
              <h3>{g.group}</h3>
              <ul class="chips">
                {g.items.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ POSITION ============ -->
  <section class="section wash" aria-labelledby="pos-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">My Position</p>
        <h2 id="pos-title">Not a generalist. <span class="em">A Local SEO specialist.</span></h2>
        <p>
          Most agencies sell a buffet: paid ads, social media, web design, SEO, branding. I went the
          other way. My practice is built around one outcome: helping local service businesses rank
          in Google Maps, win their service area, and turn local search into a predictable stream of
          inbound calls. When you only do one thing, you stop guessing.
        </p>
      </div>

      <div class="versus">
        <div class="versus__col versus__col--gen card" data-reveal>
          <p class="versus__label">General SEO provider</p>
          <h3>The generalist approach</h3>
          <ul class="xlist">
            {generalist.map((g) => <li>{g}</li>)}
          </ul>
        </div>
        <div class="versus__vs" aria-hidden="true">vs</div>
        <div class="versus__col versus__col--spec card" data-reveal style="--d:1">
          <p class="versus__label">Ratul Roy</p>
          <h3>The Local SEO specialist</h3>
          <ul class="checklist">
            {specialist.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
      <p class="fit" data-reveal>
        I work best with businesses that depend on local trust, service-area visibility, phone
        calls, appointment bookings, and high-intent searches.
      </p>
    </div>
  </section>

  <!-- ============ HOW I WORK ============ -->
  <section class="section" aria-labelledby="work-title">
    <div class="container work">
      <div class="work__copy" data-reveal>
        <p class="eyebrow">How I Work</p>
        <h2 id="work-title">A long-term partnership, <span class="em">not a deliverable</span></h2>
        <p>
          Before any optimization starts, I want to understand your business model, what a call is
          worth to you, the geography that matters, and the competitors winning your customers
          today. Only then does the strategy get written.
        </p>
        <p>
          The work blends technical SEO, editorial content, operational systems (reviews, posts,
          photos), and the new layer of AI search visibility. None of it is glamorous.
          <strong>All of it compounds.</strong>
        </p>
      </div>
      <ul class="expect">
        {
          expectations.map((e, i) => (
            <li class="card card--hover" data-reveal style={`--d:${i}`} data-spot>
              <span class="expect__tick" aria-hidden="true">✓</span>
              <div>
                <h3>{e.title}</h3>
                <p>{e.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section wash" aria-labelledby="afaq-title">
    <div class="container afaq">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Frequently Asked Questions</p>
        <h2 id="afaq-title">Everything you need to know about <span class="em">working with Ratul</span></h2>
      </div>
      <div class="afaq__list">
        {
          aboutFaqs.map((f, i) => (
            <details class="afaq__item card" open={i === 0} data-reveal style={`--d:${i}`}>
              <summary>
                <h3>{f.q}</h3>
                <span class="afaq__icon" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="acta" aria-labelledby="acta-title">
    <div class="container acta__inner" data-reveal>
      <div>
        <p class="eyebrow">Ready to Grow?</p>
        <h2 id="acta-title">What is holding back <span class="em">your local visibility?</span></h2>
        <p>
          Start with a free Local SEO audit. I'll review your Google Business Profile, website SEO,
          Google Maps visibility, competitors, citations, reviews, and AI search readiness so you
          know exactly what to improve next.
        </p>
        <ul class="chips">
          <li class="chip">GBP Audit</li>
          <li class="chip">Google Maps SEO</li>
          <li class="chip">Website SEO</li>
          <li class="chip">AI Search Ready</li>
        </ul>
      </div>
      <div class="acta__btns">
        <a class="btn btn--dark" href="/#free-audit"><span class="disc" aria-hidden="true">↗</span>Get Free Local SEO Audit</a>
        <a class="btn btn--ghost" href="/book-strategy-call">Book strategy call</a>
        <a class="acta__wa" href={site.whatsapp} rel="noopener" target="_blank">or chat on WhatsApp →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .ahero {
    position: relative;
    overflow: hidden;
    margin-top: -78px;
    padding: calc(78px + clamp(32px, 5vw, 64px)) 0 clamp(64px, 8vw, 104px);
    background:
      radial-gradient(40% 50% at 80% 40%, rgb(15 157 99 / 12%), transparent 70%),
      radial-gradient(35% 40% at 10% 15%, rgb(255 122 102 / 11%), transparent 70%);
  }
  .ahero__topo {
    position: absolute;
    inset: 0;
    background: url("/topo.svg") 0 0 / 1400px auto repeat;
    opacity: 0.6;
    mask-image: radial-gradient(70% 70% at 70% 40%, #000 25%, transparent 80%);
    -webkit-mask-image: radial-gradient(70% 70% at 70% 40%, #000 25%, transparent 80%);
    pointer-events: none;
  }
  .ahero__grid {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ahero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 72px;
    }
  }
  .ahero__copy {
    min-width: 0;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--dim);
    margin-bottom: 18px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .ahero h1 {
    font-size: clamp(2.3rem, 5vw, 4rem);
  }
  .ahero .lead {
    color: var(--ink);
    max-width: 36em;
  }
  .ahero__copy > p:not(.eyebrow, .lead) {
    max-width: 38em;
  }
  .facts {
    margin: 24px 0 28px;
  }

  .idcard {
    margin: 0;
    justify-self: center;
    width: min(400px, 100%);
    border-radius: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    padding: 10px;
    rotate: 1.5deg;
    transition: rotate 0.6s var(--ease);
  }
  .idcard:hover {
    rotate: 0deg;
  }
  .idcard__photo {
    position: relative;
    aspect-ratio: 4 / 4.2;
    border-radius: 20px;
    overflow: hidden;
    background:
      url("/topo.svg") 50% 50% / 800px auto,
      linear-gradient(180deg, #eef3f1, #dfe7e4);
    display: grid;
    place-items: center;
  }
  .idcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    filter: brightness(1.06) contrast(1.04);
    mix-blend-mode: multiply;
  }
  .idcard__pin {
    width: 30%;
    color: var(--accent);
  }
  .idcard__badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .idcard__badge svg {
    color: var(--accent-2);
  }
  .idcard__body {
    padding: 16px 12px 8px;
  }
  .idcard__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .idcard__role {
    margin: 0 0 14px;
    font-size: 0.85rem;
  }
  .idcard__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .idcard__stats > div {
    display: flex;
    flex-direction: column-reverse;
    padding-top: 12px;
  }
  .idcard__stats > div + div {
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }
  .idcard__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
  }
  .idcard__stats dt {
    font-size: 0.75rem;
  }

  /* ---------- Story ---------- */
  .story {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .story {
      grid-template-columns: 1.4fr 0.6fr;
      gap: 72px;
      align-items: start;
    }
    .story__side {
      position: sticky;
      top: 110px;
    }
  }
  .story__main {
    min-width: 0;
  }
  .prose {
    font-size: 1.075rem;
    line-height: 1.75;
    max-width: 64ch;
  }
  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .story__side {
    display: grid;
    gap: 16px;
  }
  .sheet {
    margin: 0;
    padding: 6px 22px;
  }
  .sheet > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
  }
  .sheet > div + div {
    border-top: 1px dashed var(--line-2);
  }
  .sheet dt {
    font-size: 0.85rem;
  }
  .sheet dd {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }
  .mission {
    padding: 24px;
    border-radius: var(--radius);
    background:
      radial-gradient(80% 100% at 100% 0%, rgb(232 64 47 / 35%), transparent 60%),
      var(--ink);
    color: #c3cccb;
  }
  .mission__label {
    margin: 0 0 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .mission__text {
    margin: 0;
    font-family: var(--font-display);
