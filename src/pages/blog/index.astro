---
import { getCollection, getEntry } from "astro:content";
import ContentPage from "../../layouts/ContentPage.astro";

const page = await getEntry("pages", "blog");
if (!page) throw new Error("Missing src/content/pages/blog.yaml");
const posts = (await getCollection("blog")).sort((a, b) => +b.data.date - +a.data.date);
const series = posts.filter((p) => p.data.series).sort((a, b) => a.data.series! - b.data.series!);
const rest = posts.filter((p) => !p.data.series);
const cats = [...new Set(posts.map((p) => p.data.category))];
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<ContentPage data={page.data} path="/blog">
  <div slot="before">
    {
      series.length > 0 && (
        <section class="section bseries" aria-labelledby="series-title">
          <div class="container">
            <div class="section-head" data-reveal>
              <p class="eyebrow">Start here · {series.length}-part series</p>
              <h2 id="series-title">
                Local SEO in Bangladesh, <span class="em">from zero to Map Pack</span>
              </h2>
              <p>Read in order, each part builds on the last: what Local SEO is, how it works, what it costs and how long it takes.</p>
            </div>
            <ol class="bseries__route" role="list" data-route>
              {series.map((p, i) => (
                <li data-reveal style={`--d:${i % 4}`}>
                  <a href={`/blog/${p.id}`} class="bseries__stop card" data-spot>
                    <span class="bseries__pin num"><b>{p.data.series}</b></span>
                    <span class="bseries__t">{p.data.h1}</span>
                    <span class="bseries__m">{p.data.readTime} min read</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <section class="section wash" aria-labelledby="all-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">All articles</p>
          <h2 id="all-title">Guides on Google Maps, GBP and AI search</h2>
        </div>
        <div class="bfil" role="toolbar" aria-label="Filter by topic" data-reveal>
          <button type="button" class="bfil__b is-on" data-f="all" aria-pressed="true">All</button>
          {
            cats.map((c) => (
              <button type="button" class="bfil__b" data-f={c} aria-pressed="false">
                {c}
              </button>
            ))
          }
        </div>
        <ul class="bgrid" role="list" data-bgrid>
          {
            [...rest, ...series].map((p, i) => (
              <li data-cat={p.data.category} data-reveal style={`--d:${i % 3}`}>
                <a class="bcard card" href={`/blog/${p.id}`} data-spot>
                  <span class="bcard__top">
                    <span class="bcard__cat">{p.data.category}</span>
                    {p.data.series && <span class="bcard__s">Part {p.data.series}</span>}
                  </span>
                  <h3>{p.data.h1}</h3>
                  <p>{p.data.excerpt}</p>
                  <span class="bcard__meta">
                    <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
                    <span>{p.data.readTime} min read</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</ContentPage>

<script>
  const bar = document.querySelector<HTMLElement>(".bfil");
  const grid = document.querySelector<HTMLElement>("[data-bgrid]");
  bar?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-f]");
    if (!btn || !grid) return;
    const f = btn.dataset.f!;
    bar.querySelectorAll("button").forEach((b) => {
      b.classList.toggle("is-on", b === btn);
      b.setAttribute("aria-pressed", String(b === btn));
    });
    grid.querySelectorAll<HTMLElement>("li").forEach((li) => (li.hidden = f !== "all" && li.dataset.cat !== f));
  });
</script>

<style>
  .bseries__route {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    counter-reset: s;
  }
  @media (min-width: 700px) {
    .bseries__route {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .bseries__route {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .bseries__stop {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 22px;
    color: var(--ink);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .bseries__stop:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .bseries__pin {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50% 50% 50% 4px;
    transform: rotate(-45deg);
    background: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .bseries__pin b {
    transform: rotate(45deg);
  }
  .bseries__t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.3;
    flex: 1;
  }
  .bseries__m {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .bfil {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .bfil__b {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--paper);
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }
  .bfil__b:hover {
    border-color: var(--ink);
  }
  .bfil__b.is-on {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .bgrid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 700px) {
    .bgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bgrid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bcard {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px;
    color: var(--ink);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .bcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .bcard__top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .bcard__cat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .bcard__s {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .bcard h3 {
    font-size: 1.18rem;
    line-height: 1.3;
    margin: 0;
  }
  .bcard p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }
  .bcard__meta {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px dashed var(--line-2);
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
