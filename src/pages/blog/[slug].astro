---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageFaq from "../../components/page/PageFaq.astro";
import FinalCta from "../../components/page/FinalCta.astro";
import { img } from "../../lib/img";
import { plain } from "../../lib/md";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, posts } }));
}
const { entry, posts } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const path = `/blog/${entry.id}`;
const url = `${site.url}${path}`;
const fmt = (date: Date) => date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const iso = d.date.toISOString().slice(0, 10);

// "Local SEO in Bangladesh" series navigation.
const series = posts.filter((p) => p.data.series).sort((a, b) => a.data.series! - b.data.series!);
const inSeries = d.series ? series : [];
const idx = inSeries.findIndex((p) => p.id === entry.id);
const prev = idx > 0 ? inSeries[idx - 1] : undefined;
const next = idx >= 0 && idx < inSeries.length - 1 ? inSeries[idx + 1] : undefined;

// Related: same category first, then newest.
const related = posts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category) || +b.data.date - +a.data.date)
  .slice(0, 3);

const portrait = img("people/ratul-roy-portrait.jpg");
const og = await getImage({ src: portrait, width: 1200, format: "jpg" });

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: d.h1, href: path },
];
const schema: Record<string, unknown>[] = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    url,
    headline: d.h1,
    name: d.title,
    description: d.description,
    datePublished: iso,
    dateModified: iso,
    inLanguage: "en",
    articleSection: d.category,
    keywords: d.tags.join(", ") || undefined,
    timeRequired: `PT${d.readTime}M`,
    image: new URL(og.src, site.url).href,
    author: { "@id": `${site.url}/#person` },
    publisher: { "@id": `${site.url}/#person` },
    isPartOf: { "@id": `${site.url}/#website` },
    breadcrumb: { "@id": `${url}#breadcrumb` },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.label, item: `${site.url}${c.href === "/" ? "/" : c.href}` })),
  },
];
if (d.faqs.length) {
  schema.push({
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: d.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: plain(f.a) } })),
  });
}
---

<BaseLayout title={d.title} description={d.description} schema={schema} ogType="article" ogImage={og.src}>
  <div class="readbar" aria-hidden="true"><span data-readbar></span></div>

  <header class="ahead">
    <div class="ahead__topo" aria-hidden="true"></div>
    <div class="container ahead__inner">
      <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Blog</a><span aria-hidden="true">/</span><span aria-current="page">{d.category}</span>
      </nav>
      <div class="ahead__tags" data-reveal>
        <span class="chip">{d.category}</span>
        {d.series && <span class="chip chip--line">Series · Part {d.series} of {series.length}</span>}
      </div>
      <h1 data-reveal style="--d:1">{d.h1}</h1>
      <div class="ahead__meta" data-reveal style="--d:3">
        <Image src={portrait} alt="" width={88} height={88} class="ahead__face" />
        <span><b>Ratul Roy</b><span>Local SEO Specialist</span></span>
        <span class="ahead__dot" aria-hidden="true"></span>
        <time datetime={iso}>{fmt(d.date)}</time>
        <span class="ahead__dot" aria-hidden="true"></span>
        <span>{d.readTime} min read</span>
      </div>
    </div>
  </header>

  <div class="container article-wrap">
    <article class="article" data-article>
      {
        toc.length > 2 && (
          <details class="toc-m">
            <summary>On this page <span aria-hidden="true">+</span></summary>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <div class="md">
        <Content />
      </div>

      {
        d.series && (
          <nav class="series card" aria-label="Local SEO in Bangladesh series">
            <p class="eyebrow">Local SEO in Bangladesh · the series</p>
            <ol class="series__route">
              {inSeries.map((p) => (
                <li class={p.id === entry.id ? "is-here" : undefined}>
                  <a href={`/blog/${p.id}`} aria-current={p.id === entry.id ? "page" : undefined}>
                    <span class="series__pin num">{p.data.series}</span>
                    <span>{p.data.h1}</span>
                  </a>
                </li>
              ))}
            </ol>
            <div class="series__pn">
              {prev ? (
                <a href={`/blog/${prev.id}`} class="series__btn">
                  <span>← Part {prev.data.series}</span>
                  {prev.data.h1}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={`/blog/${next.id}`} class="series__btn series__btn--next">
                  <span>Part {next.data.series} →</span>
                  {next.data.h1}
                </a>
              )}
            </div>
          </nav>
        )
      }

      <aside class="author card" aria-label="About the author">
        <Image src={portrait} alt="Ratul Roy" width={160} height={160} class="author__face" />
        <div>
          <p class="author__name">Written by Ratul Roy</p>
          <p>
            Local SEO specialist from Bangladesh working directly with service businesses on Google Maps rankings, Google Business Profile optimization and
            AI search visibility. 4.9★ across 243 Fiverr reviews.
          </p>
          <div class="author__links">
            <a href="/about">About Ratul</a>
            <a href="/case-studies">Case studies</a>
            <a href="/book-strategy-call">Book a strategy call</a>
          </div>
        </div>
      </aside>
    </article>

    {
      toc.length > 2 && (
        <aside class="toc" aria-label="Table of contents">
          <div class="toc__box">
            <p class="toc__title">On this page</p>
            <ol data-toc>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
            <a class="btn btn--dark toc__cta" href="/#free-audit">
              <span class="disc" aria-hidden="true">↗</span>Free Local SEO Audit
            </a>
          </div>
        </aside>
      )
    }
  </div>

  <PageFaq heading={`${d.h1}: FAQs`} faqs={d.faqs} />

  <section class="section" aria-labelledby="more-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Keep reading</p>
        <h2 id="more-title">More from the blog</h2>
      </div>
      <ul class="more" role="list">
        {
          related.map((p, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a class="more__card card" href={`/blog/${p.id}`} data-spot>
                <span class="more__cat">{p.data.category}</span>
                <h3>{p.data.h1}</h3>
                <p>{p.data.excerpt}</p>
                <span class="more__meta">{p.data.readTime} min read →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FinalCta />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>("[data-readbar]");
  const article = document.querySelector<HTMLElement>("[data-article]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  const heads = links.map((a) => document.getElementById(a.dataset.tocLink!)).filter(Boolean) as HTMLElement[];
  let ticking = false;
  function update() {
    ticking = false;
    if (bar && article) {
      const r = article.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
      bar.style.transform = `scaleX(${p})`;
    }
    let cur = heads[0]?.id;
    for (const h of heads) if (h.getBoundingClientRect().top < 140) cur = h.id;
    links.forEach((a) => a.classList.toggle("is-on", a.dataset.tocLink === cur));
  }
  addEventListener("scroll", () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  update();
</script>

<style>
  .readbar {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .readbar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .ahead {
    position: relative;
    padding: clamp(120px, 15vw, 168px) 0 clamp(32px, 5vw, 56px);
    overflow: hidden;
  }
  .ahead__topo {
    position: absolute;
    inset: 0;
    background: url("/topo.svg") center / 900px auto repeat;
    opacity: 0.4;
    mask-image: linear-gradient(180deg, #000, transparent 85%);
    pointer-events: none;
  }
  .ahead__inner {
    position: relative;
  }
  .ahead__inner > * {
    max-width: 860px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }
  .ahead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 14px;
  }
  .ahead h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.5rem);
    line-height: 1.12;
    margin: 0 0 18px;
  }
  .ahead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin-top: 22px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .ahead__face {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .ahead__meta b {
    display: block;
    color: var(--ink);
  }
  .ahead__meta b + span {
    font-size: 0.82rem;
  }
  .ahead__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--dim);
  }

  .article-wrap {
    display: grid;
    gap: 48px;
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  @media (min-width: 1080px) {
    .article-wrap {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 64px;
    }
  }
  .article {
    min-width: 0;
    max-width: 760px;
  }

  .toc {
    display: none;
  }
  @media (min-width: 1080px) {
    .toc {
      display: block;
    }
  }
  .toc__box {
    position: sticky;
    top: 110px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .toc__title {
    margin: 0 0 12px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: grid;
    gap: 2px;
    max-height: 52vh;
    overflow: auto;
  }
  .toc ol a {
    display: block;
    padding: 7px 10px 7px 14px;
    border-left: 2px solid var(--line);
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .toc ol a:hover {
    color: var(--ink);
  }
  .toc ol a.is-on {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--accent);
  }
  .toc__cta {
    width: 100%;
    justify-content: center;
    font-size: 0.9rem;
  }

  .toc-m {
    margin-bottom: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }
  @media (min-width: 1080px) {
    .toc-m {
      display: none;
    }
  }
  .toc-m summary {
    display: flex;
    justify-content: space-between;
    padding: 14px 18px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .toc-m summary::-webkit-details-marker {
    display: none;
  }
  .toc-m ol {
    margin: 0;
    padding: 0 18px 16px 38px;
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
  }
  .toc-m a {
    color: var(--ink-2);
  }

  /* ---- article typography ---- */
  .md {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--ink-2);
  }
  .md :global(h2) {
    position: relative;
    font-size: clamp(1.55rem, 2.6vw, 2rem);
    line-height: 1.2;
    color: var(--ink);
    margin: 2.2em 0 0.7em;
    padding-top: 0.6em;
    scroll-margin-top: 110px;
  }
  .md :global(h2::before) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 8px;
    background: var(--route) center / 100% 100% no-repeat;
  }
  .md :global(h2:first-child) {
    margin-top: 0;
  }
  .md :global(h3) {
    font-size: 1.28rem;
    color: var(--ink);
    margin: 1.8em 0 0.5em;
    scroll-margin-top: 110px;
  }
  .md :global(p) {
    margin: 0 0 1.15em;
  }
  .md :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .md :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .md :global(strong) {
    color: var(--ink);
  }
  .md :global(ul),
  .md :global(ol) {
    list-style: disc;
    margin: 0 0 1.3em;
    padding-left: 1.3em;
  }
  .md :global(ol) {
    list-style: decimal;
  }
  .md :global(li) {
    margin-bottom: 0.45em;
    padding-left: 0.2em;
  }
  .md :global(ul li::marker) {
    color: var(--accent);
  }
  .md :global(ol li::marker) {
    color: var(--accent);
    font-weight: 700;
  }
  .md :global(blockquote) {
    margin: 1.6em 0;
    padding: 20px 24px;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--accent-soft);
    color: var(--ink);
  }
  .md :global(blockquote p:last-child) {
    margin: 0;
  }
  .md :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .md :global(th),
  .md :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    min-width: 140px;
  }
  .md :global(th) {
    background: var(--ink);
    color: #fff;
    font-weight: 600;
  }
  .md :global(tr:nth-child(even) td) {
    background: var(--bg);
  }
  .md :global(hr) {
    border: 0;
    height: 10px;
    margin: 2.4em 0;
    background: var(--route) center / 120px 100% no-repeat;
  }
  .md :global(code) {
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--bg-2);
  }

  /* ---- series ---- */
  .series {
    margin-top: 48px;
    padding: clamp(22px, 3.5vw, 32px);
  }
  .series__route {
    list-style: none;
    margin: 14px 0 22px;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .series__route a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 0;
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .series__route li:not(:last-child) a::after {
    content: "";
    position: absolute;
    left: 14px;
    top: 38px;
    bottom: -10px;
    border-left: 2px dashed var(--line-2);
  }
  .series__pin {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--line-2);
    background: var(--paper);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
  }
  .series__route a:hover {
    color: var(--ink);
  }
  .series__route .is-here a {
    color: var(--ink);
    font-weight: 600;
  }
  .series__route .is-here .series__pin {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .series__pn {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .series__pn {
      grid-template-columns: 1fr 1fr;
    }
  }
  .series__btn {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
    line-height: 1.35;
    transition: border-color 0.2s;
  }
  .series__btn span {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .series__btn--next {
    text-align: right;
    grid-column: 2;
  }
  .series__btn:hover {
    border-color: var(--ink);
  }

  /* ---- author ---- */
  .author {
    display: grid;
    gap: 20px;
    margin-top: 32px;
    padding: clamp(22px, 3.5vw, 32px);
  }
  @media (min-width: 640px) {
    .author {
      grid-template-columns: 88px 1fr;
    }
  }
  .author__face {
    width: 88px;
    height: 88px;
    border-radius: 24px 24px 24px 6px;
    object-fit: cover;
  }
  .author__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .author p {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .author__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .author__links a:hover {
    color: var(--accent);
  }

  /* ---- more posts ---- */
  .more {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 860px) {
    .more {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .more__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px;
    color: var(--ink);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .more__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .more__cat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .more__card h3 {
    font-size: 1.15rem;
    margin: 0;
  }
  .more__card p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    flex: 1;
  }
  .more__meta {
    font-size: 0.88rem;
    font-weight: 600;
  }
</style>
