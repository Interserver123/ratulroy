---
// Fonts come from Astro's Fonts API (see astro.config.mjs). <Font> inlines the
// @font-face rules plus metric-matched fallback faces. We preload only the first
// upright face of each family (the Latin file, declared first in the config); the
// Latin Extended files load on demand, so they never compete with above-the-fold content.
import { Font, fontData } from "astro:assets";

const firstUpright = (v: string) => fontData[v]?.find((f) => f.style === "normal")?.src[0]?.url;
const preloads = [firstUpright("--ff-body"), firstUpright("--ff-display")].filter(Boolean) as string[];
---

<Font cssVariable="--ff-body" />
<Font cssVariable="--ff-display" />
{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
