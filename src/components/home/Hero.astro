---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { heroPoints, proofBadges } from "../../data/home";
import { site } from "../../data/site";

const caseHref = "/case-studies/gbp-calls-growth";

// Drop a portrait at src/assets/ratul-roy.(jpg|png|webp) and it replaces the map visual,
// optimized to AVIF/WebP at build time.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/ratul-roy.{jpg,jpeg,png,webp}",
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const rotating = ["Google Maps rankings", "GBP optimization", "near-me searches", "booked jobs"];
const marquee = [...proofBadges, ...heroPoints];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__top">
    <p class="hero__status" data-reveal>
      <span class="live" aria-hidden="true"></span>
      Accepting 2 new clients this month
      <span class="hero__sep" aria-hidden="true"></span>
      <span class="hero__loc">Based in Bangladesh · Serving worldwide</span>
    </p>
    <p class="hero__kicker" data-reveal style="--d:1">This is Ratul Roy</p>
    <h1 id="hero-title" data-reveal style="--d:2">Local SEO Expert <span class="em">in Bangladesh</span></h1>
    <p class="rotator" data-rotator aria-hidden="true" data-reveal style="--d:3">
      <span>Your partner in</span>
      <span class="rotator__words">
        {rotating.map((w) => <span class="rotator__word" data-word>{w}</span>)}
      </span>
    </p>
  </div>

  <div class="container stage">
    <div class="stage__left" data-reveal style="--d:4">
      <div class="proofline">
        <span class="avatars" aria-hidden="true">
          <span>SB</span><span>RR</span><span>★</span>
        </span>
        <span>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <strong class="num">4.9</strong> · 243 reviews<br />
          <small>Fiverr Level 2 Seller</small>
        </span>
      </div>
      <p>
        I'm Ratul Roy, a Local SEO expert in Bangladesh. I help local businesses dominate Google
        Maps in every service area and turn near-me searches into booked jobs.
      </p>
      <p>
        Not an agency. A dedicated SEO specialist in Bangladesh focused on Map Pack rankings, trust
        signals, and call-driving local visibility.
      </p>
    </div>

    <div class="stage__center" data-reveal style="--d:3">
      <div class="halo" aria-hidden="true"></div>
      {
        portrait ? (
          <Image
            src={portrait}
            alt="Ratul Roy, Local SEO expert in Bangladesh"
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 1024px) 420px, 80vw"
            loading="eager"
            fetchpriority="high"
            class="portrait"
          />
        ) : (
          <div class="mapvis" role="img" aria-label="Illustration of a business ranking in the Google Maps top 3 across its service area">
            <svg viewBox="0 0 400 400" aria-hidden="true">
              <defs>
                <radialGradient id="mapfade" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="100%" stop-color="#efeaff" />
                </radialGradient>
              </defs>
              <circle cx="200" cy="200" r="196" fill="url(#mapfade)" stroke="#e2dcfb" />
              <g stroke="#ddd6fb" stroke-width="10" stroke-linecap="round" fill="none">
                <path d="M30 150 C 140 170, 250 120, 380 160" />
                <path d="M120 20 C 150 140, 170 260, 140 390" />
                <path d="M40 290 C 160 270, 260 300, 370 260" />
                <path d="M290 30 C 260 140, 280 260, 300 380" />
              </g>
              <g stroke="#eae5fd" stroke-width="4" fill="none">
                <path d="M60 80 L 340 330" />
                <path d="M30 220 L 380 210" />
              </g>
              <g class="ring">
                <circle cx="200" cy="200" r="70" fill="none" stroke="#8b6cff" stroke-opacity=".35" />
                <circle cx="200" cy="200" r="120" fill="none" stroke="#8b6cff" stroke-opacity=".2" />
              </g>
              {[[110, 120, 3], [290, 110, 2], [95, 260, 3], [300, 280, 1], [205, 330, 2], [200, 80, 1]].map(([x, y, r]) => (
                <g>
                  <circle cx={x} cy={y} r="17" fill="#12a46b" />
                  <text x={x} y={y + 5} text-anchor="middle" font-size="14" font-weight="700" fill="#fff">{r}</text>
                </g>
              ))}
              <path d="M200 150c-19 0-34 14.6-34 32.7 0 24.3 34 56.3 34 56.3s34-32 34-56.3c0-18.1-15-32.7-34-32.7Z" fill="#0e0d1a" />
              <circle cx="200" cy="183" r="12" fill="#8b6cff" />
            </svg>
          </div>
        )
      }
      <span class="float float--a"><span class="dotg" aria-hidden="true"></span>Top 3 Map Pack</span>
      <span class="float float--b"><span class="stars" aria-hidden="true">★</span> 4.9 · 243 reviews</span>
      <a class="resultcard" href={caseHref}>
        <span class="resultcard__label">Client result</span>
        <span class="resultcard__big num" data-count>461</span>
        <span class="resultcard__desc">calls from Google Business Profile</span>
        <span class="resultcard__row">
          <span><small>Profile interactions</small><b>+62%</b></span>
          <span><small>Map Pack position</small><b>Top 3</b></span>
        </span>
        <span class="text-link">Read the case study</span>
      </a>
    </div>

    <div class="stage__right" data-reveal style="--d:5">
      <p class="stage__sub">
        Google Maps ranking, GBP optimization and local search visibility that turns near-me
        searches into booked jobs.
      </p>
      <p class="stage__strap">
        Map Pack visibility. More qualified calls. Revenue-first Local SEO for Bangladesh.
      </p>
      <div class="btn-row">
        <a class="btn btn--dark" href="#contact"><span class="disc" aria-hidden="true">↗</span>Apply for Strategy Call</a>
        <a class="btn btn--ghost" href="#results">See Results</a>
      </div>
      <a class="consult" href={site.phoneHref}>Free 15-min consult <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="strip">
    <p class="strip__title">
      <strong>Proof, not promises</strong> · Receipts from 5+ years of ranking local businesses on
      Google Maps.
    </p>
    <div class="marquee">
      <ul class="marquee__track">
        {
          marquee.map((b) => (
            <li>
              <strong>{b.title}</strong>
              <span>{b.text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="marquee__track" aria-hidden="true">
        {
          marquee.map((b) => (
            <li>
              <strong>{b.title}</strong>
              <span>{b.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(32px, 5vw, 56px);
    margin-top: -78px;
    padding-top: calc(78px + clamp(32px, 5vw, 56px));
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 35% at 50% 52%, rgb(139 108 255 / 28%), transparent 70%),
      radial-gradient(60% 50% at 15% 0%, rgb(214 204 255 / 55%), transparent 70%),
      radial-gradient(60% 50% at 90% 10%, rgb(255 222 240 / 50%), transparent 70%);
    pointer-events: none;
  }
  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(91 61 245 / 6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(91 61 245 / 6%) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(55% 45% at 50% 35%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(55% 45% at 50% 35%, #000, transparent 75%);
  }
  .hero__top {
    position: relative;
    text-align: center;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0 0 18px;
    padding: 7px 16px 7px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink);
  }
  .hero__sep {
    width: 1px;
    height: 14px;
    background: var(--line-2);
  }
  .hero__loc {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .hero__sep,
    .hero__loc {
      display: none;
    }
  }
  .live {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }
  .live::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--good);
    animation: pulse-ring 1.8s ease-out infinite;
  }
  .hero__kicker {
    margin: 0 0 6px;
    font-weight: 500;
    color: var(--muted);
  }
  .hero h1 {
    margin-bottom: 10px;
  }
  .rotator {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.35em;
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.8rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  .rotator__words {
    position: relative;
    display: inline-grid;
    color: var(--violet);
    font-style: italic;
  }
  .rotator__word {
    grid-area: 1 / 1;
  }
  /* Without JS: show only the first word */
  .rotator__word:not(:first-child) {
    visibility: hidden;
  }
  :global(.rotator.is-live) .rotator__word {
    visibility: visible;
    opacity: 0;
    transform: translateY(70%);
    filter: blur(6px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
  }
  :global(.rotator.is-live) .rotator__word:global(.is-on) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  :global(.rotator.is-live) .rotator__word:global(.is-off) {
    opacity: 0;
    transform: translateY(-70%);
  }

  .stage {
    position: relative;
    display: grid;
    gap: 32px;
    align-items: end;
    margin-top: 28px;
  }
  @media (min-width: 1024px) {
    .stage {
      grid-template-columns: 1fr 1.25fr 1fr;
      gap: 28px;
    }
  }
  .stage__left,
  .stage__right {
    min-width: 0;
    font-size: 0.95rem;
    padding-bottom: 24px;
  }
  .stage__left {
    order: 2;
  }
  .stage__center {
    order: 1;
  }
  .stage__right {
    order: 3;
  }
  @media (min-width: 1024px) {
    .stage__left,
    .stage__center,
    .stage__right {
      order: initial;
    }
  }
  .proofline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .proofline small {
    color: var(--muted);
  }
  .avatars {
    display: flex;
  }
  .avatars span {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid #fff;
    font-size: 0.7rem;
    font-weight: 700;
    color: #fff;
    background: var(--ink);
  }
  .avatars span + span {
    margin-left: -10px;
  }
  .avatars span:nth-child(2) {
    background: var(--violet);
  }
  .avatars span:nth-child(3) {
    background: var(--warn);
  }

  .stage__center {
    position: relative;
    display: grid;
    justify-items: center;
    padding-bottom: 8px;
  }
  .halo {
    position: absolute;
    inset: 10% 8% 20%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(139 108 255 / 45%), transparent 65%);
    filter: blur(30px);
  }
  .portrait {
    position: relative;
    width: min(420px, 82vw);
    height: auto;
    filter: grayscale(1) contrast(1.05);
    mask-image: linear-gradient(180deg, #000 72%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
  }
  .mapvis {
    position: relative;
    width: min(400px, 80vw);
    aspect-ratio: 1;
    max-width: 100%;
    filter: drop-shadow(0 30px 50px rgb(60 40 160 / 22%));
  }
  .mapvis svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring {
    transform-origin: 200px 200px;
    animation: spin 40s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .float {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    background: rgb(255 255 255 / 85%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    animation: float 6s ease-in-out infinite;
  }
  .float--a {
    left: 0;
    top: 4%;
  }
  .float--b {
    right: 2%;
    top: 34%;
    animation-delay: -3s;
  }
  .dotg {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }
  .resultcard {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 4px;
    width: min(340px, 100%);
    margin-top: -64px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    color: var(--muted);
    transition: transform 0.4s var(--ease);
  }
  .resultcard:hover {
    transform: translateY(-4px);
    color: var(--muted);
  }
  .resultcard__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet);
  }
  .resultcard__big {
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .resultcard__desc {
    font-size: 0.85rem;
  }
  .resultcard__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 10px 0 6px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }
  .resultcard__row > span {
    display: grid;
  }
  .resultcard__row small {
    font-size: 0.72rem;
  }
  .resultcard__row b {
    color: var(--good);
    font-size: 1.05rem;
  }

  .stage__sub {
    font-size: 1.05rem;
    color: var(--ink);
    font-weight: 500;
  }
  .stage__strap {
    color: var(--violet);
    font-weight: 500;
    font-size: 0.9rem;
  }
  .stage__right .btn-row {
    margin: 22px 0 14px;
  }
  .consult {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .strip {
    position: relative;
    margin-top: clamp(40px, 6vw, 72px);
    padding: 22px 0 26px;
    border-block: 1px solid var(--line);
    background: rgb(255 255 255 / 55%);
  }
  .strip__title {
    margin: 0 0 16px;
    padding-inline: 16px;
    text-align: center;
    font-size: 0.85rem;
  }
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    flex-shrink: 0;
    gap: 14px;
    padding-right: 14px;
    animation: marquee-x 38s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @keyframes marquee-x {
    to {
      transform: translateX(-100%);
    }
  }
  .marquee li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
    padding: 10px 18px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .marquee li span {
    color: var(--muted);
  }
</style>
