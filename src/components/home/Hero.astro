---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { heroPoints, proofBadges } from "../../data/home";
import { site } from "../../data/site";

const caseHref = "/case-studies/gbp-calls-growth";

// Portrait: src/assets/ratul-roy.(jpg|png|webp). Optimized to AVIF/WebP at build time.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/ratul-roy.{jpg,jpeg,png,webp}",
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const rotating = ["Google Maps rankings", "GBP optimization", "near-me searches", "booked jobs"];
const marquee = [...proofBadges, ...heroPoints];

// Rank dots orbiting the portrait: a circular geo-grid, best ranks on the inner ring.
const rings = [
  { r: 38, n: 8, rank: [1, 1, 2, 1, 1, 2, 1, 1] },
  { r: 46, n: 11, rank: [2, 3, 2, 3, 2, 3, 2, 3, 3, 2, 3] },
];
const dots = rings.flatMap((ring, ri) =>
  Array.from({ length: ring.n }, (_, i) => {
    const a = (i / ring.n) * Math.PI * 2 - Math.PI / 2 + ri * 0.22;
    return {
      x: 50 + ring.r * Math.cos(a),
      y: 50 + ring.r * Math.sin(a),
      rank: ring.rank[i],
      i: ri * 10 + i,
    };
  }),
);

// Compact before/after geo-grid
const size = 5;
const c = (size - 1) / 2;
const cells = Array.from({ length: size * size }, (_, i) => {
  const x = i % size;
  const y = Math.floor(i / size);
  const d = Math.hypot(x - c, y - c);
  const after = d < 1 ? 1 : d < 1.5 ? 2 : d < 2.3 ? 3 : 5;
  const before = d < 1 ? 7 : d < 2 ? 11 : 15;
  return { after, before, d, pin: x === c && y === c };
});
const tone = (r: number) => (r <= 3 ? "g" : r <= 6 ? "m" : "l");
const label = (r: number) => (r > 9 ? "10+" : String(r));
const top3 = (k: "after" | "before") => cells.filter((cl) => cl[k] <= 3).length;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__topo" aria-hidden="true"></div>

  <div class="container hero__top">
    <p class="hero__status" data-reveal>
      <span class="live" aria-hidden="true"></span>
      Accepting 2 new clients this month
      <span class="hero__loc">· Based in Bangladesh · Serving worldwide</span>
    </p>
    <p class="hero__kicker" data-reveal style="--d:1">This is Ratul Roy</p>
    <h1 id="hero-title" data-reveal style="--d:2">Local SEO Expert <span class="em">in Bangladesh</span></h1>
    <p class="rotator" data-rotator aria-hidden="true" data-reveal style="--d:3">
      <span>Your partner in</span>
      <span class="rotator__words">
        {rotating.map((w) => <span class="rotator__word" data-word>{w}</span>)}
      </span>
    </p>
  </div>

  <div class="container stage">
    <div class="stage__art">
    <!-- Lens: circular map with orbiting rank dots -->
    <div class="lens" aria-hidden="true">
      <div class="lens__disc"></div>
      <div class="lens__orbit">
        {
          dots.map((d) => (
            <span
              class={`odot odot--${d.rank <= 1 ? "1" : d.rank <= 2 ? "2" : "3"}`}
              style={`left:${d.x.toFixed(2)}%;top:${d.y.toFixed(2)}%;--i:${d.i}`}
            >
              {d.rank}
            </span>
          ))
        }
      </div>
      <div class="lens__ring"></div>
    </div>

    <div class="stage__person" data-reveal style="--d:2">
      {
        portrait ? (
          <Image
            src={portrait}
            alt="Ratul Roy, Local SEO expert in Bangladesh"
            widths={[360, 520, 680, 900]}
            sizes="(min-width: 1024px) 520px, 88vw"
            loading="eager"
            fetchpriority="high"
            class="portrait"
          />
        ) : (
          <svg class="bigpin" viewBox="0 0 20 26" aria-hidden="true">
            <path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor" />
          </svg>
        )
      }
      <span class="youarehere">
        <svg viewBox="0 0 20 26" width="12" height="15" aria-hidden="true"><path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor"></path></svg>
        Ratul Roy · Bangladesh
      </span>
    </div>

    <!-- Floating cards (outer: mouse parallax, inner: idle float) -->
    <div class="par par--chip1" data-depth="18">
      <span class="chip-float"><span class="dotg" aria-hidden="true"></span>Top 3 Map Pack</span>
    </div>
    <div class="par par--chip2" data-depth="26">
      <span class="chip-float"><span class="stars" aria-hidden="true">↑</span> +38% Map Pack visibility</span>
    </div>
    </div>

    <div class="par par--result" data-depth="14">
      <a class="resultcard glass" href={caseHref}>
        <span class="resultcard__label">Client result</span>
        <span class="resultcard__big num" data-count>461</span>
        <span class="resultcard__desc">calls from Google Business Profile</span>
        <span class="resultcard__row">
          <span><small>Profile interactions</small><b>+62%</b></span>
          <span><small>Map Pack position</small><b>Top 3</b></span>
        </span>
        <span class="text-link">Read the case study</span>
      </a>
    </div>

    <div class="par par--scan" data-depth="22">
      <div class="scan glass" data-scan>
        <div class="scan__head">
          <p class="scan__title">Geo-grid scan</p>
          <div class="scan__toggle" role="group" aria-label="Show rankings before or after Local SEO">
            <button type="button" data-set="before" aria-pressed="false">Before</button>
            <button type="button" data-set="after" aria-pressed="true">After</button>
          </div>
        </div>
        <ul class="scan__grid" aria-hidden="true">
          {
            cells.map((cl) => (
              <li
                class={`cell${cl.pin ? " cell--pin" : ""}`}
                style={`--d:${cl.d.toFixed(2)}`}
                data-a={label(cl.after)}
                data-b={label(cl.before)}
                data-ta={tone(cl.after)}
                data-tb={tone(cl.before)}
                data-tone={tone(cl.after)}
              >
                <span>{label(cl.after)}</span>
              </li>
            ))
          }
        </ul>
        <p class="scan__foot">
          <b class="num" data-after={top3("after")} data-before={top3("before")}>{top3("after")}</b>/25 points in the top 3 <span>· illustrative</span>
        </p>
      </div>
    </div>
  </div>

  <div class="container base">
    <div class="base__left" data-reveal>
      <div class="proofline">
        <span class="avatars" aria-hidden="true"><span>SB</span><span>GBP</span><span>↑</span></span>
        <span>
          <strong class="num">461</strong> calls from one Google profile<br />
          <small>Real client result, tracked in GBP Insights</small>
        </span>
      </div>
      <p>
        I'm Ratul Roy, a Local SEO expert in Bangladesh. I help
        service businesses reach the Google Maps 3-pack across their service areas and turn
        near-me searches into booked jobs.
      </p>
      <p>
        Not an agency. You work with me directly on your Google Business Profile, reviews, citations
        and website, for businesses in <a href="/local-seo-dhaka">Dhaka</a>, across Bangladesh and
        abroad.
      </p>
    </div>
    <div class="base__right" data-reveal style="--d:2">
      <p class="base__sub">
        Google Maps ranking, Google Business Profile optimization, technical SEO and AI search
        visibility for plumbers, HVAC firms, dentists, lawyers and other businesses that live on calls.
      </p>
      <p class="base__strap">
        Map Pack visibility. More qualified calls. From $299, no lock-in contract.
      </p>
      <div class="btn-row">
        <a class="btn btn--dark" href="/book-strategy-call"><span class="disc" aria-hidden="true">↗</span>Apply for Strategy Call</a>
        <a class="btn btn--ghost" href="/#results">See Results</a>
      </div>
      <a class="consult" href={site.phoneHref}>Free 15-min consult →</a>
    </div>
  </div>

  <div class="strip">
    <p class="strip__title">
      <strong>Proof, not promises</strong> · Receipts from 5+ years of ranking local businesses on
      Google Maps.
    </p>
    <div class="marquee">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
            {marquee.map((b) => (
              <li>
                <svg viewBox="0 0 20 26" width="10" height="13" aria-hidden="true">
                  <path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor" />
                </svg>
                <strong>{b.title}</strong>
                <span>{b.text}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Before/after scan toggle
  document.querySelectorAll<HTMLElement>("[data-scan]").forEach((scan) => {
    const cells = scan.querySelectorAll<HTMLElement>(".cell");
    const count = scan.querySelector<HTMLElement>("[data-after]");
    const buttons = scan.querySelectorAll<HTMLButtonElement>("[data-set]");
    const show = (state: "before" | "after") => {
      scan.classList.remove("is-scanning");
      void scan.offsetWidth;
      scan.classList.add("is-scanning");
      cells.forEach((c) => {
        c.dataset.tone = (state === "after" ? c.dataset.ta : c.dataset.tb) ?? "";
        const span = c.querySelector("span");
        const v = state === "after" ? c.dataset.a : c.dataset.b;
        if (span && v) span.textContent = v;
      });
      if (count) count.textContent = (state === "after" ? count.dataset.after : count.dataset.before) ?? "";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.set === state)));
    };
    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.set as "before" | "after")));
    scan.classList.add("is-scanning");
  });

  // Mouse parallax on the floating cards (desktop, motion allowed)
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (hero && !reduce && window.matchMedia("(pointer: fine)").matches) {
    const layers = hero.querySelectorAll<HTMLElement>("[data-depth]");
    let raf = 0;
    hero.addEventListener("pointermove", (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - r.top) / r.height - 0.5;
        layers.forEach((l) => {
          const d = Number(l.dataset.depth) || 10;
          l.style.translate = `${(-nx * d).toFixed(1)}px ${(-ny * d).toFixed(1)}px`;
        });
        hero.style.setProperty("--lx", `${(nx * 14).toFixed(1)}px`);
        hero.style.setProperty("--ly", `${(ny * 14).toFixed(1)}px`);
      });
    });
    hero.addEventListener("pointerleave", () => {
      layers.forEach((l) => (l.style.translate = ""));
      hero.style.setProperty("--lx", "0px");
      hero.style.setProperty("--ly", "0px");
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: -78px;
    padding-top: calc(78px + clamp(28px, 4.5vw, 52px));
    background:
      radial-gradient(38% 42% at 50% 62%, rgb(15 157 99 / 16%), transparent 70%),
      radial-gradient(30% 30% at 20% 20%, rgb(255 122 102 / 12%), transparent 70%),
      radial-gradient(30% 30% at 85% 15%, rgb(255 210 120 / 14%), transparent 70%);
  }
  .hero__topo {
    position: absolute;
    inset: 0;
    background: url("/topo.svg") 50% 0 / 1400px auto repeat;
    opacity: 0.6;
    mask-image: radial-gradient(60% 60% at 50% 55%, #000 25%, transparent 80%);
    -webkit-mask-image: radial-gradient(60% 60% at 50% 55%, #000 25%, transparent 80%);
    pointer-events: none;
  }

  /* ---------- Headline ---------- */
  .hero__top {
    position: relative;
    z-index: 4;
    text-align: center;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink);
  }
  .hero__loc {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .hero__loc {
      display: none;
    }
  }
  .live {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }
  .live::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--good);
    animation: pulse-ring 1.8s ease-out infinite;
  }
  .hero__kicker {
    margin: 0 0 2px;
    font-weight: 500;
    color: var(--muted);
  }
  .hero h1 {
    font-size: clamp(2.4rem, 5.4vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 14px;
  }
  .rotator {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.35em;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  .rotator__words {
    position: relative;
    display: inline-grid;
    justify-items: start;
    color: var(--good);
  }
  .rotator__word {
    grid-area: 1 / 1;
    white-space: nowrap;
  }
  .rotator__word:not(:first-child) {
    visibility: hidden;
  }
  :global(.rotator.is-live) .rotator__word {
    visibility: visible;
    opacity: 0;
    transform: translateY(60%);
    filter: blur(6px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
  }
  :global(.rotator.is-live) .rotator__word:global(.is-on) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  :global(.rotator.is-live) .rotator__word:global(.is-off) {
    opacity: 0;
    transform: translateY(-60%);
  }

  /* ---------- Stage: lens + portrait + floating cards ---------- */
  .stage {
    position: relative;
    margin-top: 28px;
    height: clamp(380px, 40vw, 520px);
  }
  .lens {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(480px, 88vw);
    aspect-ratio: 1;
    translate: calc(-50% + var(--lx, 0px)) var(--ly, 0px);
    transition: translate 0.6s var(--ease);
    pointer-events: none;
  }
  .lens__disc {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background:
      url("/topo.svg") 40% 50% / 900px auto,
      radial-gradient(circle at 50% 40%, #ffffff, #e7f1ed 70%);
    box-shadow:
      inset 0 0 0 1px rgb(15 157 99 / 18%),
      0 40px 80px -30px rgb(16 42 40 / 35%);
  }
  .lens__ring {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    border: 1.5px dashed rgb(232 64 47 / 35%);
    animation: spin 90s linear infinite;
  }
  .lens__orbit {
    position: absolute;
    inset: 0;
    animation: spin 180s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .odot {
    position: absolute;
    width: clamp(18px, 2.2vw, 24px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(0.58rem, 1vw, 0.75rem);
    font-weight: 700;
    color: #fff;
    background: var(--good);
    box-shadow: 0 6px 14px -6px rgb(15 157 99 / 70%);
    animation: odot-in 0.6s var(--ease) both;
    animation-delay: calc(0.6s + var(--i) * 45ms);
  }
  .odot--2 {
    background: #2fb57e;
  }
  .odot--3 {
    background: #6cc9a1;
  }
  @keyframes odot-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.3);
    }
  }

  .stage__person {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(400px, 78vw);
    translate: -50% 0;
    z-index: 2;
    display: grid;
    justify-items: center;
  }
  .portrait {
    width: 100%;
    height: auto;
    /* Lift the grey studio backdrop toward white so it melts into the lens, then feather every edge */
    filter: brightness(1.1) contrast(1.06) saturate(0.95);
    mix-blend-mode: multiply;
    mask-image:
      radial-gradient(58% 72% at 50% 46%, #000 56%, transparent 76%),
      linear-gradient(180deg, transparent 0%, #000 16%, #000 72%, transparent 98%);
    mask-composite: intersect;
    -webkit-mask-image:
      radial-gradient(58% 72% at 50% 46%, #000 56%, transparent 76%),
      linear-gradient(180deg, transparent 0%, #000 16%, #000 72%, transparent 98%);
    -webkit-mask-composite: source-in;
  }
  .bigpin {
    width: 34%;
    margin-bottom: 18%;
    color: var(--accent);
    filter: drop-shadow(0 20px 30px rgb(232 64 47 / 40%));
    animation: float 5s ease-in-out infinite;
  }
  .youarehere {
    position: absolute;
    bottom: 12%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 14px 30px -12px rgb(15 26 28 / 60%);
  }
  .youarehere svg {
    color: var(--accent-2);
  }

  .par {
    position: absolute;
    z-index: 3;
    transition: translate 0.5s var(--ease);
  }
  .par > * {
    animation: float 7s ease-in-out infinite;
  }
  .par--chip1 {
    left: 22%;
    top: 16%;
  }
  .par--chip2 {
    right: 21%;
    top: 34%;
  }
  .par--chip2 > * {
    animation-delay: -3s;
  }
  .par--result {
    left: 2%;
    top: 30%;
  }
  .par--result > * {
    animation-delay: -1.5s;
  }
  .par--scan {
    right: 2%;
    top: 26%;
  }
  .par--scan > * {
    animation-delay: -4.5s;
  }
  .glass {
    background: rgb(255 255 255 / 78%);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid rgb(255 255 255 / 90%);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 80%) inset,
      var(--shadow-lg);
    border-radius: var(--radius);
  }
  .chip-float {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    background: rgb(255 255 255 / 85%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid #fff;
    box-shadow: var(--shadow);
    white-space: nowrap;
  }
  .dotg {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }

  .resultcard {
    display: grid;
    gap: 3px;
    width: 230px;
    padding: 16px 18px;
    color: var(--muted);
  }
  .resultcard:hover {
    color: var(--muted);
  }
  .resultcard__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .resultcard__big {
    font-family: var(--font-display);
    font-size: 2.3rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .resultcard__desc {
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .resultcard__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 10px 0 6px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }
  .resultcard__row > span {
    display: grid;
  }
  .resultcard__row small {
    font-size: 0.68rem;
    line-height: 1.3;
  }
  .resultcard__row b {
    color: var(--good);
  }

  .scan {
    width: 230px;
    padding: 13px;
  }
  .scan__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .scan__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 0.88rem;
    white-space: nowrap;
    color: var(--ink);
  }
  .scan__toggle {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--bg-2);
  }
  .scan__toggle button {
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 9px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }
  .scan__toggle button[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }
  .scan__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    padding: 10px;
    border-radius: 12px;
    background:
      url("/topo.svg") 30% 40% / 700px auto,
      #f5f9f7;
    border: 1px solid var(--line);
  }
  .cell {
    aspect-ratio: 1;
    max-width: 100%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.68rem;
    font-weight: 700;
    color: #fff;
    background: var(--good);
    transition:
      background 0.4s,
      transform 0.3s var(--ease);
  }
  .cell:hover {
    transform: scale(1.15);
  }
