---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { heroPoints, proofBadges } from "../../data/home";
import { site } from "../../data/site";

const caseHref = "/case-studies/gbp-calls-growth";

// Portrait: put the photo at src/assets/ratul-roy.(jpg|png|webp). It is optimized to
// AVIF/WebP at build time. Without it, the geo-grid scanner becomes the main visual.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/ratul-roy.{jpg,jpeg,png,webp}",
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const rotating = ["Google Maps rankings", "GBP optimization", "near-me searches", "booked jobs"];
const marquee = [...proofBadges, ...heroPoints];

// Illustrative 7x7 geo-grid. "after": strong around the pin; "before": weak everywhere.
const size = 7;
const c = (size - 1) / 2;
const cells = Array.from({ length: size * size }, (_, i) => {
  const x = i % size;
  const y = Math.floor(i / size);
  const d = Math.hypot(x - c, y - c);
  const after = d < 1.2 ? 1 : d < 2 ? 2 : d < 2.6 ? 3 : d < 3.3 ? 4 : 7;
  const before = d < 1 ? 6 : d < 2 ? 9 : 14;
  return { after, before, d, pin: x === c && y === c };
});
const tone = (r: number) => (r <= 3 ? "g" : r <= 6 ? "m" : "l");
const label = (r: number) => (r > 9 ? "10+" : String(r));
const top3 = (k: "after" | "before") => cells.filter((cl) => cl[k] <= 3).length;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__topo" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__status" data-reveal>
        <span class="live" aria-hidden="true"></span>
        Accepting 2 new clients this month
        <span class="hero__loc">· Based in Bangladesh · Serving worldwide</span>
      </p>
      <p class="hero__kicker" data-reveal style="--d:1">This is Ratul Roy</p>
      <h1 id="hero-title" data-reveal style="--d:2">Local SEO Expert <span class="em">in Bangladesh</span></h1>
      <p class="rotator" data-rotator aria-hidden="true" data-reveal style="--d:3">
        <span>Your partner in</span>
        <span class="rotator__words">
          {rotating.map((w) => <span class="rotator__word" data-word>{w}</span>)}
        </span>
      </p>
      <p class="hero__sub" data-reveal style="--d:4">
        Google Maps ranking, GBP optimization and local search visibility that turns near-me
        searches into booked jobs.
      </p>
      <p class="hero__strap" data-reveal style="--d:4">
        Map Pack visibility. More qualified calls. Revenue-first Local SEO for Bangladesh.
      </p>
      <div class="btn-row" data-reveal style="--d:5">
        <a class="btn btn--dark" href="#contact"><span class="disc" aria-hidden="true">↗</span>Apply for Strategy Call</a>
        <a class="btn btn--ghost" href="#results">See Results</a>
      </div>
      <div class="proofline" data-reveal style="--d:6">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span><strong class="num">4.9</strong> · 243 reviews · Fiverr Level 2 Seller</span>
        <a href={site.phoneHref}>Free 15-min consult →</a>
      </div>
    </div>

    <div class={`hero__visual${portrait ? " has-portrait" : ""}`} data-reveal style="--d:3">
      {
        portrait && (
          <figure class="portrait">
            <Image
              src={portrait}
              alt="Ratul Roy, Local SEO expert in Bangladesh"
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 1024px) 460px, 90vw"
              loading="eager"
              fetchpriority="high"
              class="portrait__img"
            />
            <span class="tag-float tag-float--a"><span class="dotg" aria-hidden="true"></span>Top 3 Map Pack</span>
            <span class="tag-float tag-float--b"><span class="stars" aria-hidden="true">★</span> 4.9 · 243 reviews</span>
          </figure>
        )
      }

      <div class="scan card" data-scan data-state="after">
        <div class="scan__head">
          <div>
            <p class="scan__title">Geo-grid ranking scan</p>
            <p class="scan__sub">Illustrative 7×7 grid around one business</p>
          </div>
          <div class="scan__toggle" role="group" aria-label="Show rankings before or after Local SEO">
            <button type="button" data-set="before" aria-pressed="false">Before</button>
            <button type="button" data-set="after" aria-pressed="true">After</button>
          </div>
        </div>
        <div class="scan__map">
          <div class="scan__sweep" aria-hidden="true"></div>
          <ul class="scan__grid" aria-hidden="true">
            {
              cells.map((cl) => (
                <li
                  class={`cell${cl.pin ? " cell--pin" : ""}`}
                  style={`--d:${cl.d.toFixed(2)}`}
                  data-a={label(cl.after)}
                  data-b={label(cl.before)}
                  data-ta={tone(cl.after)}
                  data-tb={tone(cl.before)}
                  data-tone={tone(cl.after)}
                >
                  <span>{label(cl.after)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="scan__foot">
          <span><b class="num" data-after={top3("after")} data-before={top3("before")}>{top3("after")}</b>/49 points in the top 3</span>
          <span class="scan__legend"><i class="g"></i>1–3 <i class="m"></i>4–6 <i class="l"></i>7+</span>
        </div>
      </div>

      <a class="resultcard" href={caseHref}>
        <span class="resultcard__label">Client result</span>
        <span class="resultcard__row1">
          <span class="resultcard__big num" data-count>461</span>
          <span class="resultcard__desc">calls from Google Business Profile</span>
        </span>
        <span class="resultcard__row">
          <span><small>Profile interactions</small><b>+62%</b></span>
          <span><small>Map Pack position</small><b>Top 3</b></span>
        </span>
        <span class="text-link">Read the case study</span>
      </a>
    </div>
  </div>

  <div class="container hero__body" data-reveal>
    <p>
      I'm Ratul Roy, a Local SEO expert in Bangladesh. I help local businesses dominate Google Maps
      in every service area and turn near-me searches into booked jobs.
    </p>
    <p>
      Not an agency. A dedicated SEO specialist in Bangladesh focused on Map Pack rankings, trust
      signals, and call-driving local visibility.
    </p>
  </div>

  <div class="strip">
    <p class="strip__title">
      <strong>Proof, not promises</strong> · Receipts from 5+ years of ranking local businesses on
      Google Maps.
    </p>
    <div class="marquee">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
            {marquee.map((b) => (
              <li>
                <svg viewBox="0 0 20 26" width="10" height="13" aria-hidden="true">
                  <path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor" />
                </svg>
                <strong>{b.title}</strong>
                <span>{b.text}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-scan]").forEach((scan) => {
    const cells = scan.querySelectorAll<HTMLElement>(".cell");
    const count = scan.querySelector<HTMLElement>("[data-after]");
    const buttons = scan.querySelectorAll<HTMLButtonElement>("[data-set]");
    const show = (state: "before" | "after") => {
      scan.dataset.state = state;
      scan.classList.remove("is-scanning");
      void scan.offsetWidth; // restart the scan animation
      scan.classList.add("is-scanning");
      cells.forEach((c) => {
        c.dataset.tone = (state === "after" ? c.dataset.ta : c.dataset.tb) ?? "";
        const span = c.querySelector("span");
        const v = state === "after" ? c.dataset.a : c.dataset.b;
        if (span && v) span.textContent = v;
      });
      if (count) count.textContent = (state === "after" ? count.dataset.after : count.dataset.before) ?? "";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.set === state)));
    };
    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.set as "before" | "after")));
    // Play the scan once when it scrolls into view.
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        scan.classList.add("is-scanning");
        io.disconnect();
      }
    });
    io.observe(scan);
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: -78px;
    padding-top: calc(78px + clamp(36px, 6vw, 72px));
    background:
      radial-gradient(45% 50% at 78% 40%, rgb(15 157 99 / 12%), transparent 70%),
      radial-gradient(40% 40% at 10% 10%, rgb(255 122 102 / 12%), transparent 70%);
  }
  .hero__topo {
    position: absolute;
    inset: 0;
    background: url("/topo.svg") 0 0 / 1400px auto repeat;
    opacity: 0.7;
    mask-image: radial-gradient(70% 70% at 60% 40%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(70% 70% at 60% 40%, #000 30%, transparent 80%);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1.08fr 0.92fr;
      gap: 56px;
    }
  }
  .hero__copy {
    min-width: 0;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink);
  }
  .hero__loc {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .hero__loc {
      display: none;
    }
  }
  .live {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }
  .live::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--good);
    animation: pulse-ring 1.8s ease-out infinite;
  }
  .hero__kicker {
    margin: 0 0 4px;
    font-weight: 500;
    color: var(--muted);
  }
  .hero h1 {
    margin-bottom: 14px;
  }
  .rotator {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.35em;
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  .rotator__words {
    position: relative;
    display: inline-grid;
    justify-items: start;
    color: var(--good);
  }
  .rotator__word {
    grid-area: 1 / 1;
    white-space: nowrap;
  }
  .rotator__word:not(:first-child) {
    visibility: hidden;
  }
  :global(.rotator.is-live) .rotator__word {
    visibility: visible;
    opacity: 0;
    transform: translateY(60%);
    filter: blur(6px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
  }
  :global(.rotator.is-live) .rotator__word:global(.is-on) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  :global(.rotator.is-live) .rotator__word:global(.is-off) {
    opacity: 0;
    transform: translateY(-60%);
  }
  .hero__sub {
    font-size: 1.1rem;
    color: var(--ink);
    max-width: 36em;
  }
  .hero__strap {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--accent);
  }
  .hero .btn-row {
    margin: 26px 0 22px;
  }
  .proofline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 0.85rem;
  }
  .proofline a {
    font-weight: 600;
  }

  .hero__visual {
    position: relative;
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  /* Portrait layout: photo on a contour card, scanner + result tucked over its lower edge */
  .portrait {
    position: relative;
    margin: 0;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 4.3;
    max-width: 100%;
    background:
      url("/topo.svg") 50% 50% / 900px auto,
      linear-gradient(180deg, #eef3f1, #dde6e3);
    box-shadow: var(--shadow-lg);
  }
  .portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
    mix-blend-mode: multiply;
  }
  .tag-float {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    animation: float 6s ease-in-out infinite;
  }
  .tag-float--a {
    left: 14px;
    top: 18px;
  }
  .tag-float--b {
    right: 14px;
    top: 30%;
    animation-delay: -3s;
  }
  .dotg {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }
  .has-portrait .scan {
    width: min(100%, 340px);
    margin: -150px 0 0 -28px;
    position: relative;
    z-index: 2;
    padding: 14px;
  }
  .has-portrait .scan__sub {
    display: none;
  }
  .has-portrait .resultcard {
    position: absolute;
    right: -14px;
    bottom: 24px;
    width: 250px;
    z-index: 3;
  }
  .has-portrait .resultcard__row,
  .has-portrait .resultcard .text-link {
    display: none;
  }
  @media (max-width: 700px) {
    .has-portrait .scan {
      margin: -90px auto 0;
    }
    .has-portrait .resultcard {
      position: static;
      width: auto;
    }
  }

  .scan {
    padding: 18px;
    box-shadow: var(--shadow-lg);
  }
  .scan__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }
  .scan__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 650;
    color: var(--ink);
  }
  .scan__sub {
    margin: 0;
    font-size: 0.75rem;
    color: var(--dim);
  }
  .scan__toggle {
    display: inline-flex;
    flex-shrink: 0;
    padding: 3px;
    border-radius: 999px;
    background: var(--bg-2);
  }
  .scan__toggle button {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }
  .scan__toggle button[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }
  .scan__map {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    padding: clamp(10px, 2vw, 16px);
    border: 1px solid var(--line);
    background:
      url("/topo.svg") 30% 40% / 900px auto,
      linear-gradient(120deg, transparent 47%, rgb(16 42 40 / 6%) 47.5%, rgb(16 42 40 / 6%) 49.5%, transparent 50%),
      linear-gradient(20deg, transparent 63%, rgb(16 42 40 / 5%) 63.5%, rgb(16 42 40 / 5%) 65%, transparent 65.5%),
      #f7faf9;
  }
  .scan__sweep {
    position: absolute;
    inset: -50%;
    background: conic-gradient(from 0deg, transparent 0deg, rgb(15 157 99 / 22%) 40deg, transparent 60deg);
    opacity: 0;
    pointer-events: none;
  }
  :global(.scan.is-scanning) .scan__sweep {
    animation: sweep 1.6s var(--ease) 1;
  }
  @keyframes sweep {
    0% {
      opacity: 1;
      transform: rotate(0deg);
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: rotate(360deg);
    }
  }
  .scan__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: clamp(5px, 1.2vw, 9px);
  }
  .cell {
    aspect-ratio: 1;
    max-width: 100%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: clamp(0.6rem, 1.3vw, 0.78rem);
    font-weight: 700;
    color: #fff;
    background: var(--good);
    transition:
      background 0.4s,
      transform 0.3s var(--ease);
  }
  .cell:hover {
    transform: scale(1.18);
  }
  .cell[data-tone="g"] {
    background: var(--good);
    box-shadow: 0 4px 12px -4px rgb(15 157 99 / 60%);
  }
  .cell[data-tone="m"] {
    background: var(--warn);
  }
  .cell[data-tone="l"] {
    background: #c9d3d0;
    color: var(--ink-2);
    box-shadow: none;
  }
  .cell--pin {
    outline: 3px solid #fff;
    box-shadow: 0 0 0 6px rgb(232 64 47 / 35%) !important;
  }
  :global(.scan.is-scanning) .cell {
    animation: pop 0.5s var(--ease) both;
    animation-delay: calc(var(--d) * 110ms);
  }
  @keyframes pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
  .scan__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.8rem;
  }
  .scan__foot b {
    color: var(--ink);
    font-size: 1rem;
  }
  .scan__legend {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--dim);
  }
  .scan__legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-left: 6px;
  }
  .scan__legend i.g {
    background: var(--good);
  }
  .scan__legend i.m {
    background: var(--warn);
  }
  .scan__legend i.l {
    background: #c9d3d0;
  }

  .resultcard {
    display: grid;
    gap: 6px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--ink);
    color: #b7c3c1;
    box-shadow: var(--shadow-lg);
    transition: transform 0.4s var(--ease);
  }
  @media (min-width: 1024px) {
    .hero__visual:not(.has-portrait) .resultcard {
      margin: -40px 24px 0 -40px;
      position: relative;
      z-index: 2;
    }
  }
  .resultcard:hover {
    transform: translateY(-4px);
    color: #b7c3c1;
  }
  .resultcard__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .resultcard__row1 {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .resultcard__big {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
  }
  .resultcard__desc {
    font-size: 0.85rem;
  }
  .resultcard__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding-top: 8px;
    border-top: 1px solid rgb(255 255 255 / 12%);
  }
  .resultcard__row > span {
    display: grid;
  }
  .resultcard__row small {
    font-size: 0.72rem;
  }
  .resultcard__row b {
    color: #4ade9b;
  }
  .resultcard .text-link {
    color: #fff;
  }

  .hero__body {
    position: relative;
    display: grid;
    gap: 8px 40px;
    margin-top: 48px;
    font-size: 0.95rem;
  }
  @media (min-width: 900px) {
    .hero__body {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__body p {
    margin: 0;
    padding-left: 16px;
    border-left: 2px solid var(--line-2);
  }

  .strip {
    position: relative;
    margin-top: clamp(40px, 6vw, 64px);
    padding: 20px 0 24px;
    border-block: 1px solid var(--line);
    background: rgb(255 255 255 / 60%);
  }
  .strip__title {
    margin: 0 0 14px;
    padding-inline: 16px;
    text-align: center;
    font-size: 0.85rem;
  }
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    flex-shrink: 0;
    gap: 12px;
    padding-right: 12px;
    animation: marquee-x 40s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @keyframes marquee-x {
    to {
      transform: translateX(-100%);
    }
  }
  .marquee li {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 9px 16px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .marquee li svg {
    color: var(--accent);
  }
  .marquee li span {
    color: var(--muted);
  }
</style>
