---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { heroPoints, proofBadges } from "../../data/home";

const caseHref = "/case-studies/gbp-calls-growth";

// Drop a portrait at src/assets/ratul-roy.(jpg|png|webp) and it appears automatically,
// optimized to AVIF/WebP at build time.
const portraits = import.meta.glob<{ default: ImageMetadata }>("../../assets/ratul-roy.{jpg,jpeg,png,webp}", {
  eager: true,
});
const portrait = Object.values(portraits)[0]?.default;

// Illustrative geo-grid: rank gets worse with distance from the business pin.
const size = 7;
const c = (size - 1) / 2;
const cells = Array.from({ length: size * size }, (_, i) => {
  const x = i % size;
  const y = Math.floor(i / size);
  const d = Math.hypot(x - c, y - c);
  const rank = d < 1.2 ? 1 : d < 2 ? 2 : d < 2.6 ? 3 : d < 3.3 ? 5 : 9;
  const tone = rank <= 3 ? "good" : rank <= 5 ? "mid" : "low";
  return { rank, tone, pin: x === c && y === c };
});
---

<section class="hero" aria-labelledby="hero-title">
  <div class="glow" style="width:620px;height:620px;left:-220px;top:-180px;background:rgb(255 61 74 / 22%)"></div>
  <div class="glow" style="width:560px;height:560px;right:-180px;top:80px;background:rgb(80 140 255 / 16%)"></div>
  <div class="hero__grid-bg" aria-hidden="true"></div>

  <div class="container hero__layout">
    <div class="hero__copy">
      <p class="eyebrow">This is Ratul Roy</p>
      <h1 id="hero-title">Local SEO Expert <span class="em">in Bangladesh</span></h1>
      <p class="hero__sub">
        Google Maps ranking, GBP optimization and local search visibility that turns near-me
        searches into booked jobs.
      </p>
      <p class="hero__strap">
        Map Pack visibility. More qualified calls. Revenue-first Local SEO for Bangladesh.
      </p>
      <div class="hero__body">
        <p>
          I'm Ratul Roy, a Local SEO expert in Bangladesh. I help local businesses dominate Google
          Maps in every service area and turn near-me searches into booked jobs.
        </p>
        <p>
          Not an agency. A dedicated SEO specialist in Bangladesh focused on Map Pack rankings,
          trust signals, and call-driving local visibility.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="#contact">Apply for Strategy Call <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#results">See Results</a>
      </div>
      <ul class="hero__points">
        {
          heroPoints.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual">
      {
        portrait ? (
          <figure class="portrait panel--edge">
            <Image
              src={portrait}
              alt="Ratul Roy, Local SEO expert in Bangladesh"
              widths={[360, 520, 720, 1040]}
              sizes="(min-width: 1024px) 480px, 92vw"
              loading="eager"
              fetchpriority="high"
              class="portrait__img"
            />
            <span class="float float--a">Top 3 Map Pack</span>
            <span class="float float--b">
              <span class="stars" aria-hidden="true">★</span> 4.9 · 243 reviews
            </span>
            <span class="float float--c">461 GBP calls</span>
          </figure>
        ) : (
          <div class="geo panel--edge" role="img" aria-label="Illustrative geo-grid showing top 3 Google Maps rankings across a service area">
            <div class="geo__head">
              <span class="mono">GEO-GRID · 7×7</span>
              <span class="geo__live"><span class="dot" />Top 3 Map Pack</span>
            </div>
            <div class="geo__map">
              <div class="geo__grid">
                {cells.map((cell) => (
                  <span class={`geo__cell geo__cell--${cell.tone}${cell.pin ? " geo__cell--pin" : ""}`}>
                    {cell.rank > 8 ? "8+" : cell.rank}
                  </span>
                ))}
              </div>
            </div>
            <div class="geo__foot">
              <span><span class="stars" aria-hidden="true">★</span> 4.9 · 243 reviews</span>
              <span class="mono">461 GBP calls</span>
            </div>
          </div>
        )
      }

      <a class="result panel" href={caseHref}>
        <span class="result__label mono">Client result</span>
        <span class="result__main">
          <span class="result__big mono">461</span>
          <span>calls from Google Business Profile</span>
        </span>
        <span class="result__stats">
          <span><small>Profile interactions</small><b class="mono">+62%</b></span>
          <span><small>Map Pack position</small><b class="mono">Top 3</b></span>
        </span>
        <span class="text-link">Read the case study</span>
      </a>
    </div>
  </div>

  <div class="container proof">
    <div class="proof__head">
      <h2 class="proof__title">Proof, not promises</h2>
      <p>Receipts from 5+ years of ranking local businesses on Google Maps.</p>
    </div>
    <ul class="proof__list">
      {
        proofBadges.map((b) => (
          <li>
            <strong>{b.title}</strong>
            <span>{b.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 8vw, 104px) 0 0;
  }
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 50% 20%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 20%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__layout {
      grid-template-columns: 1.12fr 0.88fr;
      gap: 64px;
    }
  }
  .hero__copy {
    min-width: 0;
  }
  .hero h1 .em {
    display: inline-block;
  }
  .hero__sub {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--text);
    max-width: 34em;
    margin-top: 8px;
  }
  .hero__strap {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .hero__body {
    max-width: 36em;
  }
  .hero .btn-row {
    margin: 32px 0 40px;
  }
  .hero__points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .hero__points {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .hero__points li {
    display: grid;
    gap: 2px;
    padding: 16px 16px 0 0;
  }
  .hero__points strong {
    font-size: 0.95rem;
  }
  .hero__points span {
    font-size: 0.8rem;
    color: var(--dim);
  }

  .hero__visual {
    display: grid;
    gap: 16px;
    min-width: 0;
    animation: rise 0.8s 0.1s ease-out both;
  }

  /* Geo-grid card */
  .geo {
    border-radius: var(--radius);
    padding: 18px;
    box-shadow: 0 40px 100px -40px rgb(0 0 0 / 90%);
  }
  .geo__head,
  .geo__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 0.8rem;
  }
  .geo__head .mono {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--dim);
  }
  .geo__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(61 220 151 / 10%);
    color: var(--good);
    font-weight: 500;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .geo__map {
    margin: 14px 0;
    border-radius: 12px;
    padding: 14px;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 50% 50%, rgb(255 61 74 / 12%), transparent 55%),
      linear-gradient(115deg, transparent 46%, rgb(255 255 255 / 6%) 47%, rgb(255 255 255 / 6%) 49%, transparent 50%),
      linear-gradient(28deg, transparent 60%, rgb(255 255 255 / 5%) 61%, rgb(255 255 255 / 5%) 62.5%, transparent 63.5%),
      #0a0c10;
  }
  .geo__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: clamp(6px, 1.4vw, 10px);
  }
  .geo__cell {
    aspect-ratio: 1;
    max-width: 100%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 1.4vw, 0.78rem);
    font-weight: 600;
    color: #07080b;
  }
  .geo__cell--good {
    background: var(--good);
    box-shadow: 0 0 18px -4px rgb(61 220 151 / 70%);
  }
  .geo__cell--mid {
    background: var(--warn);
  }
  .geo__cell--low {
    background: rgb(255 255 255 / 10%);
    color: var(--muted);
  }
  .geo__cell--pin {
    background: var(--accent);
    color: #fff;
    box-shadow:
      0 0 0 4px rgb(255 61 74 / 25%),
      0 0 30px rgb(255 61 74 / 70%);
  }
  .geo__foot {
    color: var(--muted);
  }

  /* Portrait variant */
  .portrait {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    padding: 8px;
  }
  .portrait__img {
    width: 100%;
    border-radius: calc(var(--radius) - 6px);
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
  }
  .float {
    position: absolute;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    background: rgb(7 8 11 / 75%);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line-2);
  }
  .float--a {
    left: -12px;
    top: 14%;
  }
  .float--b {
    right: -12px;
    top: 30%;
  }
  .float--c {
    left: -12px;
    bottom: 18%;
  }

  .result {
    display: grid;
    gap: 14px;
    padding: 22px;
    transition: border-color 0.2s;
  }
  .result:hover {
    border-color: rgb(255 61 74 / 40%);
  }
  .result__label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .result__main {
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .result__big {
    font-size: 2.8rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--text);
    line-height: 1;
  }
  .result__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .result__stats > span {
    display: grid;
  }
  .result__stats small {
    font-size: 0.75rem;
    color: var(--dim);
  }
  .result__stats b {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--text);
  }

  .proof {
    position: relative;
    z-index: 1;
    margin-top: clamp(64px, 8vw, 96px);
    padding-block: 32px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .proof {
      grid-template-columns: 0.75fr 1.25fr;
    }
  }
  .proof__title {
    font-size: 1.15rem;
    margin-bottom: 4px;
  }
  .proof__head p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--dim);
  }
  .proof__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .proof__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .proof__list li {
    display: grid;
    padding-left: 14px;
    border-left: 1px solid var(--line-2);
  }
  .proof__list strong {
    font-size: 0.95rem;
  }
  .proof__list span {
    font-size: 0.8rem;
    color: var(--dim);
  }
</style>
