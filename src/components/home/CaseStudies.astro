---
import { caseStudies } from "../../data/home";
const featuredHref = "/case-studies/gbp-calls-growth";
---

<section class="section" aria-labelledby="cases-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Local SEO Case Studies</p>
      <h2 id="cases-title">Local SEO Results That Turned Rankings Into <span class="em">Real Leads</span></h2>
      <p>
        Real Google Maps ranking, Google Business Profile, and local lead growth, built through
        clear, repeatable systems for service-area businesses.
      </p>
    </div>

    <article class="featured panel--edge">
      <div class="featured__copy">
        <p class="tag">Local Service Business</p>
        <h3>
          <a href={featuredHref}>From Weak Maps Visibility to Consistent Call Growth</a>
        </h3>
        <p>
          A Local SEO case study on turning an under-optimized Google Business Profile into a steady
          source of qualified inbound calls.
        </p>
        <span class="text-link" aria-hidden="true">Read the case study</span>
      </div>
      <dl class="featured__stats">
        <div class="featured__hero"><dt>Calls from GBP</dt><dd class="mono">461</dd></div>
        <div><dt>Profile Interactions</dt><dd class="mono">+62%</dd></div>
        <div><dt>Map Pack for Core Terms</dt><dd class="mono">Top 3</dd></div>
      </dl>
    </article>

    <ul class="hairgrid hairgrid--2 cases">
      {
        caseStudies.map((c) => (
          <li class="case">
            <p class="tag">{c.category}</p>
            <p class="case__value">
              <strong class="mono">{c.value}</strong>
              <span>{c.label}</span>
            </p>
            <h3>
              <a href={c.href}>{c.title}</a>
            </h3>
            <p>{c.text}</p>
            <span class="text-link" aria-hidden="true">
              View result
            </span>
          </li>
        ))
      }
    </ul>

    <div class="cases__cta">
      <div>
        <h3>Want Similar Local SEO Growth?</h3>
        <p>
          I'll review your Google Business Profile, Maps ranking, citations, and local landing pages,
          and show exactly where the lead gaps are.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="#free-audit">Get Free SEO Audit</a>
        <a class="btn btn--ghost" href="/case-studies">See all case studies</a>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    position: relative;
    display: grid;
    gap: 36px;
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 52px);
    margin-bottom: 16px;
    overflow: hidden;
    background-image:
      radial-gradient(80% 120% at 100% 100%, rgb(255 61 74 / 16%), transparent 60%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
    background-origin: border-box;
  }
  @media (min-width: 1024px) {
    .featured {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .featured__copy {
    min-width: 0;
  }
  .featured h3 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    letter-spacing: -0.035em;
  }
  .featured h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .featured__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .featured__stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 22px;
    background: rgb(11 13 18 / 92%);
  }
  .featured__hero {
    grid-column: 1 / -1;
  }
  .featured__stats dd {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.04em;
    color: var(--text);
    line-height: 1;
  }
  .featured__hero dd {
    font-size: clamp(3.4rem, 7vw, 5.5rem);
    background: linear-gradient(100deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .featured__stats dt {
    font-size: 0.8rem;
    color: var(--dim);
  }

  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 36px 32px !important;
    transition: background 0.25s;
  }
  .case:hover {
    background: rgb(255 255 255 / 2%);
  }
  .case__value {
    display: grid;
    margin-bottom: 16px;
  }
  .case__value strong {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }
  .case__value span {
    font-size: 0.85rem;
    color: var(--dim);
  }
  .case h3 {
    font-size: 1.15rem;
  }
  .case h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .case p {
    font-size: 0.925rem;
  }
  .case .text-link {
    margin-top: auto;
  }

  .cases__cta {
    margin-top: 48px;
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .cases__cta h3 {
    font-size: 1.5rem;
  }
  .cases__cta p {
    margin: 0;
    max-width: 60ch;
  }
  @media (min-width: 1024px) {
    .cases__cta {
      grid-template-columns: 1.4fr auto;
    }
  }
</style>
