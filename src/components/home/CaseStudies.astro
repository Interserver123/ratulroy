---
import { caseStudies } from "../../data/home";
const featuredHref = "/case-studies/gbp-calls-growth";
---

<section class="section" aria-labelledby="cases-title">
  <div class="container">
    <div class="cases-head" data-reveal>
      <div>
        <p class="eyebrow">Local SEO Case Studies</p>
        <h2 id="cases-title">Local SEO Results That Turned Rankings Into <span class="em">Real Leads.</span></h2>
        <p>
          Real Google Maps ranking, Google Business Profile, and local lead growth, built through
          clear, repeatable systems for service-area businesses.
        </p>
      </div>
      <a class="btn btn--ghost" href="/case-studies">See all case studies <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <article class="featured card" data-reveal>
      <div class="featured__copy">
        <p class="tag">Local Service Business</p>
        <h3><a href={featuredHref}>From Weak Maps Visibility to Consistent Call Growth</a></h3>
        <p>
          A Local SEO case study on turning an under-optimized Google Business Profile into a steady
          source of qualified inbound calls.
        </p>
        <span class="text-link">Read the case study</span>
      </div>
      <div class="browser" aria-hidden="true">
        <div class="browser__bar"><svg viewBox="0 0 20 26" width="12" height="15" aria-hidden="true"><path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor"/></svg><i>Google Business Profile · Performance</i></div>
        <div class="browser__screen">
          <dl class="kpis">
            <div class="kpis__hero"><dt>Calls from GBP</dt><dd class="num" data-count>461</dd></div>
            <div><dt>Profile Interactions</dt><dd class="num" data-count>+62%</dd></div>
            <div><dt>Map Pack for Core Terms</dt><dd>Top 3</dd></div>
          </dl>
        </div>
      </div>
    </article>

    <ul class="grid grid--2 cases">
      {
        caseStudies.map((c, i) => (
          <li class="card card--hover case" data-reveal style={`--d:${i % 2}`} data-spot>
            <div class="case__screen" aria-hidden="true">
              <span class="case__dots"><svg viewBox="0 0 20 26" width="12" height="15" aria-hidden="true"><path d="M10 0C4.5 0 0 4.4 0 9.8 0 17.2 10 26 10 26s10-8.8 10-16.2C20 4.4 15.5 0 10 0zm0 13.6a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6z" fill="currentColor"/></svg></span>
              <span class="case__value num">{c.value}</span>
              <span class="case__label">{c.label}</span>
            </div>
            <p class="tag">{c.category}</p>
            <h3>
              <a href={c.href}>{c.title}</a>
            </h3>
            <p class="sr-only">{c.value} {c.label}</p>
            <p>{c.text}</p>
            <span class="text-link">View result</span>
          </li>
        ))
      }
    </ul>

    <div class="cases__cta card" data-reveal>
      <div>
        <h3>Want Similar Local SEO Growth?</h3>
        <p>
          I'll review your Google Business Profile, Maps ranking, citations, and local landing pages,
          and show exactly where the lead gaps are.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--dark" href="#free-audit"><span class="disc" aria-hidden="true">↗</span>Get Free SEO Audit</a>
        <a class="btn btn--ghost" href="/case-studies">See all case studies</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cases-head {
    display: grid;
    gap: 24px;
    margin-bottom: 40px;
  }
  .cases-head p:not(.eyebrow) {
    max-width: 60ch;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .cases-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  .featured {
    display: grid;
    gap: 32px;
    align-items: center;
    padding: clamp(24px, 4vw, 44px);
    margin-bottom: 18px;
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 1024px) {
    .featured {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 48px;
    }
  }
  .featured__copy {
    min-width: 0;
  }
  .featured h3 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.035em;
  }
  .featured h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .browser {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 30px 60px -30px rgb(16 42 40 / 35%);
    transform: rotate(-1.5deg);
    transition: transform 0.6s var(--ease);
  }
  .featured:hover .browser {
    transform: none;
  }
  .browser__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
  }
  .browser__bar svg {
    color: var(--accent);
  }
  .browser__bar i {
    margin-left: 10px;
    font-style: normal;
    color: var(--dim);
  }
  .browser__screen {
    padding: 18px;
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(255 122 102 / 14%), transparent 60%),
      #fff;
  }
  .kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
  }
  .kpis > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 80%);
  }
  .kpis__hero {
    grid-column: 1 / -1;
  }
  .kpis dd {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--good);
  }
  .kpis__hero dd {
    font-size: clamp(3rem, 6vw, 4.4rem);
    color: var(--accent);
  }
  .kpis dt {
    font-size: 0.78rem;
  }

  .case {
    display: flex;
    flex-direction: column;
    padding: 18px 18px 24px;
  }
  .case__screen {
    position: relative;
    display: grid;
    align-content: center;
    gap: 4px;
    min-height: 160px;
    margin-bottom: 20px;
    padding: 34px 22px 20px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background:
      radial-gradient(80% 120% at 100% 100%, rgb(255 122 102 / 22%), transparent 60%),
      url("/topo.svg") 40% 30% / 700px auto,
      linear-gradient(180deg, #fafcfb, #eef4f1);
    overflow: hidden;
  }
  .case__dots {
    position: absolute;
    top: 12px;
    left: 14px;
    display: flex;
    gap: 5px;
  }
  .case__dots {
    color: var(--accent);
  }
  .case__value {
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
    transition: transform 0.5s var(--ease);
    transform-origin: left;
  }
  .case:hover .case__value {
    transform: scale(1.06);
  }
  .case__label {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 500;
  }
  .case h3 {
    font-size: 1.1rem;
  }
  .case h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .case p {
    font-size: 0.9rem;
  }
  .case .text-link {
    margin-top: auto;
  }

  .cases__cta {
    margin-top: 28px;
    display: grid;
    gap: 20px;
    align-items: center;
    padding: clamp(24px, 4vw, 36px);
  }
  .cases__cta h3 {
    font-size: 1.4rem;
  }
  .cases__cta p {
    margin: 0;
    max-width: 60ch;
  }
  @media (min-width: 1024px) {
    .cases__cta {
      grid-template-columns: 1.4fr auto;
    }
  }
</style>
