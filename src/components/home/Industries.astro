---
import { industries } from "../../data/home";

// Typical "near me" searches for each industry, in the same order as the cards.
const queries = [
  "AC repair near me",
  "emergency plumber near me",
  "roof repair near me",
  "towing service near me",
  "pest control near me",
  "electrician near me",
  "house cleaning near me",
  "movers near me",
  "general contractor near me",
  "dentist near me",
  "clinic near me",
  "lawyer near me",
];
---

<section class="section wash" aria-labelledby="industries-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Industries We Serve</p>
      <h2 id="industries-title">Built for local businesses that <span class="em">depend on calls.</span></h2>
      <p>
        Every local industry has different search behavior, competition, and trust signals. I build
        Local SEO systems around how your customers actually search, compare, and choose a business.
      </p>
    </div>

    <div class="qbar" data-reveal aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <span class="qbar__text" data-qtext>{queries[1]}</span><span class="qbar__caret"></span>
      <span class="qbar__hint">Click an industry to search it</span>
    </div>

    <ul class="ind" data-ind>
      {
        industries.map((i, n) => (
          <li class="card card--hover" data-reveal style={`--d:${n % 4}`} data-spot data-q={queries[n]}>
            <span class="ind__n num">{String(n + 1).padStart(2, "0")}</span>
            <h3>{i.title}</h3>
            <p>{i.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="ind__more" data-reveal>
      <p class="ind__line">
        <a href="#contact"><strong>More Local Service Niches</strong></a>
        <span>If your business depends on local search, the system can be adapted.</span>
      </p>
      <p class="note">
        Don't see your industry? If your business relies on local visibility and inbound calls,
        Local SEO can still work for you.
      </p>
      <a class="btn btn--dark" href="#contact"><span class="disc" aria-hidden="true">↗</span>Check My Local SEO Opportunity</a>
    </div>
  </div>
</section>

<script>
  // Types a real "near me" search and lights up the matching industry card.
  const bar = document.querySelector<HTMLElement>("[data-qtext]");
  const list = document.querySelector<HTMLElement>("[data-ind]");
  if (bar && list) {
    const cards = [...list.querySelectorAll<HTMLElement>("[data-q]")];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let idx = 1;
    let timer: number | undefined;
    let typing: number | undefined;
    const light = (n: number) => cards.forEach((c, k) => c.classList.toggle("is-match", k === n));
    const type = (n: number) => {
      window.clearInterval(typing);
      const q = cards[n].dataset.q ?? "";
      light(n);
      if (reduce) {
        bar.textContent = q;
        return;
      }
      let k = 0;
      bar.textContent = "";
      typing = window.setInterval(() => {
        k++;
        bar.textContent = q.slice(0, k);
        if (k >= q.length) window.clearInterval(typing);
      }, 38);
    };
    const cycle = () => {
      idx = (idx + 1) % cards.length;
      type(idx);
    };
    cards.forEach((c, k) =>
      c.addEventListener("click", () => {
        window.clearInterval(timer);
        idx = k;
        type(k);
      }),
    );
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      type(idx);
      if (!reduce) timer = window.setInterval(cycle, 2600);
    });
    io.observe(list);
  }
</script>

<style>
  .qbar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 620px;
    margin: -16px auto 32px;
    padding: 14px 20px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    color: var(--ink);
    font-weight: 500;
  }
  .qbar svg {
    flex-shrink: 0;
    color: var(--accent);
  }
  .qbar__caret {
    width: 2px;
    height: 1.2em;
    margin-left: -8px;
    background: var(--accent);
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink {
    to {
      opacity: 0;
    }
  }
  .qbar__hint {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--dim);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .qbar__hint {
      display: none;
    }
  }
  .ind .card {
    cursor: pointer;
  }
  .ind .card:global(.is-match) {
    border-color: var(--accent);
    box-shadow:
      0 0 0 4px rgb(232 64 47 / 10%),
      var(--shadow-lg);
    transform: translateY(-4px);
  }
  .ind .card:global(.is-match) .ind__n {
    background: var(--accent);
    color: #fff;
  }
  .ind {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .ind {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .ind {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ind .card {
    padding: 20px 22px;
  }
  .ind__n {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    margin-bottom: 14px;
  }
  .ind h3 {
    font-size: 1.02rem;
    margin-bottom: 4px;
  }
  .ind p {
    margin: 0;
    font-size: 0.875rem;
  }
  .ind__more {
    margin-top: 40px;
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
  }
  .ind__line {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .ind__line strong {
    font-size: 1.15rem;
  }
  .ind__line span {
    color: var(--ink-2);
  }
  .ind__more .note {
    max-width: 52ch;
    margin: 0 0 6px;
  }
</style>
