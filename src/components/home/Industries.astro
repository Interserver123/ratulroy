---
import { industries } from "../../data/home";
---

<section class="section section--alt" aria-labelledby="industries-title">
  <div class="container">
    <div class="ind-head">
      <div>
        <p class="eyebrow">Industries We Serve</p>
        <h2 id="industries-title">Built for local businesses that <span class="em">depend on calls.</span></h2>
      </div>
      <p>
        Every local industry has different search behavior, competition, and trust signals. I build
        Local SEO systems around how your customers actually search, compare, and choose a business.
      </p>
    </div>

    <ul class="ind">
      {
        industries.map((i, n) => (
          <li>
            <span class="ind__n mono">{String(n + 1).padStart(2, "0")}</span>
            <h3>{i.title}</h3>
            <p>{i.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="ind__more panel--edge">
      <div>
        <h3><a href="#contact">More Local Service Niches</a></h3>
        <p>If your business depends on local search, the system can be adapted.</p>
        <p class="note">
          Don't see your industry? If your business relies on local visibility and inbound calls,
          Local SEO can still work for you.
        </p>
      </div>
      <a class="btn btn--primary" href="#contact">Check My Local SEO Opportunity <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .ind-head {
    display: grid;
    gap: 24px;
    margin-bottom: 56px;
  }
  @media (min-width: 1024px) {
    .ind-head {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 72px;
      align-items: end;
    }
  }
  .ind {
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .ind {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 40px;
    }
  }
  @media (min-width: 1024px) {
    .ind {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .ind li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .ind__n {
    grid-row: span 2;
    font-size: 0.72rem;
    color: var(--accent);
    padding-top: 4px;
  }
  .ind h3 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }
  .ind p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--dim);
  }
  .ind__more {
    margin-top: 48px;
    display: grid;
    gap: 24px;
    align-items: center;
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 40px);
  }
  .ind__more h3 {
    font-size: 1.4rem;
  }
  .ind__more .note {
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ind__more {
      grid-template-columns: 1.5fr auto;
    }
  }
</style>
