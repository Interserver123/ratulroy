---
// "Trusted By" logos: add files to /public/logos and list them here to show the strip.
const trustedLogos: { src: string; alt: string }[] = [];
---

{
  trustedLogos.length > 0 && (
    <section class="trusted" aria-labelledby="trusted-title">
      <div class="container">
        <p class="eyebrow">Trusted By</p>
        <h2 id="trusted-title">Brands That Count on Us</h2>
        <p>
          Selected businesses and projects that trusted Ratul Roy's SEO execution, Local SEO
          systems, and search visibility strategy.
        </p>
        <ul class="logos">
          {trustedLogos.map((l) => (
            <li>
              <img src={l.src} alt={l.alt} loading="lazy" decoding="async" width="160" height="60" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<section class="section section--alt" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__copy">
      <p class="eyebrow">The Specialist Behind the System</p>
      <h2 id="about-title">From curious student to <span class="em">local search architect.</span></h2>
      <p class="lead">
        My fascination with how businesses get found online started in school, testing what makes
        one show up and another disappear. That curiosity carried through my ICT studies at Islamic
        University, sharpened over two years at Netmark, and proved itself on Fiverr as a Level 2
        seller. Today I run DigiPolli, focused on one thing: helping local businesses dominate Maps,
        organic, and AI search with a singular focus on revenue.
      </p>
      <dl class="facts">
        <div><dt>in SEO</dt><dd class="mono">5+ Yrs</dd></div>
        <div><dt>Fiverr</dt><dd class="mono">Level 2</dd></div>
        <div><dt>Founder</dt><dd>DigiPolli</dd></div>
      </dl>
      <a class="text-link" href="#contact">Read the full story</a>
    </div>

    <ol class="journey" aria-label="Fiverr journey">
      <li class="journey__step">
        <span class="journey__label mono">Started Here</span>
        <strong>Level One</strong>
      </li>
      <li class="journey__line" aria-hidden="true"></li>
      <li class="journey__step journey__step--now panel--edge">
        <span class="journey__label mono">Where I am now</span>
        <strong>Level Two <span class="stars">·</span> 4.9★</strong>
      </li>
    </ol>
  </div>
</section>

<style>
  .trusted {
    padding-block: 64px;
    text-align: center;
    border-top: 1px solid var(--line);
  }
  .logos {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    align-items: center;
  }
  .logos img {
    max-height: 40px;
    width: auto;
    filter: grayscale(1) brightness(1.8);
    opacity: 0.6;
  }
  .about {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about {
      grid-template-columns: 1.45fr 0.55fr;
      gap: 80px;
    }
  }
  .about__copy {
    min-width: 0;
  }
  .about .lead {
    max-width: 62ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 36px 0;
    border-top: 1px solid var(--line);
  }
  .facts > div {
    display: flex;
    flex-direction: column-reverse;
    padding: 18px 16px 0 0;
  }
  .facts dd {
    margin: 0;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    color: var(--text);
    letter-spacing: -0.03em;
  }
  .facts dt {
    font-size: 0.8rem;
    color: var(--dim);
  }
  .journey {
    display: grid;
    gap: 0;
    padding: 0;
  }
  .journey__step {
    display: grid;
    gap: 6px;
    padding: 24px;
    border-radius: var(--radius);
    border: 1px dashed var(--line-2);
  }
  .journey__line {
    width: 1px;
    height: 40px;
    margin-left: 32px;
    background: linear-gradient(var(--line-2), var(--accent));
  }
  .journey__step strong {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .journey__step--now {
    border-style: solid;
    box-shadow: 0 30px 80px -30px rgb(255 61 74 / 40%);
  }
  .journey__label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .journey__step--now .journey__label {
    color: var(--accent);
  }
</style>
