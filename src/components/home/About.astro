---
import { Image } from "astro:assets";
import { img } from "../../lib/img";
import { trustedLogos as logos } from "../../data/logos";

const trustedLogos = logos.map(([file, alt]) => ({ src: img(`logos/${file}`), alt }));
---

{
  trustedLogos.length > 0 && (
    <section class="trusted" aria-labelledby="trusted-title">
      <div class="container">
        <p class="eyebrow">Trusted By</p>
        <h2 id="trusted-title">Brands That Count on Us</h2>
        <p>
          Businesses and projects that hired Ratul Roy for Local SEO, Google Business Profile work
          and organic search growth.
        </p>
        <div class="logos">
          {[0, 1].map((copy) => (
            <ul class="logos__track" aria-hidden={copy === 1 ? "true" : undefined}>
              {trustedLogos.map((l) => (
                <li>
                  <Image src={l.src} alt={copy === 1 ? "" : `${l.alt} logo`} height={96} loading="lazy" class="logos__img" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="section" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__head" data-reveal>
      <p class="eyebrow">The Specialist Behind the System</p>
      <h2 id="about-title">From curious student to <span class="em">local search architect.</span></h2>
    </div>

    <p class="statement" data-highlight>
      My fascination with how businesses get found online started in school, testing what makes one
      show up and another disappear. That curiosity carried through my ICT studies at Islamic
      University, sharpened over two years at Netmark, and proved itself on Fiverr as a Level 2
      seller. Today I run DigiPolli from Bagerhat with one job: getting local businesses found on
      Google Maps, in organic results and in AI answers, and judging the work by revenue.
    </p>

    <div class="cred card" data-reveal>
      <div class="cred__info">
        <p class="cred__kicker">By the numbers</p>
        <dl class="cred__stats">
          <div><dt>Years in SEO</dt><dd><span class="num" data-count>5+</span></dd></div>
          <div><dt>Fiverr seller</dt><dd>Level <span class="num" data-count>2</span></dd></div>
          <div><dt>Founder of</dt><dd>DigiPolli</dd></div>
        </dl>

        <div class="climb" aria-label="Fiverr progress from Level One to Level Two, rated 4.9 from 243 reviews">
          <div class="climb__ends">
            <span>Level One</span>
            <span>Level Two</span>
          </div>
          <div class="climb__track" aria-hidden="true"><span class="climb__fill"></span><span class="climb__dot"></span></div>
          <p class="climb__meta"><span class="stars" aria-hidden="true">★★★★★</span> <b class="num">4.9</b> rating · <b class="num" data-count>243</b> reviews</p>
        </div>

        <a class="text-link" href="/about">Read the full story</a>
      </div>

      <div class="cred__shots" aria-label="Fiverr screenshots">
        <figure class="shot shot--back">
          <Image src={img("fiverr/fiverr-level-one.jpg")} alt="Fiverr notification congratulating Ratul on reaching Level One" widths={[360, 540]} sizes="(min-width: 1024px) 340px, 80vw" loading="lazy" class="shot__img" />
          <figcaption>Started here · Level One</figcaption>
        </figure>
        <figure class="shot shot--front">
          <Image src={img("fiverr/fiverr-level-two.png")} alt="Ratul's Fiverr profile showing Level 2, 4.9 rating and 243 reviews" widths={[360, 540]} sizes="(min-width: 1024px) 340px, 80vw" loading="lazy" class="shot__img" />
          <figcaption>Where I am now · Level Two</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .trusted {
    padding-block: 56px 24px;
    text-align: center;
  }
  .trusted h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .trusted p:not(.eyebrow) {
    max-width: 56ch;
    margin-inline: auto;
  }
  .logos {
    display: flex;
    overflow: hidden;
    margin-top: 28px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .logos__track {
    display: flex;
    flex-shrink: 0;
    gap: 16px;
    padding-right: 16px;
    animation: logos-x 36s linear infinite;
  }
  .logos:hover .logos__track {
    animation-play-state: paused;
  }
  @keyframes logos-x {
    to {
      transform: translateX(-100%);
    }
  }
  .logos__track li {
    display: grid;
    place-items: center;
    height: 84px;
    padding: 0 22px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .logos__img {
    height: 48px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: saturate(0.9);
    transition: transform 0.4s var(--ease);
  }
  .logos__track li:hover .logos__img {
    transform: scale(1.06);
  }
  .about {
    max-width: 980px;
  }
  .about__head {
    text-align: center;
  }
  .statement {
    margin: 24px 0 56px;
    font-size: clamp(1.4rem, 2.9vw, 2.15rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--ink);
    text-align: center;
  }
  :global(.statement.is-live) :global(.hl-word) {
    /* dimmed but still readable (WCAG AA 4.5:1 on --bg) until highlighted */
    color: #66726f;
    transition: color 0.35s;
  }
  :global(.statement.is-live) :global(.hl-word.on) {
    color: var(--ink);
  }
  /* Credential band: stats + Fiverr climb on the left, stacked proof screenshots on the right */
  .cred {
    display: grid;
    gap: 36px;
    align-items: center;
    padding: clamp(24px, 4vw, 44px);
    border-radius: 28px;
    box-shadow: var(--shadow-lg);
    background:
      url("/topo.svg") 100% 50% / 900px auto no-repeat,
      radial-gradient(70% 90% at 100% 50%, rgb(15 157 99 / 9%), transparent 70%),
      var(--paper);
  }
  @media (min-width: 900px) {
    .cred {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
    }
  }
  .cred__info {
    min-width: 0;
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .cred__kicker {
    margin: 0 0 -8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .cred__stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
  }
  .cred__stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 0 18px;
  }
  .cred__stats > div:first-child {
    padding-left: 0;
  }
  .cred__stats > div + div {
    border-left: 1px solid var(--line);
  }
  .cred__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--ink);
    white-space: nowrap;
  }
  .cred__stats > div:first-child dd {
    color: var(--accent);
  }
  .cred__stats dt {
    font-size: 0.82rem;
  }

  .climb {
    width: 100%;
    padding: 18px 20px;
    border-radius: 18px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .climb__ends {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .climb__ends span:last-child {
    color: var(--good);
  }
  .climb__track {
    position: relative;
    height: 8px;
    border-radius: 8px;
    background: var(--line);
  }
  .climb__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--accent-2), var(--good));
    transform-origin: left;
  }
  .climb__dot {
    position: absolute;
    right: -2px;
    top: 50%;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    translate: 0 -50%;
    background: #fff;
    border: 4px solid var(--good);
    box-shadow: 0 0 0 5px rgb(15 157 99 / 18%);
  }
  :global(.js) .cred .climb__fill {
    transform: scaleX(0);
    transition: transform 1.6s var(--ease) 0.4s;
  }
  :global(.js) .cred .climb__dot {
    opacity: 0;
    transition: opacity 0.4s 1.8s;
  }
  :global(.js) .cred:global(.is-in) .climb__fill {
    transform: none;
  }
  :global(.js) .cred:global(.is-in) .climb__dot {
    opacity: 1;
  }
  .climb__meta {
    margin: 12px 0 0;
    font-size: 0.85rem;
  }
  .climb__meta b {
    color: var(--ink);
  }

  /* Stacked screenshots that fan out on hover */
  .cred__shots {
    position: relative;
    min-height: 300px;
  }
  .shot {
    position: absolute;
    margin: 0;
    width: min(340px, 78%);
    padding: 8px 8px 10px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }
  .shot__img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: 12px;
  }
  .shot figcaption {
    padding: 8px 6px 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }
  .shot--back {
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column-reverse;
    padding: 10px 8px 8px;
    transform: rotate(-5deg);
  }
  .shot--back figcaption {
    padding: 0 6px 8px;
  }
  .shot--front {
    right: 0;
    bottom: 0;
    transform: rotate(3deg);
    background: var(--ink);
    border-color: var(--ink);
    z-index: 1;
  }
  .shot--front figcaption {
    color: var(--accent-2);
  }
  .cred__shots:hover .shot--back {
    transform: rotate(-8deg) translate(-12px, -8px);
  }
  .cred__shots:hover .shot--front {
    transform: rotate(0deg) translate(6px, 6px);
    box-shadow: 0 40px 80px -30px rgb(15 26 28 / 55%);
  }
  @media (max-width: 899px) {
    .cred__shots {
      min-height: 330px;
    }
  }
  @media (max-width: 480px) {
    .cred__stats {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .cred__stats > div,
    .cred__stats > div:first-child {
      padding: 0 0 0 14px;
      border-left: 2px solid var(--line);
    }
    .cred__stats > div:first-child {
      border-left-color: var(--accent);
    }
  }
</style>
