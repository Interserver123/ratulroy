---
// "Trusted By" logos: add files to /public/logos and list them here to show the strip.
const trustedLogos: { src: string; alt: string }[] = [];
---

{
  trustedLogos.length > 0 && (
    <section class="section section--soft trusted" aria-labelledby="trusted-title">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="eyebrow">Trusted By</p>
          <h2 id="trusted-title">Brands That Count on Us</h2>
          <p>
            Selected businesses and projects that trusted Ratul Roy's SEO execution, Local SEO
            systems, and search visibility strategy.
          </p>
        </div>
        <ul class="logos">
          {trustedLogos.map((l) => (
            <li>
              <img src={l.src} alt={l.alt} loading="lazy" decoding="async" width="160" height="60" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<section class="section" aria-labelledby="about-title">
  <div class="container about">
    <div>
      <p class="eyebrow">The Specialist Behind the System</p>
      <h2 id="about-title">From curious student to local search architect.</h2>
      <p class="lead">
        My fascination with how businesses get found online started in school, testing what makes
        one show up and another disappear. That curiosity carried through my ICT studies at Islamic
        University, sharpened over two years at Netmark, and proved itself on Fiverr as a Level 2
        seller. Today I run DigiPolli, focused on one thing: helping local businesses dominate Maps,
        organic, and AI search with a singular focus on revenue.
      </p>
      <ul class="about__facts">
        <li><strong>5+ Yrs</strong> in SEO</li>
        <li><strong>Fiverr</strong> Level 2</li>
        <li><strong>Founder</strong> · DigiPolli</li>
      </ul>
      <a class="text-link" href="#contact">Read the full story</a>
    </div>
    <ol class="journey" aria-label="Fiverr journey">
      <li class="journey__step">
        <span class="journey__label">Started Here</span>
        <strong>Level One</strong>
      </li>
      <li class="journey__step journey__step--now">
        <span class="journey__label">Where I am now</span>
        <strong>Level Two · 4.9★</strong>
      </li>
    </ol>
  </div>
</section>

<style>
  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    align-items: center;
  }
  .logos img {
    max-height: 48px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.75;
  }
  .about {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .about {
      grid-template-columns: 1.4fr 0.6fr;
    }
  }
  .about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }
  .about__facts li {
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    font-size: 0.925rem;
  }
  .about__facts strong {
    color: var(--ink);
  }
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .journey__step {
    display: grid;
    padding: 24px;
    border-radius: var(--radius);
    border: 1px dashed #cbd5e1;
  }
  .journey__step--now {
    border: 0;
    background: var(--bg-dark);
    color: #cbd5e1;
  }
  .journey__step strong {
    font-family: var(--font-head);
    font-size: 1.5rem;
    color: var(--ink);
  }
  .journey__step--now strong {
    color: #fff;
  }
  .journey__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .journey__step--now .journey__label {
    color: #86efac;
  }
</style>
