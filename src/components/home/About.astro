---
import { Image } from "astro:assets";
import { img } from "../../lib/img";

const trustedLogos = [
  ["dallas-heating-and-ac.png", "Dallas Heating and AC"],
  ["amz-sellers-attorney.png", "AMZ Sellers Attorney"],
  ["lpma-primary-care-medicine.png", "LPMA Primary Care Medicine"],
  ["pediatric-pod.png", "Pediatric Pod"],
  ["shiridi-sai-packers-and-movers.png", "Shiridi Sai Packers and Movers"],
  ["edoxi-training-institute.svg", "EDOXI Training Institute"],
  ["logoinhours-dallas.jpg", "LogoinHours Dallas"],
  ["qs-health-care-service.png", "QS Health Care Service"],
  ["chococraving.webp", "ChocoCraving"],
].map(([file, alt]) => ({ src: img(`logos/${file}`), alt }));
---

{
  trustedLogos.length > 0 && (
    <section class="trusted" aria-labelledby="trusted-title">
      <div class="container">
        <p class="eyebrow">Trusted By</p>
        <h2 id="trusted-title">Brands That Count on Us</h2>
        <p>
          Selected businesses and projects that trusted Ratul Roy's SEO execution, Local SEO
          systems, and search visibility strategy.
        </p>
        <div class="logos">
          {[0, 1].map((copy) => (
            <ul class="logos__track" aria-hidden={copy === 1 ? "true" : undefined}>
              {trustedLogos.map((l) => (
                <li>
                  <Image src={l.src} alt={copy === 1 ? "" : `${l.alt} logo`} height={96} loading="lazy" class="logos__img" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="section" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__head" data-reveal>
      <p class="eyebrow">The Specialist Behind the System</p>
      <h2 id="about-title">From curious student to <span class="em">local search architect.</span></h2>
    </div>

    <p class="statement" data-highlight>
      My fascination with how businesses get found online started in school, testing what makes one
      show up and another disappear. That curiosity carried through my ICT studies at Islamic
      University, sharpened over two years at Netmark, and proved itself on Fiverr as a Level 2
      seller. Today I run DigiPolli, focused on one thing: helping local businesses dominate Maps,
      organic, and AI search with a singular focus on revenue.
    </p>

    <div class="about__foot">
      <dl class="facts">
        <div class="card" data-reveal><dt>in SEO</dt><dd><span class="num" data-count>5+</span> Yrs</dd></div>
        <div class="card" data-reveal style="--d:1"><dt>Fiverr</dt><dd>Level <span class="num" data-count>2</span></dd></div>
        <div class="card" data-reveal style="--d:2"><dt>Founder</dt><dd>DigiPolli</dd></div>
      </dl>

      <ol class="journey" aria-label="Fiverr journey" data-reveal style="--d:3">
        <li class="journey__step">
          <Image src={img("fiverr/fiverr-level-one.jpg")} alt="Fiverr notification congratulating Ratul on reaching Level One" widths={[320, 480]} sizes="240px" loading="lazy" class="journey__img" />
          <span class="journey__label">Started Here</span>
          <strong>Level One</strong>
        </li>
        <li class="journey__line" aria-hidden="true"><span></span></li>
        <li class="journey__step journey__step--now">
          <Image src={img("fiverr/fiverr-level-two.png")} alt="Ratul's Fiverr profile showing Level 2, 4.9 rating and 243 reviews" widths={[320, 480]} sizes="240px" loading="lazy" class="journey__img" />
          <span class="journey__label">Where I am now</span>
          <strong>Level Two · 4.9★</strong>
        </li>
      </ol>
    </div>
    <p class="about__link"><a class="text-link" href="/about">Read the full story</a></p>
  </div>
</section>

<style>
  .trusted {
    padding-block: 56px 24px;
    text-align: center;
  }
  .trusted h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .trusted p:not(.eyebrow) {
    max-width: 56ch;
    margin-inline: auto;
  }
  .logos {
    display: flex;
    overflow: hidden;
    margin-top: 28px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .logos__track {
    display: flex;
    flex-shrink: 0;
    gap: 16px;
    padding-right: 16px;
    animation: logos-x 36s linear infinite;
  }
  .logos:hover .logos__track {
    animation-play-state: paused;
  }
  @keyframes logos-x {
    to {
      transform: translateX(-100%);
    }
  }
  .logos__track li {
    display: grid;
    place-items: center;
    height: 84px;
    padding: 0 22px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .logos__img {
    height: 48px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: saturate(0.9);
    transition: transform 0.4s var(--ease);
  }
  .logos__track li:hover .logos__img {
    transform: scale(1.06);
  }
  .about {
    max-width: 980px;
  }
  .about__head {
    text-align: center;
  }
  .statement {
    margin: 24px 0 56px;
    font-size: clamp(1.4rem, 2.9vw, 2.15rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--ink);
    text-align: center;
  }
  :global(.statement.is-live) :global(.hl-word) {
    color: #c4ccc9;
    transition: color 0.35s;
  }
  :global(.statement.is-live) :global(.hl-word.on) {
    color: var(--ink);
  }
  .about__foot {
    display: grid;
    gap: 18px;
    align-items: stretch;
  }
  @media (min-width: 900px) {
    .about__foot {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0;
  }
  .facts > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 4px;
    padding: 20px;
  }
  .facts dd {
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .facts dt {
    font-size: 0.8rem;
  }
  .journey {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .journey__step {
    flex: 1;
    display: grid;
    gap: 2px;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px dashed var(--line-2);
    background: rgb(255 255 255 / 50%);
  }
  .journey__img {
    width: 100%;
    height: 84px;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 10px;
    margin-bottom: 8px;
  }
  .journey__step strong {
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .journey__step--now {
    border: 0;
    background: var(--ink);
    box-shadow: 0 20px 40px -20px rgb(14 13 26 / 60%);
  }
  .journey__step--now strong {
    color: #fff;
  }
  .journey__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .journey__step--now .journey__label {
    color: var(--accent-2);
  }
  .journey__line {
    width: 36px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 4px, transparent 4px 8px);
    flex-shrink: 0;
  }
  .about__link {
    text-align: center;
    margin: 28px 0 0;
  }
</style>
