---
import { faqs } from "../../data/home";
import { site } from "../../data/site";
const answered = faqs.filter((f) => f.a.trim());
---

<section class="section wash" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Frequently Asked Questions</p>
      <h2 id="faq-title">Everything You Need to Know About <span class="em">Local SEO &amp; Google Maps Ranking</span></h2>
    </div>

    <div class="faq__list">
      {
        answered.map((f, i) => (
          <details class="faq__item card" open={i === 0} data-reveal style={`--d:${i}`}>
            <summary>
              <h3>{f.q}</h3>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>

    <div class="faq__cta card" data-reveal>
      <div>
        <h3>Still Have Questions?</h3>
        <p><strong>Book a free Local SEO audit or strategy call.</strong></p>
        <p>
          Get a personalized review of your Google Maps visibility, Local SEO performance, and
          inbound call opportunities.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--dark" href="/book-strategy-call"><span class="disc" aria-hidden="true">↗</span>Get Free Local SEO Audit</a>
        <a class="btn btn--ghost" href={site.whatsapp} rel="noopener" target="_blank">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 860px;
  }
  .faq__list {
    display: grid;
    gap: 12px;
  }
  .faq__item {
    padding: 0 24px;
  }
  .faq__item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--bg);
    transition:
      background 0.3s,
      transform 0.4s var(--ease);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.8px;
    border-radius: 2px;
    background: var(--ink);
    transform: translate(-50%, -50%);
  }
  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq__item[open] .faq__icon {
    background: var(--accent);
    transform: rotate(45deg);
  }
  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: #fff;
  }
  .faq__a p {
    margin: 0;
    padding-bottom: 22px;
    max-width: 64ch;
  }
  .faq__item[open] .faq__a {
    animation: faq-open 0.4s var(--ease);
  }
  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .faq__cta {
    margin-top: 32px;
    display: grid;
    gap: 20px;
    align-items: center;
    padding: clamp(24px, 4vw, 36px);
    background:
      radial-gradient(80% 140% at 100% 0%, rgb(255 122 102 / 16%), transparent 60%),
      var(--paper);
  }
  .faq__cta h3 {
    font-size: 1.35rem;
  }
  .faq__cta p:last-child {
    margin: 0;
  }
  @media (min-width: 900px) {
    .faq__cta {
      grid-template-columns: 1.2fr auto;
    }
    .faq__cta .btn-row {
      flex-direction: column;
    }
  }
</style>
