---
import { Image } from "astro:assets";
import { whyPoints } from "../../data/home";
import { img } from "../../lib/img";
---

<section class="section" aria-labelledby="why-title">
  <div class="container why">
    <div class="why__copy" data-reveal>
      <p class="eyebrow">Why work with me</p>
      <h2 id="why-title">Why local businesses <span class="em">hire me.</span></h2>
      <p class="lead">
        I started doing SEO at 16 (<a href="/blog/youngest-seo-expert-bangladesh-story">the story
        is here</a>) and have spent 5+ years ranking local businesses on Google Maps. One client's
        Business Profile brought in <strong>461 calls in five months</strong>. Every report shows
        the screenshots behind the numbers.
      </p>
      <div class="why__cta">
        <a class="btn btn--dark" href="/book-strategy-call"><span class="disc" aria-hidden="true">↗</span>Book Free Strategy Call</a>
        <span class="why__rating">
          <span class="stars" aria-hidden="true">↑</span>
          <span><strong class="num">461</strong> calls from one Google profile</span>
        </span>
      </div>
      <p class="note">Trusted by service businesses across Bangladesh &amp; beyond</p>
    </div>

    <div class="why__side">
      <figure class="whyphoto" data-reveal>
        <Image src={img("people/ratul-why-choose.jpg")} alt="Ratul Roy at his desk with a laptop" widths={[360, 540, 720]} sizes="(min-width: 1024px) 420px, 90vw" loading="lazy" class="whyphoto__img" />
        <figcaption class="age">
          <span class="age__num num" data-count>16</span>
          <span>the age I started doing SEO</span>
        </figcaption>
      </figure>
      <ul class="why__list">
        {
          whyPoints.map((w, i) => (
            <li class="card card--hover" data-reveal style={`--d:${i + 1}`} data-spot>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>

  .why {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .why {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 72px;
    }
  }
  .why__copy {
    min-width: 0;
  }
  .why__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin: 28px 0 12px;
  }
  .why__rating {
    display: grid;
    font-size: 0.85rem;
  }
  .why__side {
    display: grid;
    gap: 14px;
  }
  .whyphoto {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3.4;
  }
  .whyphoto__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    transition: transform 0.8s var(--ease);
  }
  .whyphoto:hover .whyphoto__img {
    transform: scale(1.04);
  }
  .whyphoto .age {
    position: absolute;
    left: 14px;
    bottom: 14px;
    right: auto;
    padding: 10px 16px;
    border-radius: 16px;
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }
  .whyphoto .age__num {
    font-size: 2.6rem;
  }
  .age {
    display: flex;
    align-items: center;
    gap: 18px;
    background:
      radial-gradient(90% 140% at 0% 0%, rgb(255 122 102 / 22%), transparent 60%),
      var(--paper);
  }
  .age__num {
    font-size: 4rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--accent);
  }
  .age span:last-child {
    font-weight: 500;
    color: var(--ink-2);
  }
  .why__list {
    display: grid;
    gap: 14px;
  }
  .why__list .card {
    padding: 20px 22px;
  }
  .why__list h3 {
    font-size: 1.02rem;
    margin-bottom: 4px;
  }
  .why__list p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
