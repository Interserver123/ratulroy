---
import { Image } from "astro:assets";
import { strategy, systemTags, whyPoints } from "../../data/home";
import { img } from "../../lib/img";
---

<section class="section wash" aria-labelledby="strategy-title">
  <div class="container">
    <div class="strat-head" data-reveal>
      <div>
        <p class="eyebrow">Why My Strategy Is Different</p>
        <h2 id="strategy-title">
          Local SEO is no longer just about rankings. It is about becoming
          <span class="em">the trusted choice.</span>
        </h2>
      </div>
      <div>
        <ul class="chips" aria-label="Principles">
          <li class="chip">E-E-A-T</li>
          <li class="chip">White-Hat</li>
          <li class="chip">AI-Ready</li>
          <li class="chip">Local-First</li>
        </ul>
        <p>
          Most businesses still treat SEO like a checklist - keywords, backlinks, and random blog
          posts. I build Local SEO systems that help Google, AI platforms, and real customers
          understand who you are, what you do, where you serve, and why your business deserves trust.
        </p>
        <p>
          <strong>
            The goal is not vanity traffic. The goal is stronger visibility, better trust signals,
            and more qualified inbound calls.
          </strong>
        </p>
      </div>
    </div>

    <div class="route" data-route>
      <div class="route__line" aria-hidden="true"><span></span></div>
      <ol class="steps">
        {
          strategy.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__pin num" aria-hidden="true"><span>{String(i + 1).padStart(2, "0")}</span></span>
              <div class="card card--hover step__card" data-spot>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <ul class="checklist">
                  {s.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="system card" data-reveal>
      <div>
        <p class="tag">The System</p>
        <h3>Built for how local search works now.</h3>
        <p>
          Google Maps, organic search, and AI discovery are connected. Your business needs a clear
          entity, optimized profile, strong website, trusted citations, helpful content, and real
          authority signals. That is the system I build.
        </p>
        <ul class="chips">
          {systemTags.map((t) => <li class="chip chip--line">{t}</li>)}
        </ul>
      </div>
      <div class="btn-row system__btns">
        <a class="btn btn--dark" href="/#contact"><span class="disc" aria-hidden="true">↗</span>Get Free SEO Visibility Audit</a>
        <a class="btn btn--ghost" href="/#results">See Real Results</a>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="why-title">
  <div class="container why">
    <div class="why__copy" data-reveal>
      <p class="eyebrow">Why Choose Ratul Roy</p>
      <h2 id="why-title">Why Choose Ratul Roy <span class="em">The Youngest SEO Expert in Bangladesh.</span></h2>
      <p class="lead">
        With years of hands-on experience starting from the age of 16, I combine youth, creativity,
        and proven SEO expertise to help local service businesses dominate Google Maps, optimize
        their Google Business Profile, and increase qualified inbound calls. My data-driven and
        personalized approach ensures measurable growth for every client.
      </p>
      <div class="why__cta">
        <a class="btn btn--dark" href="/book-strategy-call"><span class="disc" aria-hidden="true">↗</span>Book Free Strategy Call</a>
        <span class="why__rating">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span><strong class="num">4.9</strong> · 243 reviews · Fiverr L2</span>
        </span>
      </div>
      <p class="note">Trusted by service businesses across Bangladesh &amp; beyond</p>
    </div>

    <div class="why__side">
      <figure class="whyphoto" data-reveal>
        <Image src={img("people/ratul-why-choose.jpg")} alt="Ratul Roy at his desk with a laptop" widths={[360, 540, 720]} sizes="(min-width: 1024px) 420px, 90vw" loading="lazy" class="whyphoto__img" />
        <figcaption class="age">
          <span class="age__num num" data-count>16</span>
          <span>the age I started doing SEO</span>
        </figcaption>
      </figure>
      <ul class="why__list">
        {
          whyPoints.map((w, i) => (
            <li class="card card--hover" data-reveal style={`--d:${i + 1}`} data-spot>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .strat-head {
    display: grid;
    gap: 28px;
    margin-bottom: 48px;
  }
  @media (min-width: 1024px) {
    .strat-head {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
      align-items: end;
    }
  }
  .strat-head .chips {
    margin-bottom: 18px;
  }
  /* Route timeline: a map route that draws itself as you scroll; steps sit beside it as stops */
  .route {
    position: relative;
  }
  .route__line {
    position: absolute;
    left: 21px;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 3px;
    background: repeating-linear-gradient(180deg, var(--line-2) 0 8px, transparent 8px 14px);
  }
  .route__line span {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--p, 1) * 100%);
    border-radius: 3px;
    background: linear-gradient(180deg, var(--accent-2), var(--accent));
  }
  .steps {
    display: grid;
    gap: 22px;
  }
  .step {
    position: relative;
    padding-left: 64px;
  }
  .step__pin {
    position: absolute;
    left: 0;
    top: 18px;
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    border-radius: 50% 50% 50% 6px;
    transform: rotate(-45deg);
    background: var(--ink);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 0 0 6px var(--bg);
    z-index: 1;
  }
  .step__pin > span {
    transform: rotate(45deg);
  }
  .step.is-in .step__pin {
    background: var(--accent);
    transition: background 0.5s 0.2s;
  }
  .step__card p {
    font-size: 0.92rem;
  }
  .step__card .checklist {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .step__card .checklist li {
    font-size: 0.85rem;
  }
  @media (min-width: 1024px) {
    .route__line {
      left: 50%;
      margin-left: -1.5px;
    }
    .steps {
      gap: 8px;
    }
    .step {
      width: 50%;
      padding: 0 56px 0 0;
    }
    .step:nth-child(even) {
      margin-left: 50%;
      padding: 0 0 0 56px;
    }
    .step__pin {
      left: auto;
      right: -22.5px;
    }
    .step:nth-child(even) .step__pin {
      right: auto;
      left: -22.5px;
    }
    .step:not(:first-child) {
      margin-top: -64px;
    }
  }

  .system {
    margin-top: 40px;
    display: grid;
    gap: 24px;
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
  }
  .system h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
  }
  .system p {
    max-width: 60ch;
  }
  @media (min-width: 1024px) {
    .system {
      grid-template-columns: 1.5fr auto;
    }
    .system__btns {
      flex-direction: column;
    }
  }

  .why {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .why {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 72px;
    }
  }
  .why__copy {
    min-width: 0;
  }
  .why__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin: 28px 0 12px;
  }
  .why__rating {
    display: grid;
    font-size: 0.85rem;
  }
  .why__side {
    display: grid;
    gap: 14px;
  }
  .whyphoto {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3.4;
  }
  .whyphoto__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    transition: transform 0.8s var(--ease);
  }
  .whyphoto:hover .whyphoto__img {
    transform: scale(1.04);
  }
  .whyphoto .age {
    position: absolute;
    left: 14px;
    bottom: 14px;
    right: auto;
    padding: 10px 16px;
    border-radius: 16px;
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }
  .whyphoto .age__num {
    font-size: 2.6rem;
  }
  .age {
    display: flex;
    align-items: center;
    gap: 18px;
    background:
      radial-gradient(90% 140% at 0% 0%, rgb(255 122 102 / 22%), transparent 60%),
      var(--paper);
  }
  .age__num {
    font-size: 4rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--accent);
  }
  .age span:last-child {
    font-weight: 500;
    color: var(--ink-2);
  }
  .why__list {
    display: grid;
    gap: 14px;
  }
  .why__list .card {
    padding: 20px 22px;
  }
  .why__list h3 {
    font-size: 1.02rem;
    margin-bottom: 4px;
  }
  .why__list p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
