---
import { strategy, systemTags, whyPoints } from "../../data/home";
---

<section class="section" aria-labelledby="strategy-title">
  <div class="container">
    <div class="strat-head">
      <div>
        <p class="eyebrow">Why My Strategy Is Different</p>
        <h2 id="strategy-title">
          Local SEO is no longer just about rankings. It is about becoming
          <span class="em">the trusted choice.</span>
        </h2>
      </div>
      <div>
        <ul class="chips" aria-label="Principles">
          <li class="chip">E-E-A-T</li>
          <li class="chip">White-Hat</li>
          <li class="chip">AI-Ready</li>
          <li class="chip">Local-First</li>
        </ul>
        <p>
          Most businesses still treat SEO like a checklist - keywords, backlinks, and random blog
          posts. I build Local SEO systems that help Google, AI platforms, and real customers
          understand who you are, what you do, where you serve, and why your business deserves trust.
        </p>
        <p>
          <strong>
            The goal is not vanity traffic. The goal is stronger visibility, better trust signals,
            and more qualified inbound calls.
          </strong>
        </p>
      </div>
    </div>

    <ol class="hairgrid hairgrid--3 steps">
      {
        strategy.map((s, i) => (
          <li>
            <span class="steps__num mono">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul class="checklist">
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="system panel--edge">
      <div>
        <p class="tag">The System</p>
        <h3>Built for how local search works now.</h3>
        <p>
          Google Maps, organic search, and AI discovery are connected. Your business needs a clear
          entity, optimized profile, strong website, trusted citations, helpful content, and real
          authority signals. That is the system I build.
        </p>
        <ul class="chips">
          {systemTags.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </div>
      <div class="btn-row system__btns">
        <a class="btn btn--primary" href="#contact">Get Free SEO Visibility Audit</a>
        <a class="btn btn--ghost" href="#results">See Real Results</a>
      </div>
    </div>
  </div>
</section>

<section class="section section--alt why" aria-labelledby="why-title">
  <div class="container why__grid">
    <div class="why__copy">
      <p class="eyebrow">Why Choose Ratul Roy</p>
      <h2 id="why-title">Why Choose Ratul Roy <span class="em">The Youngest SEO Expert in Bangladesh.</span></h2>
      <p class="lead">
        With years of hands-on experience starting from the age of 16, I combine youth, creativity,
        and proven SEO expertise to help local service businesses dominate Google Maps, optimize
        their Google Business Profile, and increase qualified inbound calls. My data-driven and
        personalized approach ensures measurable growth for every client.
      </p>
      <div class="why__cta">
        <a class="btn btn--primary" href="/book-strategy-call">Book Free Strategy Call <span class="arrow" aria-hidden="true">→</span></a>
        <div class="why__rating">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span><strong class="mono">4.9</strong> · 243 reviews · Fiverr L2</span>
        </div>
      </div>
      <p class="note">Trusted by service businesses across Bangladesh &amp; beyond</p>
    </div>
    <div class="why__side">
      <p class="why__age" aria-hidden="true"><span class="em">16</span></p>
      <ul class="why__list">
        {
          whyPoints.map((w) => (
            <li>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .strat-head {
    display: grid;
    gap: 32px;
    margin-bottom: 64px;
  }
  @media (min-width: 1024px) {
    .strat-head {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 72px;
      align-items: end;
    }
  }
  .strat-head .chips {
    margin-bottom: 20px;
  }
  .steps {
    padding: 0;
  }
  .steps > li {
    padding: 36px 28px;
  }
  .steps__num {
    display: block;
    font-size: 2.6rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
    background: linear-gradient(180deg, var(--text), rgb(255 255 255 / 15%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .steps p {
    font-size: 0.925rem;
  }
  .system {
    margin-top: 48px;
    display: grid;
    gap: 28px;
    align-items: center;
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 44px);
  }
  .system h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }
  .system p {
    max-width: 60ch;
  }
  @media (min-width: 1024px) {
    .system {
      grid-template-columns: 1.5fr auto;
    }
    .system__btns {
      flex-direction: column;
    }
  }

  .why__grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .why__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 80px;
    }
  }
  .why__copy {
    min-width: 0;
  }
  .why__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 32px 0 14px;
  }
  .why__rating {
    display: grid;
    font-size: 0.85rem;
  }
  .why__side {
    position: relative;
  }
  .why__age {
    position: absolute;
    right: -10px;
    top: -110px;
    margin: 0;
    font-size: clamp(8rem, 16vw, 13rem);
    line-height: 1;
    opacity: 0.22;
    pointer-events: none;
  }
  .why__list {
    position: relative;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .why__list li {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .why__list h3 {
    font-size: 1.1rem;
    margin-bottom: 6px;
  }
  .why__list p {
    margin: 0;
    font-size: 0.925rem;
  }
</style>
