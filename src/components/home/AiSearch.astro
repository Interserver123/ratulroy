---
import { platforms, aiPillars } from "../../data/home";

// Each tab is a place customers discover local businesses. The panel is an illustration
// of the goal: your business named in the answer.
const tabs = [
  { title: "Google Search", text: "Organic local results", kind: "search" },
  { title: "Google Maps", text: "Map Pack & directions", kind: "map" },
  ...platforms.map((p) => ({
    ...p,
    kind: /ChatGPT|Perplexity|Overviews|Gemini/.test(p.title) ? "ai" : "map",
  })),
];
---

<section class="section wash" aria-labelledby="ai-title">
  <div class="container">
    <div class="ai-head" data-reveal>
      <div>
        <p class="eyebrow">Beyond Google Maps</p>
        <h2 id="ai-title">
          Your next customer may not search Google. <span class="em">They may ask ChatGPT.</span>
        </h2>
      </div>
      <p>
        Local discovery is changing. Customers now use Google, Google Maps, AI Overviews, ChatGPT,
        Gemini, and Perplexity to compare businesses. Ratul Roy builds Local SEO systems that help
        your business become easier for both search engines and AI platforms to understand, trust,
        and recommend.
      </p>
    </div>

    <div class="where card" data-where data-reveal>
      <div class="where__tabs" role="tablist" aria-label="Where customers find local businesses">
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`where-tab-${i}`}
              aria-controls="where-panel"
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-title={t.title}
              data-text={t.text}
              data-kind={t.kind}
            >
              <strong>{t.title}</strong>
              <span>{t.text}</span>
            </button>
          ))
        }
      </div>

      <div id="where-panel" class="where__panel" role="tabpanel" aria-labelledby="where-tab-0" aria-live="polite">
        <div class="where__query">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <span>best local service near me</span>
          <em data-where-name>Google Search</em>
        </div>
        <div class="where__answer" data-where-answer>
          <p class="where__label" data-where-label>Organic local results</p>
          <div class="biz biz--you">
            <span class="biz__pin" aria-hidden="true">1</span>
            <span>
              <strong>Your business</strong>
              <small>Clear entity · consistent NAP · trusted reviews · structured data</small>
            </span>
            <span class="chip chip--green">Recommended</span>
          </div>
          <div class="biz"><span class="biz__pin" aria-hidden="true">2</span><span class="biz__line"></span></div>
          <div class="biz"><span class="biz__pin" aria-hidden="true">3</span><span class="biz__line"></span></div>
        </div>
        <p class="where__note">Illustration of the goal, not a live result.</p>
      </div>
    </div>

    <ul class="grid grid--4 pillars">
      {
        aiPillars.map((p, i) => (
          <li class="card card--hover" data-reveal style={`--d:${i}`} data-spot>
            <span class="pillars__n num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="ai__foot" data-reveal>
      <p>
        AI search visibility is not magic. It starts with a clear business entity, trusted local
        signals, structured content, and strong search authority.
      </p>
      <a class="btn btn--dark" href="#contact"><span class="disc" aria-hidden="true">↗</span>Build My AI-Ready Local SEO System</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-where]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]');
    const name = root.querySelector<HTMLElement>("[data-where-name]");
    const label = root.querySelector<HTMLElement>("[data-where-label]");
    const answer = root.querySelector<HTMLElement>("[data-where-answer]");
    let auto: number | undefined;

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      const t = tabs[i];
      if (name) name.textContent = t.dataset.title ?? "";
      if (label) label.textContent = t.dataset.text ?? "";
      if (panel) {
        panel.setAttribute("aria-labelledby", t.id);
        panel.dataset.kind = t.dataset.kind;
      }
      answer?.classList.remove("is-swap");
      void answer?.offsetWidth;
      answer?.classList.add("is-swap");
      if (focus) t.focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        window.clearInterval(auto);
        select(i);
      });
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        if (k !== "ArrowRight" && k !== "ArrowLeft" && k !== "ArrowDown" && k !== "ArrowUp") return;
        e.preventDefault();
        window.clearInterval(auto);
        const dir = k === "ArrowRight" || k === "ArrowDown" ? 1 : -1;
        select((i + dir + tabs.length) % tabs.length, true);
      });
    });

    // Gently cycle through platforms until the visitor interacts.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let i = 0;
      auto = window.setInterval(() => {
        i = (i + 1) % tabs.length;
        select(i);
      }, 2600);
      root.addEventListener("pointerenter", () => window.clearInterval(auto), { once: true });
    }
  });
</script>

<style>
  .ai-head {
    display: grid;
    gap: 24px;
    margin-bottom: 40px;
  }
  .ai-head > p {
    margin: 0;
    font-size: 1.05rem;
  }
  @media (min-width: 1024px) {
    .ai-head {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
      align-items: end;
    }
  }

  .where {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 900px) {
    .where {
      grid-template-columns: 300px 1fr;
    }
  }
  .where__tabs {
    display: flex;
    gap: 6px;
    padding: 14px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .where__tabs::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 900px) {
    .where__tabs {
      flex-direction: column;
      overflow: visible;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
  }
  .where__tabs button {
    flex-shrink: 0;
    display: grid;
    gap: 1px;
    text-align: left;
    font: inherit;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition:
      background 0.25s,
      border-color 0.25s;
  }
  .where__tabs button strong {
    font-size: 0.9rem;
  }
  .where__tabs button span {
    font-size: 0.75rem;
    color: var(--dim);
  }
  .where__tabs button:hover {
    background: rgb(255 255 255 / 70%);
  }
  .where__tabs button[aria-selected="true"] {
    background: #fff;
    border-color: var(--line);
    box-shadow: var(--shadow);
  }
  .where__tabs button[aria-selected="true"] strong {
    color: var(--accent);
  }

  .where__panel {
    padding: clamp(20px, 3.5vw, 40px);
    display: grid;
    align-content: center;
    gap: 18px;
    min-width: 0;
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(15 157 99 / 10%), transparent 60%),
      #fff;
  }
  .where__query {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--ink);
    font-weight: 500;
  }
  .where__query svg {
    color: var(--accent);
  }
  .where__query em {
    margin-left: auto;
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
  }
  .where__label {
    margin: 0 0 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .where__answer {
    display: grid;
    gap: 8px;
  }
  .where__answer:global(.is-swap) {
    animation: swap 0.5s var(--ease);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .biz {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .biz--you {
    border-color: rgb(15 157 99 / 40%);
    background: var(--good-soft);
  }
  .biz--you > span:nth-child(2) {
    flex: 1;
    display: grid;
  }
  .biz small {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .biz__pin {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #c9d3d0;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .biz--you .biz__pin {
    background: var(--good);
  }
  .biz__line {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: var(--bg-2);
  }
  /* AI answers read as a sentence-style card rather than a list */
  .where__panel[data-kind="ai"] .biz:not(.biz--you) {
    display: none;
  }
  .where__panel[data-kind="ai"] .biz--you::before {
    content: "AI";
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 7px;
    border-radius: 8px;
    background: var(--ink);
    color: #fff;
  }
  .where__panel[data-kind="ai"] .biz--you .biz__pin {
    display: none;
  }
  .where__note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--dim);
  }

  .pillars {
    margin-top: 18px;
  }
  .pillars .card {
    padding: 22px;
  }
  .pillars__n {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .pillars h3 {
    font-size: 1rem;
  }
  .pillars p {
    margin: 0;
    font-size: 0.875rem;
  }
  .ai__foot {
    margin-top: 40px;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }
  .ai__foot p {
    max-width: 620px;
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }
</style>
