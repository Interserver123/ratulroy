---
import { platforms, aiPillars } from "../../data/home";
---

<section class="section" aria-labelledby="ai-title">
  <div class="container">
    <div class="ai">
      <div>
        <p class="eyebrow">Beyond Google Maps</p>
        <h2 id="ai-title">
          Your next customer may not search Google. <span class="hl">They may ask ChatGPT.</span>
        </h2>
        <p class="lead">
          Local discovery is changing. Customers now use Google, Google Maps, AI Overviews, ChatGPT,
          Gemini, and Perplexity to compare businesses. Ratul Roy builds Local SEO systems that help
          your business become easier for both search engines and AI platforms to understand, trust,
          and recommend.
        </p>
        <a class="btn btn--primary" href="#contact">Build My AI-Ready Local SEO System</a>
      </div>
      <ul class="platforms">
        {
          platforms.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="grid grid--4 pillars">
      {
        aiPillars.map((p) => (
          <li class="card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="ai__note">
      AI search visibility is not magic. It starts with a clear business entity, trusted local
      signals, structured content, and strong search authority.
    </p>
  </div>
</section>

<style>
  .ai {
    display: grid;
    gap: 40px;
    align-items: center;
    margin-bottom: 48px;
  }
  @media (min-width: 1024px) {
    .ai {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .hl {
    color: var(--brand);
  }
  .ai .lead {
    margin-bottom: 28px;
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .platforms li {
    display: grid;
    padding: 16px;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }
  .platforms strong {
    color: var(--ink);
  }
  .platforms span {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pillars .card p {
    margin: 0;
    font-size: 0.95rem;
  }
  .ai__note {
    margin: 40px auto 0;
    max-width: 720px;
    text-align: center;
    font-weight: 600;
    color: var(--ink);
  }
</style>
