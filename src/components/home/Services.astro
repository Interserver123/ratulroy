---
import { services } from "../../data/home";
const [featured, ...rest] = services;
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Search Visibility Services</p>
      <h2 id="services-title">
        Services that help you win in Google Maps, organic search, and <span class="em">AI answers</span>
      </h2>
      <p>
        I do not offer generic SEO packages. I build focused search visibility systems designed to
        help local businesses rank higher, look more trusted, and get discovered across Google Maps,
        organic search, AI Overviews, ChatGPT, Gemini, and Perplexity.
      </p>
    </div>

    <article class="feature panel--edge">
      <div class="feature__copy">
        <p class="feature__flags">
          <span class="flag">Most Requested</span>
          <span class="tag">{featured.badge}</span>
        </p>
        <h3>{featured.title}</h3>
        <p>{featured.text}</p>
        <a class="btn btn--primary" href="#contact">{featured.cta} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="checklist feature__list">
        {featured.points.map((p) => <li>{p}</li>)}
      </ul>
    </article>

    <ul class="hairgrid hairgrid--3 services">
      {
        rest.map((s) => (
          <li>
            <span class="tag">{s.badge}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul class="checklist">
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <a class="text-link" href="#contact">
              {s.cta}
            </a>
          </li>
        ))
      }
      <li class="start">
        <span class="tag">Start Here</span>
        <h3>Not sure which SEO service you need first?</h3>
        <p>
          Start with a visibility audit. I will review your Google Business Profile, website SEO,
          competitors, content gaps, technical issues, citations, and AI search readiness so you
          know exactly what is holding your rankings back.
        </p>
        <div class="btn-row">
          <a class="btn btn--light" href="#contact">Get Free SEO Visibility Audit</a>
          <a class="btn btn--ghost" href="#results">See Results</a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .feature {
    display: grid;
    gap: 32px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius);
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }
  .feature::after {
    content: "";
    position: absolute;
    right: -120px;
    top: -120px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 61 74 / 22%), transparent 70%);
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .feature {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
    }
  }
  .feature__copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .feature__flags {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  .feature__flags .tag {
    margin: 0;
  }
  .flag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
  }
  .feature h3 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    letter-spacing: -0.035em;
  }
  .feature p {
    max-width: 55ch;
    margin-bottom: 28px;
  }
  .feature__list {
    position: relative;
    z-index: 1;
    padding: 24px;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 30%);
    border: 1px solid var(--line);
  }
  .feature__list li {
    font-size: 1rem;
    color: var(--text);
  }

  .services > li {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    transition: background 0.25s;
  }
  .services > li:hover {
    background: rgb(255 255 255 / 2%);
  }
  .services h3 {
    font-size: 1.15rem;
  }
  .services p {
    font-size: 0.925rem;
  }
  .services .checklist {
    margin-bottom: 24px;
  }
  .services .text-link {
    margin-top: auto;
  }
  .start {
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 61 74 / 18%), transparent 60%),
      var(--surface);
  }
  @media (min-width: 1024px) {
    .start {
      grid-column: span 2;
    }
  }
  .start p {
    max-width: 60ch;
  }
  .start .btn-row {
    margin-top: auto;
  }
  .start .btn {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 0.875rem;
  }
</style>
