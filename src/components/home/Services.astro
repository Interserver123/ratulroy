---
import { services } from "../../data/home";

const icons = [
  '<path d="M12 21s-6-5.6-6-11a6 6 0 1 1 12 0c0 5.4-6 11-6 11z"/><circle cx="12" cy="10" r="2.3"/>',
  '<path d="M4 9l1.5-4h13L20 9M4 9v10h16V9M4 9h16"/><path d="M9 19v-5h6v5"/>',
  '<rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
];
---

<section id="services" class="section wash" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Search Visibility Services</p>
      <h2 id="services-title">
        Services that help you win in Google Maps, organic search, and <span class="em">AI answers.</span>
      </h2>
      <p>
        I do not offer generic SEO packages. I build focused search visibility systems designed to
        help local businesses rank higher, look more trusted, and get discovered across Google Maps,
        organic search, AI Overviews, ChatGPT, Gemini, and Perplexity.
      </p>
    </div>

    <ul class="grid grid--4 services">
      {
        services.map((s, i) => (
          <li class={`card card--hover service${s.featured ? " service--featured" : ""}`} data-reveal style={`--d:${i % 4}`} data-spot>
            {s.featured && <span class="service__flag">Most Requested</span>}
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
            </span>
            <span class="tag">{s.badge}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul class="checklist">
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <a class="text-link" href="#contact">
              {s.cta}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="start" data-reveal>
      <div>
        <p class="start__tag">Start Here</p>
        <h3>Not sure which SEO service you need first?</h3>
        <p>
          Start with a visibility audit. I will review your Google Business Profile, website SEO,
          competitors, content gaps, technical issues, citations, and AI search readiness so you
          know exactly what is holding your rankings back.
        </p>
      </div>
      <div class="btn-row start__btns">
        <a class="btn btn--light" href="#contact">Get Free SEO Visibility Audit</a>
        <a class="btn btn--outline" href="#results">See Results</a>
      </div>
    </div>
  </div>
</section>

<style>
  .service {
    display: flex;
    flex-direction: column;
    padding: 24px;
  }
  .service .tag {
    margin-bottom: 6px;
  }
  .service h3 {
    font-size: 1.05rem;
  }
  .service p {
    font-size: 0.9rem;
  }
  .service .checklist {
    margin-bottom: 20px;
  }
  .service .checklist li {
    font-size: 0.85rem;
  }
  .service .text-link {
    margin-top: auto;
  }
  .service--featured {
    border: 1.5px solid var(--accent);
    box-shadow:
      0 0 0 4px rgb(255 77 61 / 8%),
      var(--shadow-lg);
  }
  .service__flag {
    position: absolute;
    top: -12px;
    right: 18px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .start {
    position: relative;
    overflow: hidden;
    margin-top: 28px;
    display: grid;
    gap: 24px;
    align-items: center;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius);
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(255 122 102 / 45%), transparent 60%),
      var(--ink);
    color: #c7c3dd;
  }
  .start h3 {
    color: #fff;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .start p {
    max-width: 62ch;
    margin: 0;
  }
  .start__tag {
    margin: 0 0 10px !important;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .btn--light {
    background: #fff;
    color: var(--ink);
  }
  .btn--light:hover {
    color: var(--ink);
  }
  .btn--outline {
    color: #fff;
    border-color: rgb(255 255 255 / 30%);
  }
  .btn--outline:hover {
    color: #fff;
    border-color: #fff;
  }
  @media (min-width: 1024px) {
    .start {
      grid-template-columns: 1.5fr auto;
    }
    .start__btns {
      flex-direction: column;
    }
  }
</style>
