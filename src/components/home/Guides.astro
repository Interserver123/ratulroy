---
import { guides } from "../../data/home";
---

<section class="section" aria-labelledby="guides-title">
  <div class="container">
    <div class="guides-head" data-reveal>
      <div>
        <p class="eyebrow">Local SEO Guides</p>
        <h2 id="guides-title">Local SEO guides for <span class="em">Bangladesh businesses.</span></h2>
        <p>
          An 8-part series on Local SEO in Bangladesh: what it is, how it works, what it costs and
          how long it takes. Start with the complete guide, then read the parts you need.
        </p>
      </div>
      <a class="btn btn--ghost" href="/blog">All Local SEO resources · Browse the blog <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <ul class="grid grid--4 guides">
      {
        guides.map((g, i) => (
          <li class="card card--hover guide" data-reveal style={`--d:${i % 4}`} data-spot>
            <p class="guide__meta">
              <span class="chip">Local SEO</span>
              <span>{g.minutes} min read</span>
            </p>
            <h3>
              <a href={g.href}>{g.title}</a>
            </h3>
            <p>{g.text}</p>
            <span class="text-link">Read guide</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .guides-head {
    display: grid;
    gap: 24px;
    margin-bottom: 40px;
  }
  .guides-head p:not(.eyebrow) {
    max-width: 60ch;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .guides-head {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 48px;
    }
  }
  .guide {
    display: flex;
    flex-direction: column;
    padding: 22px;
  }
  .guide__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--dim);
    margin-bottom: 18px;
  }
  .guide h3 {
    font-size: 1.02rem;
  }
  .guide h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .guide p {
    font-size: 0.875rem;
  }
  .guide .text-link {
    margin-top: auto;
  }
</style>
