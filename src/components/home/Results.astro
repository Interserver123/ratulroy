---
import { aggregates, results, auditPoints, auditTags } from "../../data/home";
---

<section id="results" class="section wash" aria-labelledby="results-title">
  <div class="container">
    <div class="res-head" data-reveal>
      <div>
        <p class="eyebrow">Verified SEO Results · Client-Approved Previews</p>
        <h2 id="results-title">Real Ranking Screenshots. <span class="em">Real Search Visibility Growth.</span></h2>
        <p>
          Selected website SEO and Google Business Profile ranking results pulled directly from
          Google Search Console, GBP Insights and geo-grid trackers. Brand details are masked to
          protect client confidentiality, the data is real.
        </p>
        <ul class="chips">
          <li class="chip">Verified GSC &amp; GBP data</li>
          <li class="chip chip--green">NDA-safe previews</li>
          <li class="chip chip--line">Client identities protected</li>
        </ul>
      </div>
    </div>

    <dl class="aggregates">
      {
        aggregates.map((a, i) => (
          <div class="card" data-reveal style={`--d:${i}`}>
            <dt>
              <span>Aggregate</span>
              {a.label}
            </dt>
            <dd class="num" data-count={a.value.startsWith("Top") ? undefined : ""}>{a.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="res-bar" data-reveal>
      <h3 class="res-tab">Website Ranking <span class="num">{results.length}</span></h3>
      <div class="res-nav">
        <button type="button" class="res-btn" data-dir="-1" aria-label="Previous results" aria-controls="res-track">←</button>
        <button type="button" class="res-btn" data-dir="1" aria-label="Next results" aria-controls="res-track">→</button>
      </div>
    </div>

    <ul id="res-track" class="res-track" data-reveal>
      {
        results.map((r) => (
          <li class="card result">
            {r.image && (
              <img
                src={r.image}
                alt={`${r.title}: ${r.metric} (Google Search Console)`}
                loading="lazy"
                decoding="async"
                width="640"
                height="360"
              />
            )}
            <div class="result__top">
              <span class="chip">{r.period}</span>
              <span class="result__src">Source: Google Search Console</span>
            </div>
            <h4>{r.title}</h4>
            <p class="result__metric">{r.metric}</p>
            <p>{r.text}</p>
            <ul class="chips">
              {r.tags.map((t) => (
                <li class="chip chip--line">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="res-disclaimer">
      All screenshots are exported from authenticated Google Search Console and Google Business
      Profile dashboards. Brand names, URLs and account identifiers are intentionally blurred under
      client NDA. Full unblurred reports are shared privately on request.
    </p>

    <figure class="quote card" data-reveal>
      <span class="stars" aria-hidden="true">★★★★★</span>
      <blockquote>
        <p>
          “Ratul rebuilt our entire local SEO foundation, GBP, citations, on-page, and Maps signals.
          Within months we moved from <span class="em">page two to the top of the map pack</span>
          and our phone stopped going quiet.”
        </p>
      </blockquote>
      <figcaption>
        <span class="quote__avatar" aria-hidden="true">SB</span>
        <span><strong>Verified Client</strong><br />Service business owner · Identity protected under NDA</span>
      </figcaption>
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="audit2-title">
  <div class="container audit2">
    <div class="audit2__copy" data-reveal>
      <p class="eyebrow">Free Visibility Audit · No Obligation</p>
      <h2 id="audit2-title">Want to See What Is <span class="em">Blocking Your Rankings?</span></h2>
      <p class="lead">
        Start with a visibility audit. I’ll review your website ranking signals, Google Business
        Profile performance, Google Maps visibility, competitors, citations, reviews, and local
        search gaps, so you know exactly what to improve next.
      </p>
      <ul class="checklist audit2__points">
        {auditPoints.map((p) => <li>{p}</li>)}
      </ul>
      <ul class="chips">
        {auditTags.map((t) => <li class="chip chip--line">{t}</li>)}
      </ul>
    </div>
    <div class="ticket card" data-reveal style="--d:2">
      <p class="ticket__label">Choose your audit</p>
      <p class="ticket__price">Free</p>
      <div class="ticket__btns">
        <a class="btn btn--dark" href="#contact">Get Free SEO Audit</a>
        <a class="btn btn--ghost" href="#contact">Request GBP Audit</a>
      </div>
      <dl class="ticket__stats">
        <div><dt>Turnaround</dt><dd>48h</dd></div>
        <div><dt>Expert review</dt><dd>1:1</dd></div>
        <div><dt>Confidential</dt><dd>100%</dd></div>
      </dl>
      <p class="note">Private. Never shared. No sales pitch.</p>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("res-track");
  document.querySelectorAll<HTMLButtonElement>(".res-btn").forEach((b) =>
    b.addEventListener("click", () => {
      const card = track?.querySelector("li");
      const step = (card?.getBoundingClientRect().width ?? 320) + 18;
      track?.scrollBy({ left: step * Number(b.dataset.dir), behavior: "smooth" });
    }),
  );
</script>

<style>
  .res-head {
    margin-bottom: 40px;
    max-width: 780px;
  }
  .res-head p:not(.eyebrow) {
    max-width: 62ch;
  }
  .aggregates {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 0 0 56px;
  }
  @media (min-width: 1024px) {
    .aggregates {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .aggregates > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 22px;
    min-width: 0;
  }
  .aggregates dd {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .aggregates > div:nth-child(3) dd {
    color: var(--good);
  }
  .aggregates > div:first-child dd {
    color: var(--accent);
  }
  .aggregates dt {
    display: grid;
    font-size: 0.85rem;
  }
  .aggregates dt span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .res-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }
  .res-tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 6px 6px 6px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
  }
  .res-tab span {
    font-size: 0.75rem;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent-2);
  }
  .res-nav {
    display: flex;
    gap: 8px;
  }
  .res-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: #fff;
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.3s var(--ease);
  }
  .res-btn:hover {
    background: var(--ink);
    color: #fff;
    transform: scale(1.05);
  }
  .res-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86%, 360px);
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 6px 4px 26px;
    margin-inline: -4px;
  }
  .res-track::-webkit-scrollbar {
    display: none;
  }
  .result {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 22px;
    min-width: 0;
  }
  .result img {
    border-radius: 12px;
    margin-bottom: 14px;
  }
  .result__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .result__src {
    font-size: 0.7rem;
    color: var(--dim);
    text-align: right;
  }
  .result h4 {
    font-size: 1.08rem;
  }
  .result__metric {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .result p {
    font-size: 0.875rem;
  }
  .result .chips {
    margin-top: auto;
  }
  .res-disclaimer {
    font-size: 0.82rem;
    color: var(--dim);
    max-width: 860px;
  }

  .quote {
    margin: 64px auto 0;
    max-width: 860px;
    text-align: center;
    padding: clamp(28px, 5vw, 52px);
    box-shadow: var(--shadow-lg);
  }
  .quote blockquote {
    margin: 14px 0 22px;
  }
  .quote p {
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.8rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
  }
  .quote figcaption {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    text-align: left;
    font-size: 0.85rem;
  }
  .quote__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
  }

  .audit2 {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .audit2 {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 72px;
    }
  }
  .audit2__copy {
    min-width: 0;
  }
  .audit2__points {
    margin: 22px 0;
  }
  .ticket {
    padding: 32px 28px;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .ticket__label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .ticket__price {
    font-size: 4.5rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--accent);
    margin: 6px 0 22px;
  }
  .ticket__btns {
    display: grid;
    gap: 10px;
  }
  .ticket__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 24px 0 14px;
    padding-top: 18px;
    border-top: 1px dashed var(--line-2);
  }
  .ticket__stats > div {
    display: flex;
    flex-direction: column-reverse;
  }
  .ticket__stats dd {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
  }
  .ticket__stats dt {
    font-size: 0.75rem;
  }
  .ticket .note {
    margin: 0;
  }
</style>
