---
import { Image, getImage } from "astro:assets";
import { aggregates, results, gbpResults, homeResults, auditPoints, auditTags } from "../../data/home";
import type { Result } from "../../data/home";
import { img } from "../../lib/img";

const prep = async (list: Result[]) =>
  Promise.all(
    list.map(async (r) => {
      const thumb = r.image ? img(r.image) : undefined;
      const full = thumb ? (await getImage({ src: thumb, width: Math.min(1600, thumb.width), format: "webp" })).src : undefined;
      return { ...r, thumb, full, alt: `${r.title}: ${r.metric} (${r.source ?? "Google Search Console"} screenshot)` };
    }),
  );
const groups = [
  { key: "web", label: "Website Ranking", items: await prep(results) },
  { key: "gbp", label: "GBP Ranking", items: await prep(gbpResults) },
  { key: "home", label: "Home Services", items: await prep(homeResults) },
];
---

<section id="results" class="section wash" aria-labelledby="results-title">
  <div class="container">
    <div class="res-head" data-reveal>
      <div>
        <p class="eyebrow">Verified SEO Results · Client-Approved Previews</p>
        <h2 id="results-title">Real Ranking Screenshots. <span class="em">Real Search Visibility Growth.</span></h2>
        <p>
          Selected website SEO and Google Business Profile ranking results pulled directly from
          Google Search Console, GBP Insights and geo-grid trackers. Brand details are masked to
          protect client confidentiality, the data is real.
        </p>
        <ul class="chips">
          <li class="chip">Verified GSC &amp; GBP data</li>
          <li class="chip chip--green">NDA-safe previews</li>
          <li class="chip chip--line">Client identities protected</li>
        </ul>
      </div>
    </div>

    <dl class="aggregates">
      {
        aggregates.map((a, i) => (
          <div class="card" data-reveal style={`--d:${i}`}>
            <dt>
              <span>Aggregate</span>
              {a.label}
            </dt>
            <dd class="num" data-count={a.value.startsWith("Top") ? undefined : ""}>{a.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="res-bar" data-reveal>
      <div class="res-tabs" role="tablist" aria-label="Result type">
        {
          groups.map((g, i) => (
            <button
              type="button"
              role="tab"
              id={`rtab-${g.key}`}
              aria-controls={`rpanel-${g.key}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="res-tab"
              data-rtab={g.key}
            >
              {g.label} <span class="num">{g.items.length}</span>
            </button>
          ))
        }
      </div>
      <div class="res-nav">
        <button type="button" class="res-btn" data-dir="-1" aria-label="Previous results">←</button>
        <button type="button" class="res-btn" data-dir="1" aria-label="Next results">→</button>
      </div>
    </div>

    {
      groups.map((g, gi) => (
        <ul
          id={`rpanel-${g.key}`}
          class="res-track"
          role="tabpanel"
          aria-labelledby={`rtab-${g.key}`}
          hidden={gi !== 0}
          data-rpanel={g.key}
        >
          {g.items.map((r) => (
            <li class="card result">
              {r.thumb && (
                <button type="button" class="result__shot" data-full={r.full} data-alt={r.alt} aria-label={`Enlarge screenshot: ${r.title}`}>
                  <Image src={r.thumb} alt={r.alt} widths={[400, 640]} sizes="(min-width: 640px) 360px, 86vw" loading="lazy" class="result__img" />
                  <span class="result__zoom" aria-hidden="true">⤢</span>
                </button>
              )}
              <div class="result__top">
                <span class="chip">{r.period}</span>
                <span class="result__src">Source: {r.source ?? "Google Search Console"}</span>
              </div>
              <h4>{r.title}</h4>
              <p class="result__metric">{r.metric}</p>
              <p>{r.text}</p>
              <ul class="chips">
                {r.tags.map((t) => (
                  <li class="chip chip--line">{t}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      ))
    }

    <dialog class="lightbox" data-lightbox aria-label="Screenshot">
      <form method="dialog"><button class="lightbox__close" aria-label="Close">×</button></form>
      <img alt="" data-lightbox-img />
    </dialog>
    <p class="res-disclaimer">
      All screenshots are exported from authenticated Google Search Console and Google Business
      Profile dashboards. Brand names, URLs and account identifiers are intentionally blurred under
      client NDA. Full unblurred reports are shared privately on request.
    </p>

    <figure class="quote card" data-reveal>
      <span class="stars" aria-hidden="true">★★★★★</span>
      <blockquote>
        <p>
          “Ratul rebuilt our entire local SEO foundation, GBP, citations, on-page, and Maps signals.
          Within months we moved from <span class="em">page two to the top of the map pack</span>
          and our phone stopped going quiet.”
        </p>
      </blockquote>
      <figcaption>
        <span class="quote__avatar" aria-hidden="true">SB</span>
        <span><strong>Verified Client</strong><br />Service business owner · Identity protected under NDA</span>
      </figcaption>
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="audit2-title">
  <div class="container audit2">
    <div class="audit2__copy" data-reveal>
      <p class="eyebrow">Free Visibility Audit · No Obligation</p>
      <h2 id="audit2-title">Want to See What Is <span class="em">Blocking Your Rankings?</span></h2>
      <p class="lead">
        Start with a visibility audit. I’ll review your website ranking signals, Google Business
        Profile performance, Google Maps visibility, competitors, citations, reviews, and local
        search gaps, so you know exactly what to improve next.
      </p>
      <ul class="checklist audit2__points">
        {auditPoints.map((p) => <li>{p}</li>)}
      </ul>
      <ul class="chips">
        {auditTags.map((t) => <li class="chip chip--line">{t}</li>)}
      </ul>
    </div>
    <div class="ticket card" data-reveal style="--d:2">
      <p class="ticket__label">Choose your audit</p>
      <p class="ticket__price">Free</p>
      <div class="ticket__btns">
        <a class="btn btn--dark" href="#contact">Get Free SEO Audit</a>
        <a class="btn btn--ghost" href="#contact">Request GBP Audit</a>
      </div>
      <dl class="ticket__stats">
        <div><dt>Turnaround</dt><dd>48h</dd></div>
        <div><dt>Expert review</dt><dd>1:1</dd></div>
        <div><dt>Confidential</dt><dd>100%</dd></div>
      </dl>
      <p class="note">Private. Never shared. No sales pitch.</p>
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-rtab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-rpanel]")];
  const current = () => panels.find((p) => !p.hidden);
  const select = (i: number, focus = false) => {
    tabs.forEach((t, k) => {
      t.setAttribute("aria-selected", String(k === i));
      t.tabIndex = k === i ? 0 : -1;
    });
    panels.forEach((p, k) => {
      p.hidden = k !== i;
      if (k === i) {
        p.scrollLeft = 0;
        p.animate([{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }], {
          duration: 400,
          easing: "cubic-bezier(.22,1,.36,1)",
        });
      }
    });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(i));
    t.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      select((i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length, true);
    });
  });
  document.querySelectorAll<HTMLButtonElement>(".res-btn").forEach((b) =>
    b.addEventListener("click", () => {
      const track = current();
      const card = track?.querySelector("li");
      const step = (card?.getBoundingClientRect().width ?? 320) + 18;
      track?.scrollBy({ left: step * Number(b.dataset.dir), behavior: "smooth" });
    }),
  );

  // Lightbox for screenshots
  const box = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const boxImg = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
  document.querySelectorAll<HTMLButtonElement>(".result__shot").forEach((b) =>
    b.addEventListener("click", () => {
      if (!box || !boxImg) return;
      boxImg.src = b.dataset.full ?? "";
      boxImg.alt = b.dataset.alt ?? "";
      box.showModal();
    }),
  );
  box?.addEventListener("click", (e) => {
    if (e.target === box) box.close();
  });
</script>

<style>
  .res-head {
    margin-bottom: 40px;
    max-width: 780px;
  }
  .res-head p:not(.eyebrow) {
    max-width: 62ch;
  }
  .aggregates {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 0 0 56px;
  }
  @media (min-width: 1024px) {
    .aggregates {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .aggregates > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 22px;
    min-width: 0;
  }
  .aggregates dd {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .aggregates > div:nth-child(3) dd {
    color: var(--good);
  }
  .aggregates > div:first-child dd {
    color: var(--accent);
  }
  .aggregates dt {
    display: grid;
    font-size: 0.85rem;
  }
  .aggregates dt span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .res-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }
  .res-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .res-tab {
    font: inherit;
    border: 0;
    cursor: pointer;
    background: transparent !important;
    color: var(--ink-2) !important;
    transition:
      background 0.25s,
      color 0.25s;
  }
  .res-tab[aria-selected="true"] {
    background: var(--ink) !important;
    color: #fff !important;
  }
  .res-tab:not([aria-selected="true"]) span {
    background: var(--bg-2) !important;
    color: var(--muted);
  }
  .res-tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 6px 6px 6px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
  }
  .res-tab span {
    font-size: 0.75rem;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent-2);
  }
  .res-nav {
    display: flex;
    gap: 8px;
  }
  .res-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: #fff;
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.3s var(--ease);
  }
  .res-btn:hover {
    background: var(--ink);
    color: #fff;
    transform: scale(1.05);
  }
  .res-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86%, 360px);
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 6px 4px 26px;
    margin-inline: -4px;
  }
  .res-track::-webkit-scrollbar {
    display: none;
  }
  .result {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 22px;
    min-width: 0;
  }
  .result__shot {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: -8px 0 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
    cursor: zoom-in;
    aspect-ratio: 16 / 9;
  }
  .result__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    transition: transform 0.6s var(--ease);
  }
  .result__shot:hover .result__img {
    transform: scale(1.04);
  }
  .result__zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(15 26 28 / 75%);
    color: #fff;
    font-size: 0.95rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .result__shot:hover .result__zoom,
  .result__shot:focus-visible .result__zoom {
    opacity: 1;
  }
  .lightbox {
    max-width: min(1200px, 94vw);
    max-height: 90vh;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 40px 120px -20px rgb(0 0 0 / 50%);
    overflow: auto;
  }
  .lightbox::backdrop {
    background: rgb(15 26 28 / 70%);
    backdrop-filter: blur(4px);
  }
  .lightbox img {
    display: block;
    width: 100%;
    height: auto;
  }
  .lightbox__close {
    position: sticky;
    top: 10px;
    float: right;
    margin: 10px 10px -46px 0;
    z-index: 1;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 1.3rem;
    cursor: pointer;
  }
  .result__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .result__src {
    font-size: 0.7rem;
    color: var(--dim);
    text-align: right;
  }
  .result h4 {
    font-size: 1.08rem;
  }
  .result__metric {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .result p {
    font-size: 0.875rem;
  }
  .result .chips {
    margin-top: auto;
  }
  .res-disclaimer {
    font-size: 0.82rem;
    color: var(--dim);
    max-width: 860px;
  }

  .quote {
    margin: 64px auto 0;
    max-width: 860px;
    text-align: center;
    padding: clamp(28px, 5vw, 52px);
    box-shadow: var(--shadow-lg);
  }
  .quote blockquote {
    margin: 14px 0 22px;
  }
  .quote p {
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.8rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
  }
  .quote figcaption {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    text-align: left;
    font-size: 0.85rem;
  }
  .quote__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
  }

  .audit2 {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .audit2 {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 72px;
    }
  }
  .audit2__copy {
    min-width: 0;
  }
  .audit2__points {
    margin: 22px 0;
  }
  .ticket {
    padding: 32px 28px;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .ticket__label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .ticket__price {
    font-size: 4.5rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--accent);
    margin: 6px 0 22px;
  }
  .ticket__btns {
    display: grid;
    gap: 10px;
  }
  .ticket__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 24px 0 14px;
    padding-top: 18px;
    border-top: 1px dashed var(--line-2);
  }
  .ticket__stats > div {
    display: flex;
    flex-direction: column-reverse;
  }
  .ticket__stats dd {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
  }
  .ticket__stats dt {
    font-size: 0.75rem;
  }
  .ticket .note {
    margin: 0;
  }
</style>
