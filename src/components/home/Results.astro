---
import { aggregates, results, auditPoints, auditTags } from "../../data/home";
---

<section id="results" class="section section--dark" aria-labelledby="results-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Verified SEO Results · Client-Approved Previews</p>
      <h2 id="results-title">Real Ranking Screenshots. Real Search Visibility Growth.</h2>
      <p>
        Selected website SEO and Google Business Profile ranking results pulled directly from Google
        Search Console, GBP Insights and geo-grid trackers. Brand details are masked to protect
        client confidentiality, the data is real.
      </p>
      <ul class="chips">
        <li class="chip">Verified GSC &amp; GBP data</li>
        <li class="chip">NDA-safe previews</li>
        <li class="chip">Client identities protected</li>
      </ul>
    </div>

    <dl class="aggregates">
      {
        aggregates.map((a) => (
          <div>
            <dt>Aggregate · {a.label}</dt>
            <dd>{a.value}</dd>
          </div>
        ))
      }
    </dl>

    <h3 class="results__tab">Website Ranking</h3>
    <ul class="grid grid--3">
      {
        results.map((r) => (
          <li class="card result">
            {r.image && (
              <img
                src={r.image}
                alt={`${r.title}: ${r.metric} (Google Search Console)`}
                loading="lazy"
                decoding="async"
                width="640"
                height="360"
              />
            )}
            <span class="result__period">Website Ranking · {r.period}</span>
            <h4>{r.title}</h4>
            <p class="result__metric">{r.metric}</p>
            <p>{r.text}</p>
            <ul class="chips">
              {r.tags.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
            <p class="result__src">Source: Google Search Console</p>
          </li>
        ))
      }
    </ul>
    <p class="results__disclaimer">
      All screenshots are exported from authenticated Google Search Console and Google Business
      Profile dashboards. Brand names, URLs and account identifiers are intentionally blurred under
      client NDA. Full unblurred reports are shared privately on request.
    </p>

    <figure class="quote">
      <blockquote>
        <p>
          “Ratul rebuilt our entire local SEO foundation, GBP, citations, on-page, and Maps signals.
          Within months we moved from page two to the top of the map pack and our phone stopped
          going quiet.”
        </p>
      </blockquote>
      <figcaption>
        <span class="quote__avatar" aria-hidden="true">SB</span>
        <span
          ><strong>Verified Client</strong> · Service business owner · Identity protected under NDA</span
        >
      </figcaption>
    </figure>
  </div>
</section>

<section class="section section--soft" aria-labelledby="audit2-title">
  <div class="container audit2">
    <div>
      <p class="eyebrow">Free Visibility Audit · No Obligation</p>
      <h2 id="audit2-title">Want to See What Is Blocking Your Rankings?</h2>
      <p class="lead">
        Start with a visibility audit. I’ll review your website ranking signals, Google Business
        Profile performance, Google Maps visibility, competitors, citations, reviews, and local
        search gaps, so you know exactly what to improve next.
      </p>
      <ul class="checklist">
        {auditPoints.map((p) => <li>{p}</li>)}
      </ul>
      <ul class="chips" style="margin-top:20px">
        {auditTags.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
    <div class="card audit2__card">
      <p class="audit2__label">Choose your audit</p>
      <p class="audit2__price">Free</p>
      <div class="audit2__btns">
        <a class="btn btn--primary" href="#contact">Get Free SEO Audit</a>
        <a class="btn btn--ghost" href="#contact">Request GBP Audit</a>
      </div>
      <dl class="audit2__stats">
        <div><dt>Turnaround</dt><dd>48h</dd></div>
        <div><dt>Expert review</dt><dd>1:1</dd></div>
        <div><dt>Confidential</dt><dd>100%</dd></div>
      </dl>
      <p class="note">Private. Never shared. No sales pitch.</p>
    </div>
  </div>
</section>

<style>
  .aggregates {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0 0 56px;
  }
  @media (min-width: 1024px) {
    .aggregates {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .aggregates > div {
    display: flex;
    flex-direction: column-reverse;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--bg-dark-2);
    border: 1px solid rgb(255 255 255 / 8%);
  }
  .aggregates dd {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
  }
  .aggregates dt {
    font-size: 0.85rem;
  }
  .results__tab {
    display: inline-block;
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--brand);
    margin-bottom: 24px;
  }
  .result {
    display: flex;
    flex-direction: column;
  }
  .result img {
    border-radius: 10px;
    margin-bottom: 16px;
  }
  .result__period {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #86efac;
    margin-bottom: 8px;
  }
  .result h4 {
    font-size: 1.1rem;
  }
  .result__metric {
    color: #fff;
    font-weight: 700;
  }
  .result p {
    font-size: 0.925rem;
  }
  .result__src {
    margin: 16px 0 0;
    font-size: 0.8rem;
    color: #64748b;
  }
  .results__disclaimer {
    margin-top: 32px;
    font-size: 0.85rem;
    color: #94a3b8;
    max-width: 860px;
  }
  .quote {
    margin: 56px auto 0;
    max-width: 820px;
    text-align: center;
  }
  .quote blockquote {
    margin: 0;
  }
  .quote p {
    font-family: var(--font-head);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.4;
  }
  .quote figcaption {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    text-align: left;
    font-size: 0.9rem;
  }
  .quote strong {
    color: #fff;
  }
  .quote__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--brand);
    color: #fff;
    font-weight: 700;
  }
  .audit2 {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .audit2 {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .audit2__card {
    text-align: center;
  }
  .audit2__label {
    font-weight: 600;
    color: var(--muted);
    margin: 0;
  }
  .audit2__price {
    font-family: var(--font-head);
    font-size: 3rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .audit2__btns {
    display: grid;
    gap: 10px;
  }
  .audit2__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 24px 0 12px;
  }
  .audit2__stats > div {
    display: flex;
    flex-direction: column-reverse;
  }
  .audit2__stats dd {
    margin: 0;
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--ink);
  }
  .audit2__stats dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
