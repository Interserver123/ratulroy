---
import { aggregates, results, auditPoints, auditTags } from "../../data/home";
---

<section id="results" class="section results" aria-labelledby="results-title">
  <div class="glow" style="width:700px;height:500px;left:-260px;top:30%;background:rgb(255 61 74 / 12%)"></div>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Verified SEO Results · Client-Approved Previews</p>
      <h2 id="results-title">Real Ranking Screenshots. <span class="em">Real Search Visibility Growth.</span></h2>
      <p>
        Selected website SEO and Google Business Profile ranking results pulled directly from Google
        Search Console, GBP Insights and geo-grid trackers. Brand details are masked to protect
        client confidentiality, the data is real.
      </p>
      <ul class="chips">
        <li class="chip">Verified GSC &amp; GBP data</li>
        <li class="chip">NDA-safe previews</li>
        <li class="chip">Client identities protected</li>
      </ul>
    </div>

    <dl class="aggregates">
      {
        aggregates.map((a) => (
          <div>
            <dt>
              <span class="mono">Aggregate</span>
              {a.label}
            </dt>
            <dd class="mono">{a.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="results__bar">
      <h3 class="results__tab">Website Ranking <span class="mono">{results.length}</span></h3>
      <p class="mono">Source: Google Search Console</p>
    </div>

    <ul class="grid grid--3 results__grid">
      {
        results.map((r, i) => (
          <li class={`panel result${i === 0 ? " result--wide panel--edge" : ""}`}>
            {r.image && (
              <img
                src={r.image}
                alt={`${r.title}: ${r.metric} (Google Search Console)`}
                loading="lazy"
                decoding="async"
                width="640"
                height="360"
              />
            )}
            <div class="result__top">
              <span class="tag">{r.period}</span>
              <span class="result__src mono">GSC</span>
            </div>
            <h4>{r.title}</h4>
            <p class="result__metric mono">{r.metric}</p>
            <p>{r.text}</p>
            <ul class="chips">
              {r.tags.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="results__disclaimer">
      All screenshots are exported from authenticated Google Search Console and Google Business
      Profile dashboards. Brand names, URLs and account identifiers are intentionally blurred under
      client NDA. Full unblurred reports are shared privately on request.
    </p>

    <figure class="quote">
      <span class="quote__mark" aria-hidden="true">“</span>
      <blockquote>
        <p>
          Ratul rebuilt our entire local SEO foundation, GBP, citations, on-page, and Maps signals.
          Within months we moved from page two to the top of the map pack and our phone stopped
          going quiet.
        </p>
      </blockquote>
      <figcaption>
        <span class="quote__avatar mono" aria-hidden="true">SB</span>
        <span><strong>Verified Client</strong><br />Service business owner · Identity protected under NDA</span>
      </figcaption>
    </figure>
  </div>
</section>

<section class="section section--alt" aria-labelledby="audit2-title">
  <div class="container audit2">
    <div class="audit2__copy">
      <p class="eyebrow">Free Visibility Audit · No Obligation</p>
      <h2 id="audit2-title">Want to See What Is <span class="em">Blocking Your Rankings?</span></h2>
      <p class="lead">
        Start with a visibility audit. I’ll review your website ranking signals, Google Business
        Profile performance, Google Maps visibility, competitors, citations, reviews, and local
        search gaps, so you know exactly what to improve next.
      </p>
      <ul class="checklist audit2__points">
        {auditPoints.map((p) => <li>{p}</li>)}
      </ul>
      <ul class="chips">
        {auditTags.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
    <div class="ticket panel--edge">
      <p class="ticket__label mono">Choose your audit</p>
      <p class="ticket__price">Free</p>
      <div class="ticket__btns">
        <a class="btn btn--primary" href="#contact">Get Free SEO Audit</a>
        <a class="btn btn--ghost" href="#contact">Request GBP Audit</a>
      </div>
      <dl class="ticket__stats">
        <div><dt>Turnaround</dt><dd class="mono">48h</dd></div>
        <div><dt>Expert review</dt><dd class="mono">1:1</dd></div>
        <div><dt>Confidential</dt><dd class="mono">100%</dd></div>
      </dl>
      <p class="note">Private. Never shared. No sales pitch.</p>
    </div>
  </div>
</section>

<style>
  .results {
    overflow: hidden;
  }
  .aggregates {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0 0 80px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    .aggregates {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .aggregates > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 10px;
    padding: 28px 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  .aggregates dd {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--text);
  }
  .aggregates > div:first-child dd {
    background: linear-gradient(100deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .aggregates dt {
    display: grid;
    gap: 2px;
    font-size: 0.85rem;
  }
  .aggregates dt .mono {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .results__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .results__bar p {
    margin: 0;
    font-size: 0.72rem;
    color: var(--dim);
  }
  .results__tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgb(255 255 255 / 4%);
  }
  .results__tab span {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
  }
  .result {
    display: flex;
    flex-direction: column;
    padding: 24px;
    min-width: 0;
  }
  @media (min-width: 640px) {
    .result--wide {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .result:last-child {
      grid-column: span 2;
    }
  }
  .result--wide .result__metric {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
  }
  .result img {
    border-radius: 10px;
    margin-bottom: 16px;
  }
  .result__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .result__src {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .result h4 {
    font-size: 1.1rem;
  }
  .result__metric {
    color: var(--text);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .result p {
    font-size: 0.9rem;
  }
  .result .chips {
    margin-top: auto;
  }
  .results__disclaimer {
    margin-top: 28px;
    font-size: 0.82rem;
    color: var(--dim);
    max-width: 860px;
  }

  .quote {
    position: relative;
    margin: 96px auto 0;
    max-width: 900px;
    text-align: center;
  }
  .quote__mark {
    display: block;
    font-family: var(--font-serif);
    font-size: 7rem;
    line-height: 0.6;
    color: var(--accent);
  }
  .quote blockquote {
    margin: 0;
  }
  .quote p {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    line-height: 1.3;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .quote figcaption {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    text-align: left;
    font-size: 0.85rem;
  }
  .quote__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    color: var(--text);
    border: 1px solid var(--line-2);
    background: var(--surface-2);
  }

  .audit2 {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .audit2 {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 80px;
    }
  }
  .audit2__copy {
    min-width: 0;
  }
  .audit2__points {
    margin: 24px 0;
  }
  .audit2__points li {
    color: var(--text);
  }
  .ticket {
    border-radius: var(--radius);
    padding: 36px 32px;
    text-align: center;
    box-shadow: 0 40px 100px -40px rgb(255 61 74 / 35%);
  }
  .ticket__label {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ticket__price {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 5rem;
    line-height: 1;
    color: var(--text);
    margin: 8px 0 24px;
  }
  .ticket__btns {
    display: grid;
    gap: 10px;
  }
  .ticket__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 28px 0 16px;
    padding-top: 20px;
    border-top: 1px dashed var(--line-2);
  }
  .ticket__stats > div {
    display: flex;
    flex-direction: column-reverse;
  }
  .ticket__stats dd {
    margin: 0;
    font-size: 1.3rem;
    color: var(--text);
  }
  .ticket__stats dt {
    font-size: 0.75rem;
    color: var(--dim);
  }
  .ticket .note {
    margin: 0;
  }
</style>
