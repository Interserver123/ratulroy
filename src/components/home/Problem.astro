---
import { problems } from "../../data/home";
const icons = [
  // map pin off
  '<path d="M12 21s-6-5.6-6-11a6 6 0 0 1 9.7-4.7M18 10c0 1.6-.6 3.3-1.4 4.8M3 3l18 18"/>',
  // profile card
  '<rect x="3" y="5" width="18" height="14" rx="3"/><circle cx="9" cy="11" r="2.2"/><path d="M14 10h4M14 14h4M6 16c.6-1.4 1.7-2 3-2s2.4.6 3 2"/>',
  // shield
  '<path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  // signal bars
  '<path d="M5 20v-4M10 20v-8M15 20v-6M20 20V8"/>',
];
---

<section class="section" aria-labelledby="problem-title">
  <div class="container">
    <div class="problem">
      <div class="problem__copy" data-reveal>
        <p class="eyebrow">The Local Visibility Problem</p>
        <h2 id="problem-title">
          Your competitors are <span class="em">getting the calls</span> before you even know the
          customer searched.
        </h2>
        <p>
          When someone searches for your service in your city, Google Maps decides who gets the
          call. If your business is not visible, optimized, and trusted, your competitor wins before
          you even get a chance.
        </p>
        <p class="problem__em">
          Most local businesses do not have a traffic problem. They have a visibility problem.
        </p>
        <a class="btn btn--dark" href="#contact"><span class="disc" aria-hidden="true">↗</span>Show Me What's Blocking My Rankings</a>
      </div>

      <figure class="pack card" data-reveal style="--d:2" aria-label="Illustration: a Google Maps 3-pack where your business is missing">
        <figcaption class="pack__search">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          plumber near me
        </figcaption>
        <ol class="pack__list">
          {["A", "B", "C"].map((l, i) => (
            <li style={`--i:${i}`}>
              <span class="pack__pin">{l}</span>
              <span class="pack__lines"><span></span><span></span></span>
              <span class="chip chip--green">Getting the call</span>
            </li>
          ))}
          <li class="pack__you">
            <span class="pack__pin">?</span>
            <span><strong>Your business</strong><br /><small>Not in the top 3, not seen</small></span>
          </li>
        </ol>
      </figure>
    </div>

    <ul class="grid grid--4 problems">
      {
        problems.map((p, i) => (
          <li class="card card--hover" data-reveal style={`--d:${i}`} data-spot>
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>

    <p class="problem__goal" data-reveal>
      The goal is not just to rank higher. The goal is to become the
      <span class="em">obvious choice</span> when local buyers are ready to call.
    </p>
  </div>
</section>

<section id="free-audit" class="section wash" aria-labelledby="audit-title">
  <div class="container">
    <div class="audit card" data-reveal>
      <div class="audit__copy">
        <p class="eyebrow">Free Visibility Audit · No Obligation</p>
        <h2 id="audit-title">Get a Free SEO Visibility Audit of <span class="em">Your Website.</span></h2>
        <p class="lead">
          I'll personally review your website, Google Business Profile and top competitors, and send
          a prioritized action plan to your inbox.
        </p>
        <ul class="chips">
          <li class="chip">48h turnaround</li>
          <li class="chip chip--green">100% confidential</li>
          <li class="chip chip--line">No sales pitch</li>
        </ul>
      </div>
      <form class="audit__form" data-lead-form="audit" novalidate>
        <div class="field">
          <label for="audit-url">Website URL</label>
          <input id="audit-url" name="website" type="url" inputmode="url" placeholder="https://yourbusiness.com" required autocomplete="url" />
        </div>
        <div class="field">
          <label for="audit-email">Email address</label>
          <input id="audit-email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" />
        </div>
        <input class="sr-only" tabindex="-1" aria-hidden="true" name="company_website" autocomplete="off" />
        <button class="btn btn--accent" type="submit">Get My Free SEO Audit <span class="arrow" aria-hidden="true">→</span></button>
        <p class="note">Private. Never shared.</p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .problem {
    display: grid;
    gap: 48px;
    align-items: center;
    margin-bottom: 56px;
  }
  @media (min-width: 1024px) {
    .problem {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 72px;
    }
  }
  .problem__copy {
    min-width: 0;
  }
  .problem__copy > p:not(.eyebrow) {
    max-width: 56ch;
  }
  .problem__em {
    color: var(--ink);
    font-weight: 500;
    margin: 20px 0 28px;
  }

  .pack {
    margin: 0;
    padding: 18px;
    box-shadow: var(--shadow-lg);
  }
  .pack__search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 14px;
  }
  .pack__search svg {
    color: var(--accent);
  }
  .pack__list {
    display: grid;
    gap: 8px;
  }
  .pack__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .pack__pin {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--good);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pack__lines {
    flex: 1;
    display: grid;
    gap: 6px;
  }
  .pack__lines span {
    height: 7px;
    border-radius: 4px;
    background: var(--bg-2);
  }
  .pack__lines span:last-child {
    width: 60%;
  }
  .pack__you {
    border-style: dashed !important;
    border-color: rgb(229 72 107 / 45%) !important;
    background: rgb(229 72 107 / 5%);
  }
  .pack__you .pack__pin {
    background: var(--rose);
  }
  .pack__you small {
    color: var(--muted);
  }

  .problems .card {
    padding: 24px;
  }
  .problems h3 {
    font-size: 1.05rem;
  }
  .problems p {
    margin: 0;
    font-size: 0.9rem;
  }
  .problem__goal {
    margin: 64px auto 0;
    max-width: 780px;
    text-align: center;
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--ink);
    text-wrap: balance;
  }

  .audit {
    display: grid;
    gap: 36px;
    align-items: center;
    padding: clamp(24px, 4.5vw, 52px);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 1024px) {
    .audit {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }
  .audit__copy {
    min-width: 0;
  }
  .audit .lead {
    max-width: 50ch;
  }
  .audit__form .btn {
    width: 100%;
    margin-top: 4px;
  }
  .audit__form .note {
    text-align: center;
    margin: 12px 0 0;
  }
</style>
