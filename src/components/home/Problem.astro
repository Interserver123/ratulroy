---
import { problems } from "../../data/home";
const icons = [
  // map pin off
  '<path d="M12 21s-6-5.6-6-11a6 6 0 0 1 9.7-4.7M18 10c0 1.6-.6 3.3-1.4 4.8M3 3l18 18"/>',
  // profile card
  '<rect x="3" y="5" width="18" height="14" rx="3"/><circle cx="9" cy="11" r="2.2"/><path d="M14 10h4M14 14h4M6 16c.6-1.4 1.7-2 3-2s2.4.6 3 2"/>',
  // shield
  '<path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  // signal bars
  '<path d="M5 20v-4M10 20v-8M15 20v-6M20 20V8"/>',
];
---

<section class="section" aria-labelledby="problem-title">
  <div class="container">
    <div class="problem">
      <div class="problem__copy" data-reveal>
        <p class="eyebrow">The Local Visibility Problem</p>
        <h2 id="problem-title">
          Why customers call your <span class="em">competitors instead of you.</span>
        </h2>
        <p>
          When someone searches for your service in your city, Google ranks local businesses on
          relevance, distance and prominence, and the three in the Map Pack get the first calls. If
          your profile is incomplete or less trusted, a competitor gets the job before you know it existed.
        </p>
        <p class="problem__em">
          <strong>Most local businesses don't have a traffic problem. They have a visibility problem.</strong>
        </p>
        <a class="btn btn--dark" href="/#contact"><span class="disc" aria-hidden="true">↗</span>Show Me What's Blocking My Rankings</a>
      </div>

      <figure class="pack card" data-race data-reveal style="--d:2" aria-label="Illustration: a Google Maps 3-pack. Drag the slider to move your business into it.">
        <figcaption class="pack__search">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          plumber near me
          <span class="pack__pos" data-pos>#9</span>
        </figcaption>
        <ol class="pack__list" data-list>
          {["A", "B", "C"].map((l) => (
            <li class="pack__row" data-row={l}>
              <span class="pack__pin">{l}</span>
              <span class="pack__lines"><span></span><span></span></span>
              <span class="chip chip--green">Getting the call</span>
            </li>
          ))}
          <li class="pack__row pack__you" data-row="you">
            <span class="pack__pin">?</span>
            <span class="pack__youtext"><strong>Your business</strong><br /><small data-status>Not in the top 3, not seen</small></span>
          </li>
        </ol>
        <div class="race">
          <label for="race-range">Local SEO strength</label>
          <input id="race-range" type="range" min="0" max="100" value="0" step="1" data-range />
          <div class="race__scale" aria-hidden="true"><span>Invisible</span><span>Top of the pack</span></div>
        </div>
      </figure>
    </div>

    <ul class="grid grid--4 problems">
      {
        problems.map((p, i) => (
          <li class="card card--hover" data-reveal style={`--d:${i}`} data-spot>
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>

    <p class="problem__goal" data-reveal>
      Ranking higher is the means. Being the
      <span class="em">obvious choice</span> when local buyers are ready to call is the goal.
    </p>
  </div>
</section>

<section id="free-audit" class="section wash" aria-labelledby="audit-title">
  <div class="container">
    <div class="audit card" data-reveal>
      <div class="audit__copy">
        <p class="eyebrow">Free Visibility Audit · No Obligation</p>
        <h2 id="audit-title">Get a free <span class="em">Google Maps visibility audit.</span></h2>
        <p class="lead">
          I'll personally review your website, Google Business Profile and top three Map Pack
          competitors, and send a prioritized action plan to your inbox.
        </p>
        <ul class="chips">
          <li class="chip">48h turnaround</li>
          <li class="chip chip--green">100% confidential</li>
          <li class="chip chip--line">No sales pitch</li>
        </ul>
      </div>
      <form class="audit__form" data-lead-form="audit" novalidate>
        <div class="field">
          <label for="audit-url">Website URL</label>
          <input id="audit-url" name="website" type="url" inputmode="url" placeholder="https://yourbusiness.com" required autocomplete="url" />
        </div>
        <div class="field">
          <label for="audit-email">Email address</label>
          <input id="audit-email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" />
        </div>
        <input class="sr-only" tabindex="-1" aria-hidden="true" name="company_website" autocomplete="off" />
        <button class="btn btn--accent" type="submit">Get My Free SEO Audit <span class="arrow" aria-hidden="true">→</span></button>
        <p class="note">Private. Never shared.</p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Map Pack race: drag the slider and "Your business" climbs into the 3-pack (FLIP reorder).
  document.querySelectorAll<HTMLElement>("[data-race]").forEach((fig) => {
    const list = fig.querySelector<HTMLElement>("[data-list]");
    const range = fig.querySelector<HTMLInputElement>("[data-range]");
    const pos = fig.querySelector<HTMLElement>("[data-pos]");
    const status = fig.querySelector<HTMLElement>("[data-status]");
    const you = fig.querySelector<HTMLElement>('[data-row="you"]');
    const rivals = [...fig.querySelectorAll<HTMLElement>('[data-row]:not([data-row="you"])')];
    if (!list || !range || !you) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let last = -1;

    const render = () => {
      const v = Number(range.value);
      const rank = Math.max(1, Math.round(9 - (v / 100) * 8)); // 9 -> 1
      if (rank === last) return;
      last = rank;
      const rows = [...list.children] as HTMLElement[];
      const before = new Map(rows.map((r) => [r, r.getBoundingClientRect().top]));
      // Order: you take slot `rank` if inside the top 3, otherwise sit below the pack.
      const order = [...rivals];
      order.splice(Math.min(rank, 4) - 1, 0, you);
      order.forEach((r) => list.appendChild(r));
      rivals.forEach((r) => r.classList.toggle("is-out", rank <= 3 && order.indexOf(r) === 3));
      const top = rank <= 3;
      you.classList.toggle("is-top", top);
      if (pos) {
        pos.textContent = `#${rank}`;
        pos.classList.toggle("is-top", top);
      }
      if (status) status.textContent = top ? `Map Pack #${rank}, getting the call` : `Position #${rank}, not seen`;
      if (!reduce) {
        order.forEach((r) => {
          const dy = (before.get(r) ?? 0) - r.getBoundingClientRect().top;
          if (!dy) return;
          r.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], {
            duration: 450,
            easing: "cubic-bezier(.22,1,.36,1)",
          });
        });
      }
    };
    range.addEventListener("input", render);
    render();

    // Hint: nudge the slider once when the card first appears.
    if (!reduce) {
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        let v = 0;
        const t = window.setInterval(() => {
          v += 4;
          range.value = String(v);
          render();
          if (v >= 72) window.clearInterval(t);
        }, 45);
        range.addEventListener("pointerdown", () => window.clearInterval(t), { once: true });
      }, { threshold: 0.6 });
      io.observe(fig);
    }
  });
</script>

<style>
  .problem {
    display: grid;
    gap: 48px;
    align-items: center;
    margin-bottom: 56px;
  }
  @media (min-width: 1024px) {
    .problem {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 72px;
    }
  }
  .problem__copy {
    min-width: 0;
  }
  .problem__copy > p:not(.eyebrow) {
    max-width: 56ch;
  }
  .problem__em {
    color: var(--ink);
    font-weight: 500;
    margin: 20px 0 28px;
  }

  .pack {
    margin: 0;
    padding: 18px;
    box-shadow: var(--shadow-lg);
  }
  .pack__search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 14px;
  }
  .pack__search svg {
    color: var(--accent);
  }
  .pack__list {
    display: grid;
    gap: 8px;
  }
  .pack__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .pack__pin {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--good);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pack__lines {
    flex: 1;
    display: grid;
    gap: 6px;
  }
  .pack__lines span {
    height: 7px;
    border-radius: 4px;
    background: var(--bg-2);
  }
  .pack__lines span:last-child {
    width: 60%;
  }
  .pack__search {
    position: relative;
  }
  .pack__pos {
    margin-left: auto;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .pack__pos.is-top {
    background: var(--good-soft);
    color: var(--good);
  }
  .pack__row {
    will-change: transform;
  }
  .pack__you.is-top {
    border-style: solid !important;
    border-color: rgb(15 157 99 / 45%) !important;
    background: var(--good-soft) !important;
  }
  .pack__you.is-top .pack__pin {
    background: var(--good);
  }
  .pack__row.is-out {
    opacity: 0.45;
  }
  .race {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px dashed var(--line-2);
  }
  .race label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .race input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    cursor: grab;
  }
  .race__scale {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--dim);
  }
  .pack__you {
    border-style: dashed !important;
    border-color: rgb(229 72 107 / 45%) !important;
    background: rgb(229 72 107 / 5%);
  }
  .pack__you .pack__pin {
    background: var(--rose);
  }
  .pack__you small {
    color: var(--muted);
  }

  .problems .card {
    padding: 24px;
  }
  .problems h3 {
    font-size: 1.05rem;
  }
  .problems p {
    margin: 0;
    font-size: 0.9rem;
  }
  .problem__goal {
    margin: 64px auto 0;
    max-width: 780px;
    text-align: center;
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--ink);
    text-wrap: balance;
  }

  .audit {
    display: grid;
    gap: 36px;
    align-items: center;
    padding: clamp(24px, 4.5vw, 52px);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 1024px) {
    .audit {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }
  .audit__copy {
    min-width: 0;
  }
  .audit .lead {
    max-width: 50ch;
  }
  .audit__form .btn {
    width: 100%;
    margin-top: 4px;
  }
  .audit__form .note {
    text-align: center;
    margin: 12px 0 0;
  }
</style>
