---
import { site } from "../../data/site";
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container contact">
    <div class="contact__info">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title">Let's talk about <span class="em">your local SEO</span></h2>
      <p class="lead">
        Send a message, drop me a call, or visit on Google Maps. I usually reply within a few hours.
      </p>

      <h3 class="contact__sub">Contact details</h3>
      <ul class="contact__list">
        <li>
          <a href={`mailto:${site.email}`}><span class="mono">Email</span>{site.email}</a>
        </li>
        <li>
          <a href={site.phoneHref}><span class="mono">Phone</span>{site.phone}</a>
        </li>
        <li>
          <a href={site.mapsUrl} rel="noopener" target="_blank"
            ><span class="mono">Location</span>{site.locality}, {site.country}</a
          >
        </li>
      </ul>

      <h3 class="contact__sub">Follow / Message</h3>
      <div class="btn-row">
        <a class="btn btn--ghost" href={site.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
        <a class="btn btn--ghost" href={site.mapsUrl} rel="noopener" target="_blank">View on Google Maps · This is Ratul Roy</a>
      </div>
    </div>

    <form class="panel panel--edge contact__form" data-lead-form="contact" novalidate>
      <h3>Send a message</h3>
      <p class="note">Tell me about your business and the result you want.</p>
      <div class="contact__row">
        <div class="field">
          <label for="c-name">Your name*</label>
          <input id="c-name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="c-email">Email*</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>
      <div class="field">
        <label for="c-biz">Business / Website</label>
        <input id="c-biz" name="business" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="c-msg">Message</label>
        <textarea id="c-msg" name="message" rows="5"></textarea>
      </div>
      <input class="sr-only" tabindex="-1" aria-hidden="true" name="company_website" autocomplete="off" />
      <button class="btn btn--primary" type="submit">Send message <span class="arrow" aria-hidden="true">→</span></button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<section class="final" aria-labelledby="final-title">
  <div class="final__ring" aria-hidden="true"></div>
  <div class="container final__inner">
    <p class="eyebrow">Ready to Grow?</p>
    <h2 id="final-title">Want to Know What's <span class="em">Blocking Your Local Rankings?</span></h2>
    <p>
      Get a clear Local SEO audit covering your Google Business Profile, Google Maps visibility,
      website SEO, citations, reviews, competitors, and AI search readiness.
    </p>
    <ul class="chips">
      <li class="chip">Google Maps SEO</li>
      <li class="chip">GBP Optimization</li>
      <li class="chip">Website SEO</li>
      <li class="chip">AI Search Ready</li>
    </ul>
    <div class="btn-row">
      <a class="btn btn--primary" href="#free-audit">Get Free Local SEO Audit <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={site.whatsapp} rel="noopener" target="_blank">Chat on WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 80px;
      align-items: start;
    }
  }
  .contact__info {
    min-width: 0;
  }
  .contact__sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 36px 0 14px;
  }
  .contact__list {
    border-top: 1px solid var(--line);
  }
  .contact__list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 1.05rem;
    word-break: break-word;
  }
  .contact__list a:hover {
    color: var(--accent);
  }
  .contact__list span {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .contact__form {
    padding: clamp(24px, 4vw, 40px);
  }
  .contact__form h3 {
    font-size: 1.4rem;
    margin-bottom: 4px;
  }
  .contact__form .note {
    margin-bottom: 24px;
  }
  .contact__row {
    display: grid;
    gap: 0 16px;
  }
  @media (min-width: 640px) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .final {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 13vw, 168px) 0;
    text-align: center;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(50% 70% at 50% 120%, rgb(255 61 74 / 30%), transparent 70%),
      var(--bg);
  }
  .final__ring {
    position: absolute;
    left: 50%;
    bottom: -60%;
    width: min(1100px, 160vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    border: 1px solid rgb(255 61 74 / 30%);
    box-shadow:
      0 0 0 80px rgb(255 61 74 / 2%),
      0 0 0 160px rgb(255 61 74 / 1.5%);
    pointer-events: none;
  }
  .final__inner {
    position: relative;
    max-width: 860px;
  }
  .final .eyebrow::after {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--accent);
  }
  .final h2 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .final p:not(.eyebrow) {
    max-width: 60ch;
    margin-inline: auto;
    font-size: 1.1rem;
  }
  .final .chips,
  .final .btn-row {
    justify-content: center;
    margin-top: 28px;
  }
</style>
