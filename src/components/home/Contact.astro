---
import { site } from "../../data/site";
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title">Let's talk about your local SEO</h2>
      <p>
        Send a message, drop me a call, or visit on Google Maps. I usually reply within a few hours.
      </p>
    </div>

    <div class="contact">
      <form class="card" data-lead-form="contact" novalidate>
        <h3>Send a message</h3>
        <p class="note">Tell me about your business and the result you want.</p>
        <div class="contact__row">
          <div class="field">
            <label for="c-name">Your name<span aria-hidden="true">*</span></label>
            <input id="c-name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="c-email">Email<span aria-hidden="true">*</span></label>
            <input id="c-email" name="email" type="email" required autocomplete="email" />
          </div>
        </div>
        <div class="field">
          <label for="c-biz">Business / Website</label>
          <input id="c-biz" name="business" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="c-msg">Message</label>
          <textarea id="c-msg" name="message" rows="5"></textarea>
        </div>
        <input class="sr-only" tabindex="-1" aria-hidden="true" name="company_website" autocomplete="off" />
        <button class="btn btn--primary" type="submit">Send message</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>

      <div class="contact__side">
        <div class="card">
          <h3>Contact details</h3>
          <ul class="contact__list">
            <li>
              <a href={`mailto:${site.email}`}><span>Email</span>{site.email}</a>
            </li>
            <li>
              <a href={site.phoneHref}><span>Phone</span>{site.phone}</a>
            </li>
            <li>
              <a href={site.mapsUrl} rel="noopener" target="_blank"
                ><span>Location</span>{site.locality}, {site.country}</a
              >
            </li>
          </ul>
        </div>
        <div class="card">
          <h3>Follow / Message</h3>
          <div class="btn-row">
            <a class="btn btn--accent" href={site.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
            <a class="btn btn--ghost" href={site.mapsUrl} rel="noopener" target="_blank"
              >View on Google Maps</a
            >
          </div>
          <p class="note" style="margin:12px 0 0">This is Ratul Roy</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="final" aria-labelledby="final-title">
  <div class="container final__inner on-dark">
    <p class="eyebrow">Ready to Grow?</p>
    <h2 id="final-title">Want to Know What's Blocking Your Local Rankings?</h2>
    <p>
      Get a clear Local SEO audit covering your Google Business Profile, Google Maps visibility,
      website SEO, citations, reviews, competitors, and AI search readiness.
    </p>
    <ul class="chips">
      <li class="chip">Google Maps SEO</li>
      <li class="chip">GBP Optimization</li>
      <li class="chip">Website SEO</li>
      <li class="chip">AI Search Ready</li>
    </ul>
    <div class="btn-row">
      <a class="btn btn--accent" href="#free-audit">Get Free Local SEO Audit</a>
      <a class="btn btn--ghost" href={site.whatsapp} rel="noopener" target="_blank"
        >Chat on WhatsApp</a
      >
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }
  .contact__row {
    display: grid;
    gap: 0 16px;
  }
  @media (min-width: 640px) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact__side {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .contact__list li + li {
    margin-top: 14px;
  }
  .contact__list a {
    display: grid;
    color: var(--ink);
    font-weight: 600;
    word-break: break-word;
  }
  .contact__list span {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .final {
    background:
      radial-gradient(800px 400px at 80% 0%, rgb(37 99 235 / 35%), transparent 60%),
      var(--bg-dark);
    color: #cbd5e1;
    padding: clamp(64px, 9vw, 104px) 0;
    text-align: center;
  }
  .final__inner {
    max-width: 820px;
  }
  .final h2 {
    color: #fff;
  }
  .final .eyebrow {
    color: #86efac;
  }
  .final .chips,
  .final .btn-row {
    justify-content: center;
    margin-top: 24px;
  }
  .final .chip {
    background: rgb(255 255 255 / 6%);
    color: #e2e8f0;
    border-color: rgb(255 255 255 / 12%);
  }
</style>
