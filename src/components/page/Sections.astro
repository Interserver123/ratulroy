---
import { Image } from "astro:assets";
import { img } from "../../lib/img";
import { md, slugify } from "../../lib/md";
import type { CollectionEntry } from "astro:content";

type Section = CollectionEntry<"pages">["data"]["sections"][number];
interface Props {
  sections: Section[];
}
const { sections } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, "0");
const cell = (c: string) =>
  /^yes$/i.test(c)
    ? '<span class="pcmp__y" role="img" aria-label="Yes">✓</span>'
    : /^no$/i.test(c)
      ? '<span class="pcmp__n" role="img" aria-label="No">✕</span>'
      : md(c);
const auditTotal = (s: Section) => s.blocks?.reduce((n, b) => n + (b.bullets?.length ?? 0), 0) ?? 0;
---

{
  sections.map((s, si) => {
    const cols = s.columns ?? (s.items && s.items.length % 3 === 0 ? 3 : s.items && s.items.length >= 4 ? (s.items.length % 4 === 0 ? 4 : 2) : 2);
    const headId = `sec-${si}`;
    return (
      <section class={`section${s.alt ? " wash" : ""} psec psec--${s.type}`} id={s.id ?? (s.nav ? slugify(s.nav) : undefined)} aria-labelledby={s.heading ? headId : undefined}>
        <div class="container">
          {(s.eyebrow || s.heading || s.intro) && s.type !== "cta" && (
            <div class={`section-head${["stats", "quotes", "images", "factors"].includes(s.type) ? " section-head--center" : ""}`} data-reveal>
              {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
              {s.heading && <h2 id={headId} set:html={md(s.heading)} />}
              {s.intro && <p set:html={md(s.intro)} />}
            </div>
          )}

          {/* ---- prose: paragraphs, then optional sub-blocks ---- */}
          {s.type === "prose" && (
            <div class="prose" data-reveal>
              {s.body?.map((p) => <p set:html={md(p)} />)}
              {s.bullets && (
                <ul class="checklist">
                  {s.bullets.map((b) => <li set:html={md(b)} />)}
                </ul>
              )}
              {s.blocks?.map((b, bi) => (
                <div class="prose__block">
                  <h3><span class="prose__n num">{pad(bi)}</span>{b.heading}</h3>
                  {b.body?.map((p) => <p set:html={md(p)} />)}
                  {b.bullets && (
                    <ul class="checklist">
                      {b.bullets.map((x) => <li set:html={md(x)} />)}
                    </ul>
                  )}
                </div>
              ))}
              {s.stat && (
                <div class="prose__stat card">
                  <span class="prose__statv num">{s.stat.value}</span>
                  <span>{s.stat.label}</span>
                </div>
              )}
            </div>
          )}

          {/* ---- list: a single checklist, optionally with paragraphs ---- */}
          {s.type === "list" && (
            <div class="plist card" data-reveal>
              {s.body?.map((p) => <p set:html={md(p)} />)}
              <ul class="checklist plist__items">
                {s.bullets?.map((b) => <li set:html={md(b)} />)}
              </ul>
            </div>
          )}

          {/* ---- cards ---- */}
          {s.type === "cards" && (
            <ul class={`grid grid--${cols} pcards`}>
              {s.items?.map((it, i) => (
                <li class={`card card--hover pcard${it.featured ? " pcard--featured" : ""}`} data-reveal style={`--d:${i % cols}`} data-spot>
                  {it.featured && <span class="pcard__flag">Featured</span>}
                  {it.image && (
                    <div class="pcard__img">
                      <Image src={img(it.image)} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 360px, 90vw" loading="lazy" />
                    </div>
                  )}
                  {it.label && <p class="tag">{it.label}</p>}
                  <h3>{it.href ? <a href={it.href}>{it.title}</a> : it.title}</h3>
                  {it.text && <p set:html={md(it.text)} />}
                  {it.bullets && (
                    <ul class="checklist">
                      {it.bullets.map((b) => <li set:html={md(b)} />)}
                    </ul>
                  )}
                  {it.tags && (
                    <ul class="chips pcard__tags">
                      {it.tags.map((t) => <li class="chip chip--line">{t}</li>)}
                    </ul>
                  )}
                  {(it.meta || it.cta) && (
                    <div class="pcard__foot">
                      {it.meta && <span class="pcard__meta">{it.meta}</span>}
                      {it.href && it.cta && <span class="text-link">{it.cta}</span>}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}

          {/* ---- problems: "usual cause" style cards ---- */}
          {s.type === "problems" && (
            <ul class="grid grid--2 pprob">
              {s.items?.map((it, i) => (
                <li class="card" data-reveal style={`--d:${i % 2}`}>
                  <span class="pprob__icon" aria-hidden="true">!</span>
                  <div>
                    <h3>{it.title}</h3>
                    {it.text && <p set:html={md(it.text)} />}
                  </div>
                </li>
              ))}
            </ul>
          )}

          {/* ---- steps: numbered route ---- */}
          {s.type === "steps" && (
            <ol class="psteps">
              {s.items?.map((it, i) => (
                <li class="psteps__item" data-reveal style={`--d:${i % 4}`}>
                  <span class="psteps__pin num" aria-hidden="true"><span>{it.label ?? pad(i)}</span></span>
                  <div class="card">
                    <h3>{it.title}</h3>
                    {it.text && <p set:html={md(it.text)} />}
                    {it.bullets && (
                      <ul class="checklist">
                        {it.bullets.map((b) => <li set:html={md(b)} />)}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          )}

          {/* ---- stats ---- */}
          {s.type === "stats" && (
            <dl class="pstats">
              {s.items?.map((it, i) => (
                <div class="card" data-reveal style={`--d:${i}`}>
                  <dt>{it.title}</dt>
                  <dd class="num" data-count={/\d/.test(it.value ?? "") && !/–|-\d/.test(it.value ?? "") ? "" : undefined}>{it.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {/* ---- images (screenshots with captions) ---- */}
          {s.type === "images" && (
            <div class="pimgs">
              {s.items?.map((it, i) => (
                <figure class="card" data-reveal style={`--d:${i % 2}`}>
                  {it.image && <Image src={img(it.image)} alt={it.text ?? it.title} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 560px, 92vw" loading="lazy" class="pimgs__img" />}
                  <figcaption>
                    <b>{it.title}</b>
                    {it.text && <span> · {it.text}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}

          {/* ---- pricing tiers ---- */}
          {s.type === "pricing" && (
            <>
              <div class={`ptiers ptiers--${s.tiers?.length ?? 3}`}>
                {s.tiers?.map((t, i) => (
                  <div class={`card ptier${t.featured ? " ptier--featured" : ""}`} data-reveal style={`--d:${i}`}>
                    {t.featured && <span class="pcard__flag">Most chosen</span>}
                    <h3>{t.name}</h3>
                    <p class="ptier__price"><span>{t.price}</span>{t.unit && <small>{t.unit}</small>}</p>
                    {t.for && <p class="ptier__for">{t.for}</p>}
                    {t.text && <p class="ptier__text">{t.text}</p>}
                    <ul class="checklist">
                      {t.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                    {t.receive && <p class="ptier__receive"><b>You receive</b>{t.receive}</p>}
                    <a class={`btn ${t.featured ? "btn--dark" : "btn--ghost"}`} href={t.cta?.href ?? "/book-strategy-call"}>{t.cta?.label ?? "Get started"}</a>
                  </div>
                ))}
              </div>
              {s.bullets && (
                <ul class="passure" data-reveal role="list" style={`--n:${s.bullets.length}`}>
                  {s.bullets.map((b) => (
                    <li>
                      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z" fill="currentColor" opacity=".14" /><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m8.5 12 2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      <span set:html={md(b)} />
                    </li>
                  ))}
                </ul>
              )}
              {s.note && <p class="pnote" set:html={md(s.note)} />}
            </>
          )}

          {/* ---- quotes ---- */}
          {s.type === "quotes" && (
            <div class="grid grid--3 pquotes">
              {s.quotes?.map((q, i) => (
                <figure class="card" data-reveal style={`--d:${i}`}>
                  <span class="stars" aria-hidden="true">★★★★★</span>
                  <blockquote><p>“{q.quote}”</p></blockquote>
                  <figcaption><b>{q.name}</b>{q.meta && <span>{q.meta}</span>}</figcaption>
                </figure>
              ))}
            </div>
          )}

          {/* ---- compare: a real table (snippet friendly) ---- */}
          {s.type === "compare" && s.table && (
            <div class="pcmp card" data-reveal>
              <div class="pcmp__scroll" tabindex="0" role="region" aria-label={s.heading ?? "Comparison"}>
                <table>
                  <thead>
                    <tr>
                      <th scope="col"><span class="sr-only">Feature</span></th>
                      {s.table.columns.map((c, i) => <th scope="col" class={i === s.table!.highlight ? "is-hl" : undefined}>{c}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((r) => (
                      <tr>
                        <th scope="row" set:html={md(r.label)} />
                        {r.cells.map((c, i) => <td class={i === s.table!.highlight ? "is-hl" : undefined} set:html={cell(c)} />)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* ---- timeline: phases on a route ---- */}
          {s.type === "timeline" && (
            <ol class={`ptl ptl--${s.items?.length ?? 3}`} data-route>
              <span class="route__line ptl__line" aria-hidden="true"><span /></span>
              {s.items?.map((it, i) => (
                <li class="ptl__item" data-reveal style={`--d:${i}`}>
                  <span class="ptl__dot" aria-hidden="true" />
                  <p class="ptl__when">{it.label ?? `Phase ${i + 1}`}</p>
                  <div class="card">
                    <h3>{it.title}</h3>
                    {it.text && <p set:html={md(it.text)} />}
                    {it.bullets && (
                      <ul class="checklist">
                        {it.bullets.map((b) => <li set:html={md(b)} />)}
                      </ul>
                    )}
                    {it.meta && <p class="ptl__out"><b>Outcome</b>{it.meta}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}

          {/* ---- factors: three overlapping rings (relevance / distance / prominence) ---- */}
          {s.type === "factors" && (
            <div class="pfac">
              <div class="pfac__viz" data-reveal aria-hidden="true">
                <svg viewBox="0 0 320 300">
                  <circle class="pfac__ring pfac__ring--0" cx="118" cy="110" r="88" />
                  <circle class="pfac__ring pfac__ring--1" cx="202" cy="110" r="88" />
                  <circle class="pfac__ring pfac__ring--2" cx="160" cy="184" r="88" />
                  {s.items?.slice(0, 3).map((it, i) => (
                    <text class={`pfac__lbl pfac__lbl--${i}`} x={[78, 242, 160][i]} y={[86, 86, 248][i]} text-anchor="middle">{it.label ?? it.title}</text>
                  ))}
                  <g class="pfac__pin">
                    <path d="M160 116c-9 0-16 7-16 16 0 12 16 26 16 26s16-14 16-26c0-9-7-16-16-16z" />
                    <circle cx="160" cy="132" r="5.5" fill="#fff" />
                  </g>
                </svg>
                <p class="pfac__mid">{s.stat?.label ?? "Map Pack"}</p>
              </div>
              <ol class="pfac__list">
                {s.items?.map((it, i) => (
                  <li class={`card pfac__item pfac__item--${i}`} data-reveal style={`--d:${i}`} tabindex="0">
                    <span class="pfac__key" aria-hidden="true" />
                    <div>
                      <h3>{it.title}</h3>
                      {it.text && <p set:html={md(it.text)} />}
                      {it.bullets && (
                        <ul class="checklist">
                          {it.bullets.map((b) => <li set:html={md(b)} />)}
                        </ul>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {/* ---- journey: scroll-driven Map Pack climb (illustration) ---- */}
          {s.type === "journey" && (
            <div class="jy" data-journey data-stage="0">
              <ol class="jy__steps" style={`--n:${s.items?.length ?? 4}`}>
                {s.items?.map((it, i) => (
                  <li class="jy__step" data-step={i}>
                    <button type="button" class="jy__tab" data-go={i}>
                      <span class="jy__n num">{pad(i)}</span>
                      <span>{it.label ?? it.title}</span>
                    </button>
                    <div class="jy__body">
                      <h3>{it.title}</h3>
                      {it.text && <p set:html={md(it.text)} />}
                      {it.bullets && (
                        <ul class="checklist">
                          {it.bullets.map((b) => <li set:html={md(b)} />)}
                        </ul>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
              <div class="jy__stage">
                <div class="jy__phone" aria-hidden="true">
                  <div class="jy__search">
                    <svg viewBox="0 0 24 24" width="14" height="14"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="m20 20-4-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
                    <span>{s.note ?? "plumber near me"}</span>
                  </div>
                  <div class="jy__map">
                    <div class="jy__grid">
                      {Array.from({ length: 49 }, (_, i) => {
                        const x = i % 7, y = Math.floor(i / 7);
                        return <span style={`--d:${Math.hypot(x - 3, y - 3).toFixed(2)}`} data-d={Math.hypot(x - 3, y - 3).toFixed(2)} />;
                      })}
                    </div>
                    <span class="jy__pin jy__pin--a"><i>A</i></span>
                    <span class="jy__pin jy__pin--b"><i>B</i></span>
                    <span class="jy__pin jy__pin--c"><i>C</i></span>
                    <span class="jy__me"><span /></span>
                  </div>
                  <ul class="jy__pack">
                    <li class="jy__row jy__row--you">
                      <span class="jy__rank num" data-rank>#9</span>
                      <span class="jy__info"><b>Your business</b><small>★★★★★ · Open now</small></span>
                      <span class="jy__call">Call</span>
                    </li>
                    <li class="jy__row" style="--o:1"><span class="jy__rank jy__rank--pin num">A</span><span class="jy__info"><b>Competitor A</b><small>★★★★☆ · Open now</small></span></li>
                    <li class="jy__row" style="--o:2"><span class="jy__rank jy__rank--pin num">B</span><span class="jy__info"><b>Competitor B</b><small>★★★★☆ · Closes 8 pm</small></span></li>
                    <li class="jy__row" style="--o:3"><span class="jy__rank jy__rank--pin num">C</span><span class="jy__info"><b>Competitor C</b><small>★★★☆☆ · Open now</small></span></li>
                  </ul>
                  <p class="jy__status"><span data-status>{s.items?.[0]?.meta}</span></p>
                </div>
                <p class="jy__label">Illustration of a typical campaign path, not client data</p>
              </div>
              <script type="application/json" data-journey-data set:html={JSON.stringify(s.items?.map((it) => ({ rank: Number(it.value ?? 9), meta: it.meta ?? "" })) ?? [])} />
            </div>
          )}

          {/* ---- audit: interactive self-check ---- */}
          {s.type === "audit" && (
            <div class="paud" data-audit data-total={auditTotal(s)}>
              <div class="paud__groups">
                {s.blocks?.map((b, bi) => (
                  <fieldset class="card paud__group" data-reveal style={`--d:${bi % 2}`}>
                    <legend><span class="num">{pad(bi)}</span>{b.heading}</legend>
                    {b.bullets?.map((x, xi) => (
                      <label class="paud__row">
                        <input type="checkbox" name={`a-${si}-${bi}-${xi}`} />
                        <span class="paud__box" aria-hidden="true" />
                        <span set:html={md(x)} />
                      </label>
                    ))}
                  </fieldset>
                ))}
              </div>
              <aside class="paud__score card" aria-live="polite">
                <div class="paud__ring">
                  <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle cx="60" cy="60" r="50" class="paud__track" />
                    <circle cx="60" cy="60" r="50" class="paud__bar" pathLength="100" />
                  </svg>
                  <p><b class="num" data-audit-n>0</b><span>/ {auditTotal(s)}</span></p>
                </div>
                <p class="paud__msg" data-audit-msg>Tick everything your profile already has.</p>
                <a class="btn btn--dark" href={s.buttons?.[0]?.href ?? "/#free-audit"}><span class="disc" aria-hidden="true">↗</span>{s.buttons?.[0]?.label ?? "Get a free audit"}</a>
                {s.note && <p class="paud__note" set:html={md(s.note)} />}
              </aside>
            </div>
          )}

          {/* ---- inline CTA banner ---- */}
          {s.type === "cta" && (
            <div class="pcta" data-reveal>
              <div>
                {s.eyebrow && <p class="pcta__eyebrow">{s.eyebrow}</p>}
                {s.heading && <h2 id={headId} set:html={md(s.heading)} />}
                {s.intro && <p set:html={md(s.intro)} />}
              </div>
              <div class="pcta__btns">
                {(s.buttons ?? [{ label: "Book strategy call", href: "/book-strategy-call" }, { label: "Get free SEO audit", href: "/#free-audit" }]).map((b, i) => (
                  <a class={`btn ${i === 0 ? "btn--light" : "btn--outline"}`} href={b.href}>{b.label}</a>
                ))}
              </div>
            </div>
          )}

          {s.type !== "prose" && s.type !== "list" && s.body && (
            <div class="prose psec__after" data-reveal>{s.body.map((p) => <p set:html={md(p)} />)}</div>
          )}
        </div>
      </section>
    );
  })
}

<script>
  // Journey: the active step drives the phone mock-up (rank, pack position, geo-grid ripple).
  document.querySelectorAll<HTMLElement>("[data-journey]").forEach((root) => {
    const data: { rank: number; meta: string }[] = JSON.parse(root.querySelector("[data-journey-data]")?.textContent || "[]");
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const cells = [...root.querySelectorAll<HTMLElement>(".jy__grid span")];
    const rankEl = root.querySelector<HTMLElement>("[data-rank]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const n = data.length;
    let cur = -1;
    const go = (i: number) => {
      if (i === cur || !data[i]) return;
      cur = i;
      const { rank, meta } = data[i];
      root.dataset.stage = String(i);
      root.style.setProperty("--slot", String(Math.min(rank, 4) - 1));
      root.classList.toggle("is-in", rank <= 3);
      if (rankEl) rankEl.textContent = rank <= 3 ? String(rank) : `#${rank}`;
      if (status) status.textContent = meta;
      // visibility spreads outward from the business as the stages progress
      const p = n > 1 ? i / (n - 1) : 1;
      const g = 0.6 + p * 3.2,
        m = g + 1.3;
      cells.forEach((c) => {
        const d = Number(c.dataset.d);
        c.className = d <= g ? "g" : d <= m ? "m" : "";
      });
      steps.forEach((s, k) => s.classList.toggle("is-on", k === i));
    };
    root.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((b) => b.addEventListener("click", () => { go(Number(b.dataset.go)); stop(); }));
    const wide = window.matchMedia("(min-width: 960px)");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer = 0;
    const stop = () => window.clearInterval(timer);
    // Desktop: scroll position picks the step. Mobile: auto-advance while visible.
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.isIntersecting && wide.matches && go(steps.indexOf(e.target as HTMLElement))),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => io.observe(s));
    new IntersectionObserver(([e]) => {
      stop();
      if (e.isIntersecting && !wide.matches && !reduce) timer = window.setInterval(() => go((cur + 1) % n), 3200);
    }, { threshold: 0.4 }).observe(root);
    go(0);
  });

  // Self-audit checklist: live score ring + verdict.
  document.querySelectorAll<HTMLElement>("[data-audit]").forEach((root) => {
    const total = Number(root.dataset.total) || 1;
    const n = root.querySelector<HTMLElement>("[data-audit-n]");
    const msg = root.querySelector<HTMLElement>("[data-audit-msg]");
    const update = () => {
      const done = root.querySelectorAll("input:checked").length;
      const pct = Math.round((done / total) * 100);
      root.style.setProperty("--p", String(pct));
      if (n) n.textContent = String(done);
      if (msg)
        msg.textContent =
          done === 0
            ? "Tick everything your profile already has."
            : pct < 40
              ? "Big gaps. Most of your Maps visibility is being left on the table."
              : pct < 75
                ? "A solid base. The remaining gaps are exactly what competitors win on."
                : pct < 100
                  ? "Strong profile. The gains left come from reviews, links and prominence."
                  : "Everything ticked. Now it is about prominence: reviews, links and mentions.";
      root.classList.toggle("is-low", done > 0 && pct < 40);
      root.classList.toggle("is-high", pct >= 75);
    };
    root.addEventListener("change", update);
    update();
  });
</script>

<style>
  .psec + .psec:not(.wash) {
    padding-top: 0;
  }
  .wash + .psec:not(.wash),
  .psec:not(.wash) + .wash {
    padding-top: clamp(80px, 10vw, 128px);
  }

  /* prose */
  .prose {
    max-width: 72ch;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose .checklist {
    margin: 8px 0 20px;
  }
  .prose .checklist li {
    font-size: 1rem;
  }
  .prose__block {
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .prose__block h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.3rem;
    margin-bottom: 12px;
  }
  .prose__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font);
    font-size: 0.75rem;
  }
  .prose__stat {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
    padding: 20px 24px;
    background:
      radial-gradient(80% 140% at 0% 0%, rgb(15 157 99 / 14%), transparent 60%),
      var(--paper);
  }
  .prose__statv {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--good);
  }
  .psec__after {
    margin-top: 32px;
  }

  /* list */
  .plist {
    padding: clamp(22px, 3vw, 32px);
    max-width: 880px;
  }
  .plist__items {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  /* cards */
  .pcard {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .pcard h3 {
    font-size: 1.1rem;
  }
  .pcard h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pcard > p {
    font-size: 0.92rem;
  }
  .pcard .checklist {
    margin-bottom: 16px;
  }
  .pcard .checklist li {
    font-size: 0.86rem;
  }
  .pcard__tags {
    margin-top: auto;
    padding-top: 6px;
  }
  .pcard__foot {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px dashed var(--line-2);
  }
  .pcard__meta {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--good);
  }
  .pcard--featured {
    border: 1.5px solid var(--accent);
    box-shadow:
      0 0 0 4px rgb(232 64 47 / 8%),
      var(--shadow-lg);
  }
  .pcard__flag {
    position: absolute;
    top: -11px;
    right: 18px;
    padding: 3px 11px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .pcard__img {
    margin: -8px -8px 16px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .pcard__img :global(img) {
    width: 100%;
    height: 170px;
    object-fit: cover;
    object-position: 0 0;
  }

  /* problems */
  .pprob .card {
    display: flex;
    gap: 16px;
    padding: 22px;
  }
  .pprob__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
  }
  .pprob h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }
  .pprob p {
    margin: 0;
    font-size: 0.92rem;
  }

  /* steps */
  .psteps {
    position: relative;
    display: grid;
    gap: 16px;
  }
  .psteps::before {
    content: "";
    position: absolute;
    left: 21px;
    top: 10px;
    bottom: 10px;
    width: 3px;
    background: repeating-linear-gradient(180deg, var(--accent-2) 0 8px, transparent 8px 14px);
    opacity: 0.6;
  }
  .psteps__item {
    position: relative;
    padding-left: 64px;
  }
  .psteps__pin {
    position: absolute;
    left: 0;
    top: 16px;
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    border-radius: 50% 50% 50% 6px;
    transform: rotate(-45deg);
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 0 0 6px var(--bg);
  }
  .psteps__pin > span {
    transform: rotate(45deg);
  }
  .psteps .card {
    padding: 20px 24px;
  }
  .psteps h3 {
    font-size: 1.08rem;
    margin-bottom: 6px;
  }
  .psteps p {
    margin: 0;
    font-size: 0.92rem;
  }
  @media (min-width: 1024px) {
    .psteps {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 18px;
    }
    .psteps::before {
      left: 22px;
      right: 22px;
      top: 22px;
      bottom: auto;
      width: auto;
      height: 3px;
      background: repeating-linear-gradient(90deg, var(--accent-2) 0 8px, transparent 8px 14px);
    }
    .psteps__item {
      padding: 64px 0 0;
    }
    .psteps__pin {
      top: 0;
    }
    .psteps .card {
      height: 100%;
    }
  }

  /* stats */
  .pstats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 0;
  }
  @media (min-width: 900px) {
    .pstats {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
  .pstats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 22px;
  }
  .pstats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .pstats > div:first-child dd {
    color: var(--accent);
  }
  .pstats > div:nth-child(2) dd {
    color: var(--good);
  }
  .pstats dt {
    font-size: 0.85rem;
  }

  /* images */
  .pimgs {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 900px) {
    .pimgs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pimgs figure {
    margin: 0;
    padding: 12px;
  }
  .pimgs__img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .pimgs figcaption {
    padding: 12px 6px 4px;
    font-size: 0.9rem;
  }
  .pimgs figcaption b {
    color: var(--ink);
  }

  /* pricing */
  .ptiers {
    display: grid;
    gap: 18px;
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .ptiers--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .ptiers--2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .ptier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px;
  }
  .ptier--featured {
    border: 1.5px solid var(--accent);
    box-shadow:
      0 0 0 5px rgb(232 64 47 / 8%),
      var(--shadow-lg);
  }
  .ptier h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }
  .ptier__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 8px;
  }
  .ptier__price span {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .ptier__price small {
    font-size: 0.82rem;
    color: var(--dim);
  }
  .ptier__for {
    font-weight: 600;
    color: var(--ink);
    font-size: 0.92rem;
  }
  .ptier__text {
    font-size: 0.9rem;
  }
  .ptier .checklist {
    margin-bottom: 18px;
  }
  .ptier .checklist li {
    font-size: 0.88rem;
  }
  .ptier__receive {
    margin-top: auto;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--bg);
    font-size: 0.86rem;
    display: grid;
  }
  .ptier__receive b {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ptier .btn {
    margin-top: 16px;
  }
  .pnote {
    margin-top: 22px;
    font-size: 0.88rem;
    max-width: 80ch;
  }

  /* quotes */
  .pquotes figure {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .pquotes blockquote {
    margin: 10px 0 16px;
  }
  .pquotes blockquote p {
    margin: 0;
    font-size: 1.02rem;
    color: var(--ink);
    font-weight: 500;
  }
  .pquotes figcaption {
    margin-top: auto;
    display: grid;
    font-size: 0.85rem;
  }
  .pquotes figcaption b {
    color: var(--ink);
  }

  /* cta */
  .pcta {
    display: grid;
    gap: 24px;
    align-items: center;
    padding: clamp(26px, 4vw, 44px);
    border-radius: var(--radius);
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(232 64 47 / 35%), transparent 60%),
      var(--ink);
    color: #c3cccb;
  }
  .pcta h2 {
    color: #fff;
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
  }
  .pcta p {
    margin: 0;
    max-width: 62ch;
  }
  .pcta__eyebrow {
    margin: 0 0 8px !important;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .pcta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (min-width: 1024px) {
    .pcta {
      grid-template-columns: 1.5fr auto;
    }
    .pcta__btns {
      flex-direction: column;
    }
  }
  .btn--light {
    background: #fff;
    color: var(--ink);
  }
  .btn--light:hover {
    color: var(--ink);
  }
  .btn--outline {
    color: #fff;
    border-color: rgb(255 255 255 / 30%);
  }
  .btn--outline:hover {
    color: #fff;
    border-color: #fff;
  }
  .section-head :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pnote :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .passure {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .passure {
      grid-template-columns: repeat(var(--n, 4), 1fr);
    }
  }
  .passure li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--good-soft);
    color: var(--good);
    font-size: 0.9rem;
  }
  .passure li span {
    color: var(--ink);
  }
  .passure svg {
    flex: none;
  }

  /* compare */
  .pcmp {
    padding: 0;
    overflow: hidden;
  }
  .pcmp__scroll {
    overflow-x: auto;
  }
  .pcmp table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .pcmp th,
  .pcmp td {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .pcmp thead th {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
    background: var(--bg);
  }
  .pcmp tbody th {
    font-weight: 600;
    color: var(--ink);
    width: 30%;
    position: sticky;
    left: 0;
    background: var(--paper);
  }
  .pcmp td {
    color: var(--ink-2);
  }
  .pcmp tbody tr:last-child > * {
    border-bottom: 0;
  }
  .pcmp .is-hl {
    background: rgb(232 64 47 / 6%);
    color: var(--ink);
  }
  .pcmp thead .is-hl {
    background: var(--ink);
    color: #fff;
  }
  .pcmp :global(.pcmp__y),
  .pcmp :global(.pcmp__n) {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pcmp :global(.pcmp__y) {
    background: var(--good-soft);
    color: var(--good);
  }
  .pcmp :global(.pcmp__n) {
    background: var(--bg-2);
    color: var(--dim);
  }

  /* timeline */
  .ptl {
    position: relative;
    display: grid;
    gap: 22px;
    padding-left: 30px;
  }
  .ptl::before {
    content: "";
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: 8px;
    border-left: 2px dashed var(--line-2);
  }
  .ptl__item {
    position: relative;
  }
  .ptl__line {
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    pointer-events: none;
  }
  .ptl__line span {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--accent), var(--good));
    transform-origin: 50% 0;
    transform: scaleY(var(--p, 1));
  }
  @media (min-width: 960px) {
    .ptl__line {
      left: 10px;
      right: 10px;
      top: 9px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .ptl__line span {
      background: linear-gradient(90deg, var(--accent), var(--good));
      transform-origin: 0 50%;
      transform: scaleX(var(--p, 1));
    }
  }
  .ptl__dot {
    position: absolute;
    left: -30px;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper);
    border: 5px solid var(--accent);
    box-shadow: 0 0 0 5px rgb(232 64 47 / 14%);
  }
  .ptl__when {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ptl .card {
    height: calc(100% - 32px);
  }
  .ptl h3 {
    font-size: 1.15rem;
  }
  .ptl .card > p {
    font-size: 0.94rem;
  }
  .ptl .checklist li {
    font-size: 0.9rem;
  }
  .ptl__out {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px dashed var(--line-2);
    font-size: 0.9rem;
    color: var(--ink);
  }
  .ptl__out b {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--good);
    margin-bottom: 2px;
  }
  @media (min-width: 960px) {
    .ptl {
      grid-template-columns: repeat(var(--cols, 3), 1fr);
      padding-left: 0;
      padding-top: 30px;
    }
    .ptl--4 {
      --cols: 4;
    }
    .ptl::before {
      left: 10px;
      right: 10px;
      top: 9px;
      bottom: auto;
      border-left: 0;
      border-top: 2px dashed var(--line-2);
    }
    .ptl__dot {
      left: 0;
      top: -30px;
    }
  }

  /* factors */
  .pfac {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .pfac {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 56px;
    }
  }
  .pfac__viz {
    position: relative;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }
  .pfac__viz svg {
    width: 100%;
    overflow: visible;
  }
  .pfac__ring {
    fill-opacity: 0.12;
    stroke-width: 2;
    transition:
      fill-opacity 0.35s var(--ease),
      transform 0.5s var(--ease);
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.js) .pfac__viz .pfac__ring {
    stroke-dasharray: 553;
    stroke-dashoffset: 553;
    fill-opacity: 0;
    transition:
      stroke-dashoffset 1.4s var(--ease) calc(var(--r, 0) * 0.25s),
      fill-opacity 0.8s var(--ease) calc(0.9s + var(--r, 0) * 0.25s),
      transform 0.5s var(--ease);
  }
  :global(.js) .pfac__viz.is-in .pfac__ring {
    stroke-dashoffset: 0;
    fill-opacity: 0.12;
  }
  .pfac__ring--1 {
    --r: 1;
  }
  .pfac__ring--2 {
    --r: 2;
  }
  :global(.js) .pfac__viz .pfac__pin,
  :global(.js) .pfac__viz .pfac__mid {
    opacity: 0;
    transition: opacity 0.5s 1.4s;
  }
  :global(.js) .pfac__viz.is-in .pfac__pin,
  :global(.js) .pfac__viz.is-in .pfac__mid {
    opacity: 1;
  }
  .pfac__ring--0 {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .pfac__ring--1 {
    fill: var(--good);
    stroke: var(--good);
  }
  .pfac__ring--2 {
    fill: var(--warn);
    stroke: var(--warn);
  }
  .pfac__lbl {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    fill: var(--ink);
  }
  .pfac__pin path {
    fill: var(--ink);
  }
  .pfac__pin {
    animation: pfacBob 3s var(--ease) infinite;
  }
  @keyframes pfacBob {
    50% {
      transform: translateY(-5px);
    }
  }
  .pfac__mid {
    position: absolute;
    left: 50%;
    top: 55%;
    translate: -50% 0;
    margin: 0;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .pfac:has(.pfac__item--0:hover, .pfac__item--0:focus) .pfac__ring--0,
  .pfac:has(.pfac__item--1:hover, .pfac__item--1:focus) .pfac__ring--1,
  .pfac:has(.pfac__item--2:hover, .pfac__item--2:focus) .pfac__ring--2 {
    fill-opacity: 0.32;
    transform: scale(1.04);
  }
  .pfac__list {
    display: grid;
    gap: 14px;
  }
  .pfac__item {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 16px;
    transition:
      border-color 0.25s,
      transform 0.35s var(--ease);
    outline: none;
  }
  .pfac__item:hover,
  .pfac__item:focus-visible {
    transform: translateX(6px);
    border-color: var(--line-2);
  }
  .pfac__key {
    width: 14px;
    height: 14px;
    margin-top: 6px;
    border-radius: 50%;
  }
  .pfac__item--0 .pfac__key {
    background: var(--accent);
  }
  .pfac__item--1 .pfac__key {
    background: var(--good);
  }
  .pfac__item--2 .pfac__key {
    background: var(--warn);
  }
  .pfac__item h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  .pfac__item p {
    font-size: 0.94rem;
    margin: 0;
  }
  .pfac__item .checklist {
    margin-top: 10px;
  }
  .pfac__item .checklist li {
    font-size: 0.88rem;
  }

  /* audit */
  .paud {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .paud {
      grid-template-columns: 1fr 320px;
    }
  }
  .paud__groups {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .paud__groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .paud__group {
    margin: 0;
    padding: 22px;
    border: 1px solid var(--line);
    min-width: 0;
  }
  .paud__group legend {
    float: left;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
  }
  .paud__group legend .num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font);
    font-size: 0.72rem;
  }
  .paud__row {
    clear: both;
    position: relative;
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-2);
    cursor: pointer;
  }
  .paud__row input {
    position: absolute;
    opacity: 0;
    width: 22px;
    height: 22px;
    margin: 0;
  }
  .paud__box {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    border: 2px solid var(--line-2);
    background: var(--paper);
    transition: all 0.2s var(--ease);
  }
  .paud__row input:focus-visible + .paud__box {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .paud__row input:checked + .paud__box {
    background: var(--good)
