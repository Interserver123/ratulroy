---
import { site } from "../../data/site";
// Mobile-only bottom bar: appears after the hero, hides near the final CTA and footer.
const { href = "/#free-audit" } = Astro.props as { href?: string };
---

<div class="scta" data-scta aria-hidden="true">
  <a class="scta__main" href={href} tabindex="-1">
    <span class="scta__pin" aria-hidden="true"></span>
    Free Map Pack audit
  </a>
  <a class="scta__wa" href={site.whatsapp} target="_blank" rel="noopener" tabindex="-1" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.9 2.3 1 2.5c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.3-.2z"/></svg>
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-scta]");
  const hero = document.querySelector<HTMLElement>(".phero");
  const stops = [...document.querySelectorAll<HTMLElement>(".fcta, footer")];
  if (bar && hero) {
    let heroGone = false;
    const nearEnd = new Set<Element>();
    const sync = () => {
      const show = heroGone && nearEnd.size === 0;
      bar.classList.toggle("is-on", show);
      bar.setAttribute("aria-hidden", String(!show));
      bar.querySelectorAll("a").forEach((a) => (a.tabIndex = show ? 0 : -1));
    };
    new IntersectionObserver(([e]) => {
      heroGone = !e.isIntersecting;
      sync();
    }).observe(hero);
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? nearEnd.add(e.target) : nearEnd.delete(e.target)));
      sync();
    });
    stops.forEach((s) => io.observe(s));
  }
</script>

<style>
  .scta {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    z-index: 45;
    display: flex;
    gap: 8px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(15 26 28 / 92%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 18px 40px -12px rgb(15 26 28 / 55%);
    transform: translateY(140%);
    transition: transform 0.45s var(--ease);
  }
  .scta.is-on {
    transform: none;
  }
  @media (min-width: 900px) {
    .scta {
      display: none;
    }
  }
  .scta__main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.97rem;
  }
  .scta__pin {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 70%);
    animation: sctaPulse 1.8s infinite;
  }
  @keyframes sctaPulse {
    70% {
      box-shadow: 0 0 0 9px rgb(255 255 255 / 0%);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0%);
    }
  }
  .scta__wa {
    display: grid;
    place-items: center;
    width: 50px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .scta {
      transition: none;
    }
    .scta__pin {
      animation: none;
    }
  }
</style>
