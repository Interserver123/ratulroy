---
import { Image } from "astro:assets";
import { img } from "../../lib/img";

// Listing cards for the hub pages (industries, case studies).
export interface HubItem {
  href: string;
  title: string;
  text: string;
  category?: string;
  value?: string;
  label?: string;
  image?: string;
}
interface Props {
  items: HubItem[];
  variant: "industry" | "case";
  heading?: string;
  eyebrow?: string;
  intro?: string;
}
const { items, variant, heading, eyebrow, intro } = Astro.props;
const cats = [...new Set(items.map((i) => i.category).filter(Boolean))] as string[];
const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section class="section hub" aria-labelledby={heading ? "hub-title" : undefined}>
  <div class="container">
    {
      (heading || eyebrow) && (
        <div class="section-head" data-reveal>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {heading && <h2 id="hub-title">{heading}</h2>}
          {intro && <p>{intro}</p>}
        </div>
      )
    }

    {
      variant === "industry" && cats.length > 1 && (
        <div class="hub__filters" role="toolbar" aria-label="Filter by category" data-reveal data-filter>
          <button type="button" class="hub__f is-on" data-f="all" aria-pressed="true">All <span>{items.length}</span></button>
          {cats.map((c) => (
            <button type="button" class="hub__f" data-f={c} aria-pressed="false">
              {c} <span>{items.filter((i) => i.category === c).length}</span>
            </button>
          ))}
        </div>
      )
    }

    {
      variant === "industry" ? (
        <ul class="hub__ind" role="list">
          {items.map((it, i) => (
            <li data-cat={it.category} data-reveal style={`--d:${i % 4}`}>
              <a class="ind card" href={it.href} data-spot>
                <span class="ind__top">
                  <span class="ind__n num">{pad(i)}</span>
                  {it.category && <span class="ind__cat">{it.category}</span>}
                </span>
                <h3>SEO for {it.title}</h3>
                <p>{it.text}</p>
                <span class="ind__q" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="m20 20-4-4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                  {it.title.toLowerCase()} near me
                </span>
                <span class="ind__go" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="hub__cases" role="list">
          {items.map((it, i) => (
            <li data-reveal style={`--d:${i % 3}`} class={i === 0 ? "is-lead" : undefined}>
              <a class="cs card" href={it.href} data-spot>
                {it.image && (
                  <span class="cs__shot">
                    <Image src={img(it.image)} alt="" widths={[480, 760, 1100]} sizes="(min-width: 1024px) 560px, 100vw" loading="lazy" />
                  </span>
                )}
                <span class="cs__body">
                  {it.category && <span class="cs__cat">{it.category}</span>}
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                  <span class="cs__foot">
                    {it.value && (
                      <span class="cs__metric">
                        <b class="num">{it.value}</b>
                        {it.label}
                      </span>
                    )}
                    <span class="cs__go">Read case study <span aria-hidden="true">→</span></span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-filter]").forEach((bar) => {
    const list = bar.parentElement?.querySelector<HTMLElement>(".hub__ind");
    if (!list) return;
    bar.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-f]");
      if (!btn) return;
      const f = btn.dataset.f!;
      bar.querySelectorAll("button").forEach((b) => {
        const on = b === btn;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", String(on));
      });
      list.querySelectorAll<HTMLElement>("li").forEach((li) => {
        li.hidden = f !== "all" && li.dataset.cat !== f;
      });
    });
  });
</script>

<style>
  .hub__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .hub__f {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--paper);
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }
  .hub__f span {
    color: var(--dim);
    font-weight: 500;
    margin-left: 4px;
  }
  .hub__f:hover {
    border-color: var(--ink);
  }
  .hub__f.is-on {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .hub__f.is-on span {
    color: rgb(255 255 255 / 60%);
  }

  /* ---- industries ---- */
  .hub__ind {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .ind {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px;
    color: var(--ink);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.2s;
  }
  .ind:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--line-2);
  }
  .ind__top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ind__n {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px 12px 12px 3px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .ind__cat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ind h3 {
    font-size: 1.22rem;
    margin: 6px 0 0;
  }
  .ind p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    flex: 1;
  }
  .ind__q {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .ind__go {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: all 0.3s var(--ease);
  }
  .ind:hover .ind__go {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: rotate(45deg);
  }

  /* ---- case studies ---- */
  .hub__cases {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 760px) {
    .hub__cases {
      grid-template-columns: 1fr 1fr;
    }
    .hub__cases .is-lead {
      grid-column: 1 / -1;
    }
    .hub__cases .is-lead .cs {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
    }
    .hub__cases .is-lead .cs__shot {
      aspect-ratio: auto;
      height: 100%;
      min-height: 320px;
    }
  }
  .cs {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    color: var(--ink);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .cs:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .cs__shot {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  .cs__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.6s var(--ease);
  }
  .cs:hover .cs__shot :global(img) {
    transform: scale(1.04);
  }
  .cs__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    flex: 1;
  }
  .cs__cat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cs h3 {
    font-size: 1.3rem;
    margin: 0;
  }
  .is-lead .cs h3 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }
  .cs p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .cs__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--line-2);
  }
  .cs__metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .cs__metric b {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--good);
  }
  .cs__go {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .cs:hover .cs__go {
    color: var(--accent);
  }
</style>
