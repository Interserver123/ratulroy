---
import { site, megaMenu, navLinks } from "../data/site";
---

<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__msg">
      <span class="pulse" aria-hidden="true"></span>
      <span>Accepting 2 new clients this month</span>
      <span class="topbar__loc">Based in Bangladesh · Serving worldwide</span>
    </p>
    <a class="topbar__cta" href={site.phoneHref}>Free 15-min consult <span aria-hidden="true">↗</span></a>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/" aria-label="Ratul Roy, Local SEO Bangladesh, home">
      <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="#0f1218"></rect>
        <rect x="1" y="1" width="62" height="62" rx="15" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="2"></rect>
        <path
          d="M32 12c-8.3 0-15 6.5-15 14.6C17 37.5 32 52 32 52s15-14.5 15-25.4C47 18.5 40.3 12 32 12Zm0 20a5.6 5.6 0 1 1 0-11.2A5.6 5.6 0 0 1 32 32Z"
          fill="#ff3d4a"></path>
      </svg>
      <span class="logo__text">
        <span class="logo__name">Ratul Roy</span>
        <span class="logo__tag">{site.tagline}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span></span><span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        <li><a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Home</a></li>
        <li class="has-mega">
          <a href="/services">Services</a>
          <button
            class="mega-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mega-services"
            aria-label="Show services menu"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"
              ><path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="1.8"
              ></path></svg
            >
          </button>
          <div id="mega-services" class="mega">
            <div class="mega__cols">
              {
                megaMenu.map((col) => (
                  <div>
                    <p class="mega__title">{col.title}</p>
                    <ul>
                      {col.links.map((l) => (
                        <li>
                          <a href={l.href}>{l.label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
            <a class="mega__promo" href="/book-strategy-call">
              <span>Grow your local business with strategic Local SEO</span>
              <strong>Book Call <span aria-hidden="true">→</span></strong>
            </a>
          </div>
        </li>
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="nav__cta">
        <a class="btn btn--ghost" href="/#results">See Results</a>
        <a class="btn btn--primary" href="/#contact">Book Strategy Call</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .topbar {
    border-bottom: 1px solid var(--line);
    font-size: 0.8rem;
    background: var(--bg);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 38px;
  }
  .topbar__msg {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    min-width: 0;
  }
  .topbar__loc {
    color: var(--dim);
    padding-left: 10px;
    border-left: 1px solid var(--line-2);
  }
  .pulse {
    position: relative;
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--good);
  }
  .pulse::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--good);
    animation: ping 2.2s ease-out infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.6);
      opacity: 0.9;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  .topbar__cta {
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
  }
  .topbar__cta span {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .topbar__loc {
      display: none;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 8 11 / 72%);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .logo__mark {
    width: 38px;
    height: 38px;
  }
  .logo__text {
    display: grid;
    line-height: 1.15;
  }
  .logo__name {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .logo__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 16px;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-inline: auto;
  }
  .nav__list > li {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav__list > li > a {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 8px 12px;
    border-radius: 999px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav__list > li > a:hover,
  .nav__list > li > a[aria-current="page"] {
    color: var(--text);
    background: rgb(255 255 255 / 5%);
  }
  .nav__cta {
    display: flex;
    gap: 8px;
  }
  .nav__cta .btn {
    min-height: 42px;
    padding: 8px 18px;
    font-size: 0.875rem;
  }

  .mega-toggle {
    background: none;
    border: 0;
    padding: 6px 4px;
    margin-left: -8px;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
  }
  .mega {
    display: none;
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-30%);
    width: min(780px, 92vw);
    background: rgb(15 18 24 / 96%);
    backdrop-filter: blur(20px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 80%);
    padding: 28px;
  }
  /* Hover bridge so the menu doesn't close crossing the gap */
  .mega::before {
    content: "";
    position: absolute;
    inset: -16px 0 auto;
    height: 16px;
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega,
  .has-mega.is-open .mega {
    display: block;
    animation: rise 0.2s ease-out;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .mega__title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 12px;
  }
  .mega li a {
    display: block;
    padding: 6px 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .mega li a:hover {
    color: var(--text);
  }
  .mega__promo {
    margin-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid rgb(255 61 74 / 30%);
    background: linear-gradient(100deg, rgb(255 61 74 / 14%), rgb(255 61 74 / 2%));
    color: var(--text);
  }
  .mega__promo strong {
    color: var(--accent);
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: rgb(255 255 255 / 3%);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .nav-toggle span {
    width: 18px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.2s;
  }
  .nav-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 1120px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 8px 16px 24px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
    }
    .nav.is-open {
      display: flex;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      margin: 0;
    }
    .nav__list > li {
      flex-wrap: wrap;
      border-bottom: 1px solid var(--line);
    }
    .nav__list > li > a {
      flex: 1;
      padding: 16px 0;
      font-size: 1rem;
      color: var(--text);
      border-radius: 0;
    }
    .nav__list > li > a:hover {
      background: none;
    }
    .mega-toggle {
      padding: 14px;
    }
    .mega,
    .has-mega:hover .mega,
    .has-mega:focus-within .mega {
      display: none;
      position: static;
      transform: none;
      width: 100%;
      box-shadow: none;
      border: 0;
      background: none;
      padding: 0 0 20px;
      animation: none;
    }
    .has-mega.is-open .mega {
      display: block;
    }
    .mega__cols {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .nav__cta {
      flex-direction: column;
      margin-top: 20px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  const megaToggle = document.querySelector<HTMLButtonElement>(".mega-toggle");
  megaToggle?.addEventListener("click", () => {
    const open = megaToggle.closest(".has-mega")?.classList.toggle("is-open") ?? false;
    megaToggle.setAttribute("aria-expanded", String(open));
  });

  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
