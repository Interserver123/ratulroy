---
import { Image } from "astro:assets";
import { img } from "../lib/img";
import { site, megaMenu, navLinks } from "../data/site";
---

<header class="header">
  <div class="header__bar">
    <a class="logo" href="/" aria-label="Ratul Roy, Local SEO Bangladesh, home">
      <Image src={img("brand/logo-rr.png")} alt="" width={76} height={76} class="logo__mark" loading="eager" />
      <span class="logo__text">
        <span class="logo__name">Ratul Roy</span>
        <span class="logo__tag">{site.tagline}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span></span><span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        <li><a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Home</a></li>
        <li class="has-mega">
          <a href="/services">Services</a>
          <button
            class="mega-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mega-services"
            aria-label="Show services menu"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"
              ><path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="1.8"
              ></path></svg
            >
          </button>
          <div id="mega-services" class="mega">
            <div class="mega__cols">
              {
                megaMenu.map((col) => (
                  <div>
                    <p class="mega__title">{col.title}</p>
                    <ul>
                      {col.links.map((l) => (
                        <li>
                          <a href={l.href}>{l.label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
            <a class="mega__promo" href="/book-strategy-call">
              <span>Grow your local business with strategic Local SEO</span>
              <strong>Book Call <span aria-hidden="true">→</span></strong>
            </a>
          </div>
        </li>
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={Astro.url.pathname.replace(/(\.html|\/)$/, "") === l.href ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__cta">
        <a class="btn btn--ghost" href="/#results">See Results</a>
        <a class="btn btn--dark" href="/#contact"><span class="disc" aria-hidden="true">↗</span>Book Strategy Call</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    padding: 14px max(12px, env(safe-area-inset-right, 0px)) 0 max(12px, env(safe-area-inset-left, 0px));
  }
  .header__bar {
    position: relative;
    max-width: 1180px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 64px;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  :global(.header.is-scrolled) .header__bar {
    background: rgb(255 255 255 / 78%);
    backdrop-filter: saturate(170%) blur(16px);
    -webkit-backdrop-filter: saturate(170%) blur(16px);
    border-color: var(--line);
    box-shadow: 0 12px 32px -16px rgb(16 42 40 / 25%);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .logo__mark {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 12px -4px rgb(15 26 28 / 45%);
  }
  .logo__text {
    display: grid;
    line-height: 1.1;
  }
  .logo__name {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .logo__tag {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 12px;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-inline: auto;
  }
  .nav__list > li {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav__list > li > a {
    color: var(--ink-2);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 8px 12px;
    border-radius: 999px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .nav__list > li > a:hover,
  .nav__list > li > a[aria-current="page"] {
    color: var(--ink);
    background: rgb(255 77 61 / 7%);
  }
  .nav__cta {
    display: flex;
    gap: 8px;
  }
  .nav__cta .btn {
    min-height: 46px;
    padding: 8px 18px;
    font-size: 0.875rem;
  }
  .nav__cta .btn--dark {
    padding-left: 22px;
  }

  .mega-toggle {
    background: none;
    border: 0;
    padding: 6px 4px;
    margin-left: -8px;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
  }
  .mega {
    display: none;
    position: absolute;
    top: calc(100% + 18px);
    left: 50%;
    transform: translateX(-30%);
    width: min(780px, 92vw);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 26px;
  }
  .mega::before {
    content: "";
    position: absolute;
    inset: -20px 0 auto;
    height: 20px;
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega,
  .has-mega:global(.is-open) .mega {
    display: block;
    animation: menu-in 0.25s var(--ease);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translate(-30%, 8px);
    }
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .mega__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .mega li a {
    display: block;
    padding: 6px 0;
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .mega li a:hover {
    color: var(--accent);
  }
  .mega__promo {
    margin-top: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: #fff;
  }
  .mega__promo:hover {
    color: #fff;
  }
  .mega__promo strong {
    color: var(--accent-2);
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .nav-toggle span {
    width: 18px;
    height: 1.5px;
    background: #fff;
    transition: transform 0.3s var(--ease);
  }
  .nav-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 1120px) {
    .header__bar {
      background: rgb(255 255 255 / 85%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-color: var(--line);
    }
    .nav-toggle {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      padding: 8px 20px 20px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
    }
    .nav:global(.is-open) {
      display: flex;
      animation: drop 0.3s var(--ease);
    }
    @keyframes drop {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      margin: 0;
    }
    .nav__list > li {
      flex-wrap: wrap;
      border-bottom: 1px solid var(--line);
    }
    .nav__list > li > a {
      flex: 1;
      padding: 15px 0;
      font-size: 1rem;
      border-radius: 0;
    }
    .nav__list > li > a:hover {
      background: none;
    }
    .mega-toggle {
      padding: 14px;
    }
    .mega,
    .has-mega:hover .mega,
    .has-mega:focus-within .mega {
      display: none;
      position: static;
      transform: none;
      width: 100%;
      box-shadow: none;
      border: 0;
      padding: 0 0 18px;
      animation: none;
    }
    .has-mega:global(.is-open) .mega {
      display: block;
    }
    .mega__cols {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .nav__cta {
      flex-direction: column;
      margin-top: 18px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  const megaToggle = document.querySelector<HTMLButtonElement>(".mega-toggle");
  megaToggle?.addEventListener("click", () => {
    const open = megaToggle.closest(".has-mega")?.classList.toggle("is-open") ?? false;
    megaToggle.setAttribute("aria-expanded", String(open));
  });

  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
