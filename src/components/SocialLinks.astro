---
// Icon links to Ratul Roy's social profiles (data in src/data/site.ts).
import { site } from "../data/site";
interface Props {
  labels?: boolean; // show the network name next to the icon
  class?: string;
}
const { labels = false, class: cls = "" } = Astro.props;
const paths: Record<string, string> = {
  facebook: "M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9H17l.5-4h-4V8.8c0-.5.3-.8.5-.8z",
  linkedin: "M4.5 9h3.8v12H4.5zM6.4 3a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM10.6 9h3.6v1.7h.1c.5-.9 1.7-2 3.6-2 3.8 0 4.6 2.5 4.6 5.8V21h-3.8v-5.8c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21h-3.8z",
  youtube: "M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15V9l5.8 3z",
};
---

{
  site.social.length > 0 && (
    <ul class:list={["social", { "social--labels": labels }, cls]} aria-label="Ratul Roy on social media">
      {site.social.map((x) => (
        <li>
          <a href={x.href} rel="me noopener" target="_blank" aria-label={labels ? undefined : x.name} title={x.name}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d={paths[x.icon]} fill="currentColor" />
            </svg>
            {labels && <span>{x.label}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .social a {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-width: 40px; height: 40px; padding: 0 10px; border-radius: 999px;
    border: 1px solid currentColor; color: inherit; text-decoration: none; font-size: 0.88rem; font-weight: 600;
    opacity: 0.85; transition: opacity 0.2s, transform 0.2s, background 0.2s;
  }
  .social--labels a { padding: 0 14px 0 12px; }
  .social a:hover { opacity: 1; transform: translateY(-2px); }
  .social a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .social a { transition: none; } .social a:hover { transform: none; } }
</style>
