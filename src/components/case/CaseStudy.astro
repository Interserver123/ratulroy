---
// Dedicated case-study layout: a report, not a sales page.
// Cover with the scoreboard → at a glance → chapters (challenge, approach, results,
// evidence, takeaways) beside a sticky contents list → more case studies.
import { Image, getImage } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { img } from "../../lib/img";
import { md, slugify } from "../../lib/md";
import { site } from "../../data/site";

interface Props {
  data: CollectionEntry<"cases">["data"];
  id: string;
}
const { data: d, id } = Astro.props;

const portrait = img("people/ratul-roy-portrait.jpg");
const fmtDate = (x: Date) => x.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const updatedIso = d.updated?.toISOString().slice(0, 10);

// "**Client:** … **Focus:** …" in the first intro paragraph becomes the at-a-glance facts.
const facts: { label: string; value: string }[] = [];
const intro0 = d.intro?.[0] ?? "";
for (const m of intro0.matchAll(/\*\*([^*:]+):\*\*\s*([\s\S]*?)(?=\s*\*\*[^*]+:\*\*|$)/g)) {
  facts.push({ label: m[1].trim(), value: m[2].trim() });
}
const extraIntro = facts.length ? (d.intro ?? []).slice(1) : (d.intro ?? []);

// Category tags from the eyebrow, e.g. "Case Study · Towing Company · Beaumont, TX".
const tags = (d.eyebrow ?? "").split("·").map((t) => t.trim()).filter((t) => t && !/^case study$/i.test(t));

// Chapters: each section gets an id, a short contents label and a kind.
const kindLabel: Record<string, string> = {
  problems: "The challenge",
  steps: "What I did",
  stats: "Results",
  images: "Evidence",
  list: "Takeaways",
};
const chapters = d.sections.map((s, i) => {
  const eyebrow = (s.eyebrow ?? "").replace(/^\d+\s*·\s*/, "");
  return {
    s,
    id: s.id ?? slugify(s.heading ?? `${s.type}-${i}`),
    label: eyebrow || kindLabel[s.type] || s.heading || "",
  };
});

// Reading time from the page's words.
const words = [d.lead, ...(d.intro ?? []), ...d.sections.flatMap((s) => [s.heading, s.intro, ...(s.body ?? []), ...(s.bullets ?? []), ...(s.items ?? []).flatMap((it) => [it.title, it.text])])]
  .join(" ")
  .split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 220));

// Hero proof screenshot, plus a large version for the zoom view.
const heroSrc = d.heroImage ? img(d.heroImage) : null;
const heroFull = heroSrc ? await getImage({ src: heroSrc, width: Math.min(1800, heroSrc.width) }) : null;

// Every evidence screenshot gets a large version for the zoom view.
const fullOf = new Map<string, string>();
for (const s of d.sections) {
  for (const it of s.items ?? []) {
    if (it.image && !fullOf.has(it.image)) {
      const src = img(it.image);
      fullOf.set(it.image, (await getImage({ src, width: Math.min(1800, src.width) })).src);
    }
  }
}

// Other case studies to read next.
const others = (await getCollection("cases"))
  .filter((e) => e.id !== id)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const h1Parts = d.em && d.h1.includes(d.em) ? d.h1.split(d.em) : null;
const audit = "/#free-audit";
---

<section class="cover phero" aria-labelledby="case-title">
  <div class="container cover__inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {(d.breadcrumb ?? []).map((c, i, all) => (
          <li>{i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>

    <div class="cover__grid">
      <div class="cover__copy">
        <p class="cover__kicker">
          <span class="cover__badge">Case study</span>
          {tags.map((t) => <span class="cover__tag">{t}</span>)}
        </p>
        <h1 id="case-title">
          {h1Parts ? (
            <>
              {h1Parts[0]}
              <span class="cover__em">{d.em}</span>
              {h1Parts[1]}
            </>
          ) : (
            d.h1
          )}
        </h1>
        {d.lead && <p class="cover__lead" set:html={md(d.lead)} />}
        <p class="cover__meta">
          <Image src={portrait} alt="" width={64} height={64} />
          <span>
            By <a href="/about">Ratul Roy</a>
            {updatedIso && <> · Updated <time datetime={updatedIso}>{fmtDate(d.updated!)}</time></>} · {minutes} min read
          </span>
        </p>
      </div>

      {heroSrc && (
        <figure class="cover__shot">
          <button type="button" class="zoom" data-full={heroFull?.src} data-alt={`${d.h1}: proof screenshot`} aria-label="Enlarge proof screenshot">
            <span class="cover__bar" aria-hidden="true"><i></i><i></i><i></i></span>
            <Image src={heroSrc} alt={`${d.h1}: proof screenshot`} widths={[480, 720, 960]} sizes="(min-width: 1024px) 520px, 92vw" loading="eager" fetchpriority="high" />
          </button>
          <figcaption><span class="dot" aria-hidden="true"></span>Real screenshot · tap to zoom</figcaption>
        </figure>
      )}
    </div>

    {d.heroStats && d.heroStats.length > 0 && (
      <dl class="score" aria-label="Headline results" style={`--n:${d.heroStats.length}`}>
        {d.heroStats.map((st) => (
          <div class="score__item">
            <dt>{st.label}</dt>
            <dd class="num">{st.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="cover__ctas">
      <a class="btn btn--accent" href={audit}><span class="disc" aria-hidden="true">↗</span>Get results like this</a>
      <a class="cover__jump" href={`#${chapters.find((c) => c.s.type === "images")?.id ?? chapters[0]?.id}`}>See the proof ↓</a>
    </div>
  </div>
</section>

{facts.length > 0 && (
  <section class="glance" aria-label="Case study at a glance">
    <div class="container">
      <dl class="glance__grid">
        {facts.map((f) => (
          <div class={`glance__item${/result/i.test(f.label) ? " glance__item--key" : ""}`}>
            <dt>{f.label}</dt>
            <dd set:html={md(f.value)} />
          </div>
        ))}
      </dl>
      {extraIntro.map((p) => <p class="glance__note" set:html={md(p)} />)}
    </div>
  </section>
)}

<div class="container report">
  <aside class="toc" aria-label="Contents">
    <div class="toc__box">
      <p class="toc__title">In this case study</p>
      <ol>
        {chapters.map((c) => (
          <li><a href={`#${c.id}`} data-toc={c.id}>{c.label}</a></li>
        ))}
      </ol>
    </div>
    <div class="toc__cta">
      <Image src={portrait} alt="" width={96} height={96} class="toc__face" />
      <p><strong>Want this for your business?</strong> I'll audit your site and Google profile for free and show you what to fix first.</p>
      <a class="btn btn--dark" href={audit}>Get a free audit</a>
      <a class="toc__call" href="/book-strategy-call">or book a strategy call</a>
    </div>
  </aside>

  <article class="chapters">
    {chapters.map(({ s, id: cid, label }, i) => (
      <section class={`chap chap--${s.type}`} id={cid} aria-labelledby={`${cid}-h`}>
        <header class="chap__head" data-reveal>
          <p class="chap__label"><span class="chap__no num">{String(i + 1).padStart(2, "0")}</span>{label}</p>
          {s.heading && <h2 id={`${cid}-h`}>{s.heading}</h2>}
          {s.intro && <p class="chap__intro" set:html={md(s.intro)} />}
        </header>

        {s.type === "problems" && s.items && (
          <ul class="issues">
            {s.items.map((it) => (
              <li data-reveal>
                <span class="issues__mark" aria-hidden="true">✕</span>
                <div>
                  {it.title && <h3>{it.title}</h3>}
                  {it.text && <p set:html={md(it.text)} />}
                </div>
              </li>
            ))}
          </ul>
        )}

        {s.type === "steps" && s.items && (
          <ol class="path">
            {s.items.map((it, n) => (
              <li data-reveal>
                <span class="path__no num" aria-hidden="true">{n + 1}</span>
                <div>
                  {it.title && <h3>{it.title}</h3>}
                  {it.text && <p set:html={md(it.text)} />}
                </div>
              </li>
            ))}
          </ol>
        )}

        {s.type === "stats" && s.items && (
          <dl class={`wins${s.items.length > 4 ? " wins--many" : ""}`}>
            {s.items.map((it) => (
              <div data-reveal>
                <dt>{it.title}</dt>
                <dd class="num">{it.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {s.type === "images" && s.items && (
          <div class={`proof${s.items.length === 1 ? " proof--one" : ""}`}>
            {s.items.map((it) =>
              it.image ? (
                <figure data-reveal>
                  <button type="button" class="zoom" data-full={fullOf.get(it.image)} data-alt={it.title ?? ""} aria-label={`Enlarge screenshot: ${it.title ?? ""}`}>
                    <Image src={img(it.image)} alt={`${it.title ?? ""}${it.text ? `. ${it.text}` : ""}`} widths={[400, 640, 960]} sizes={s.items!.length === 1 ? "(min-width: 1024px) 760px, 92vw" : "(min-width: 1024px) 380px, 92vw"} loading="lazy" />
                    <span class="zoom__hint" aria-hidden="true">⤢</span>
                  </button>
                  <figcaption>
                    {it.title && <strong>{it.title}</strong>}
                    {it.text && <span set:html={md(it.text)} />}
                  </figcaption>
                </figure>
              ) : null,
            )}
          </div>
        )}

        {s.type === "list" && s.bullets && (
          <ul class="takeaways" data-reveal>
            {s.bullets.map((b) => <li set:html={md(b)} />)}
          </ul>
        )}

        {s.body && s.body.map((p) => <p class="chap__body" set:html={md(p)} />)}

        {s.type === "stats" && i === chapters.findIndex((c) => c.s.type === "stats") && (
          <aside class="nudge" data-reveal>
            <p><strong>Is your business leaving calls like these on the table?</strong> Get a free audit of your rankings, Google profile and competitors.</p>
            <a class="btn btn--accent" href={audit}><span class="disc" aria-hidden="true">↗</span>Get my free audit</a>
          </aside>
        )}
      </section>
    ))}
  </article>
</div>

{others.length > 0 && (
  <section class="section more" aria-labelledby="more-title">
    <div class="container">
      <div class="more__head">
        <h2 id="more-title">More case studies</h2>
        <a class="text-link" href="/case-studies">All case studies</a>
      </div>
      <ul class="more__grid">
        {others.map((e) => {
          const c = e.data.card;
          const im = c?.image ?? e.data.heroImage;
          return (
            <li class="more__card">
              {im && <Image src={img(im)} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 360px, 92vw" loading="lazy" />}
              <div class="more__body">
                {c?.value && <p class="more__value num">{c.value} <span>{c.label}</span></p>}
                <h3><a href={`/case-studies/${e.id}`}>{c?.title ?? e.data.h1}</a></h3>
                {c?.category && <p class="more__cat">{c.category}</p>}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<dialog class="lb" data-lb aria-label="Screenshot">
  <form method="dialog"><button class="lb__close" aria-label="Close">×</button></form>
  <img alt="" width="1600" height="1000" data-lb-img />
</dialog>

<script>
  // Zoom any proof screenshot.
  const lb = document.querySelector<HTMLDialogElement>("[data-lb]");
  const lbImg = lb?.querySelector<HTMLImageElement>("[data-lb-img]");
  document.querySelectorAll<HTMLButtonElement>(".zoom").forEach((b) =>
    b.addEventListener("click", () => {
      if (!lb || !lbImg || !b.dataset.full) return;
      lbImg.src = b.dataset.full;
      lbImg.alt = b.dataset.alt ?? "";
      lb.showModal();
    }),
  );
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) lb.close();
  });

  // Highlight the chapter being read in the contents list.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]));
  if (links.size && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          links.forEach((a) => a.removeAttribute("aria-current"));
          links.get(en.target.id)?.setAttribute("aria-current", "true");
        });
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    links.forEach((_, cid) => {
      const el = document.getElementById(cid);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  /* ---------- Cover: dark "report" header ---------- */
  .cover {
    position: relative;
    color: #e9f0ee;
    background:
      radial-gradient(60% 80% at 85% 10%, rgb(255 106 85 / 22%), transparent 60%),
      radial-gradient(50% 60% at 0% 100%, rgb(8 122 76 / 22%), transparent 60%),
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 100% 32px,
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 32px 100%,
      #0f1a1c;
    padding: 130px 0 56px;
    overflow: hidden;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: #9fb0ac;
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 6px;
    opacity: 0.5;
  }
  .crumbs a {
    color: #c9d6d3;
  }
  .cover__grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cover__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
    }
  }
  .cover__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 18px;
  }
  .cover__badge,
  .cover__tag {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .cover__badge {
    background: var(--accent-2);
    color: #fff;
    text-transform: uppercase;
  }
  .cover__tag {
    border: 1px solid rgb(255 255 255 / 18%);
    color: #d5e0dd;
  }
  .cover h1 {
    color: #fff;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    margin: 0 0 18px;
  }
  .cover__em {
    color: var(--accent-2);
  }
  .cover__lead {
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    color: #c9d6d3;
    max-width: 60ch;
  }
  .cover__lead :global(a) {
    color: #fff;
  }
  .cover__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 0;
    font-size: 0.85rem;
    color: #9fb0ac;
  }
  .cover__meta a {
    color: #fff;
    text-decoration: underline;
  }
  .cover__meta :global(img) {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgb(255 255 255 / 20%);
  }
  .cover__shot {
    margin: 0;
    transform: rotate(1.2deg);
    transition: transform 0.6s var(--ease);
  }
  .cover__shot:hover {
    transform: none;
  }
  .cover__shot .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 70%);
    cursor: zoom-in;
  }
  .cover__bar {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    background: #eef3f1;
    border-bottom: 1px solid var(--line);
  }
  .cover__bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cdd8d4;
  }
  .cover__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    object-position: top left;
  }
  .cover__shot figcaption {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.8rem;
    color: #9fb0ac;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc97;
    box-shadow: 0 0 0 4px rgb(61 220 151 / 20%);
  }
  .score {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    gap: 1px;
    margin: 48px 0 0;
    border-radius: 18px;
    overflow: hidden;
    background: rgb(255 255 255 / 12%);
    border: 1px solid rgb(255 255 255 / 12%);
  }
  .score__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 22px 24px;
    background: rgb(15 26 28 / 85%);
  }
  .score dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: #fff;
  }
  .score__item:first-child dd {
    color: #3ddc97;
  }
  .score dt {
    font-size: 0.85rem;
    color: #9fb0ac;
  }
  @media (max-width: 600px) {
    .score__item {
      padding: 16px 12px;
    }
    .score dd {
      font-size: 1.9rem;
    }
    .score dt {
      font-size: 0.72rem;
    }
  }
  .cover__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }
  .cover__jump {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .btn--accent {
    background: var(--accent);
    color: #fff;
  }
  .btn--accent:hover {
    background: #a82614;
  }

  /* ---------- At a glance ---------- */
  .glance {
    padding: 0;
  }
  .glance__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: -28px 0 0;
    position: relative;
  }
  .glance__item {
    flex: 1 1 240px;
    padding: 20px 22px;
    border-radius: var(--radius-sm);
    background: var(--paper);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .glance__item--key {
    flex-basis: 100%;
    border-left: 4px solid var(--good);
  }
  .glance dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 6px;
  }
  .glance dd {
    margin: 0;
    color: var(--ink);
    line-height: 1.55;
  }
  .glance dd :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .glance__note {
    max-width: 72ch;
    margin: 20px 0 0;
  }

  /* ---------- Report body ---------- */
  .report {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding-block: 64px 32px;
  }
  @media (min-width: 1024px) {
    .report {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 64px;
    }
    .toc {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
  @media (max-width: 1023px) {
    .toc__cta {
      display: none;
    }
    .report .toc__box {
      padding: 12px 0;
      background: none;
      border: 0;
    }
    .report .toc ol {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .report .toc li a {
      white-space: nowrap;
      border: 1px solid var(--line);
      background: var(--paper);
      border-radius: 999px;
      padding: 7px 14px;
    }
    .report {
      gap: 24px;
      padding-top: 40px;
    }
  }
  .toc {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .toc__box {
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .toc__title {
    margin: 0 0 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: t;
    display: grid;
    gap: 2px;
  }
  .toc li {
    counter-increment: t;
  }
  .toc li a {
    display: flex;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .toc li a::before {
    content: counter(t, decimal-leading-zero);
    font-size: 0.75rem;
    color: var(--dim);
    padding-top: 2px;
  }
  .toc li a:hover,
  .toc li a[aria-current] {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .toc__cta {
    padding: 20px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: #c9d6d3;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .toc__cta strong {
    display: block;
    color: #fff;
    font-size: 1rem;
    margin-bottom: 4px;
  }
  .toc__cta :global(.toc__face) {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 10px;
  }
  .toc__cta .btn {
    width: 100%;
    justify-content: center;
    margin-top: 14px;
    background: #fff;
    color: var(--ink);
  }
