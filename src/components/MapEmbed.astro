---
import { site } from "../data/site";

// Google Business Profile map, lazy-loaded, in a branded frame.
interface Props {
  heading?: string;
  compact?: boolean;
}
const { heading = "Find me on Google Maps", compact = false } = Astro.props;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.gbpName)}`;
---

<div class={`gmap card${compact ? " gmap--compact" : ""}`} data-reveal>
  <div class="gmap__head">
    <span class="gmap__pin" aria-hidden="true"></span>
    <div>
      <p class="gmap__title">{heading}</p>
      <p class="gmap__sub">{site.gbpName}</p>
    </div>
    <div class="gmap__btns">
      <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener">Open in Maps</a>
      <a class="btn btn--dark" href={directions} target="_blank" rel="noopener"><span class="disc" aria-hidden="true">↗</span>Directions</a>
    </div>
  </div>
  <div class="gmap__frame">
    <iframe
      src={site.mapEmbed}
      title={`${site.gbpName} on Google Maps`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </div>
</div>

<style>
  .gmap {
    overflow: hidden;
    padding: 0;
    box-shadow: var(--shadow-lg);
  }
  .gmap__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 16px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }
  .gmap__pin {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50% 50% 50% 4px;
    transform: rotate(-45deg);
    background: var(--accent);
    box-shadow: 0 6px 14px rgb(232 64 47 / 35%);
    position: relative;
  }
  .gmap__pin::after {
    content: "";
    position: absolute;
    inset: 11px;
    border-radius: 50%;
    background: #fff;
  }
  .gmap__head > div:nth-child(2) {
    flex: 1;
    min-width: 200px;
  }
  .gmap__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .gmap__sub {
    margin: 2px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .gmap__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .gmap__btns .btn {
    padding-block: 10px;
    font-size: 0.9rem;
  }
  .gmap__frame {
    position: relative;
    aspect-ratio: 16 / 7;
    min-height: 300px;
    background:
      url("/topo.svg") center / 700px auto,
      var(--bg-2);
  }
  .gmap--compact .gmap__frame {
    aspect-ratio: 16 / 9;
  }
  .gmap__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 640px) {
    .gmap__frame {
      aspect-ratio: 4 / 5;
    }
    .gmap__btns {
      width: 100%;
    }
    .gmap__btns .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
