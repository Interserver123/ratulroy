---
import { site, footerColumns } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href="/">Ratul Roy</a>
        <p>
          This is Ratul Roy helping service businesses improve Google Maps rankings, strengthen
          Google Business Profile visibility, and turn local searches into qualified inbound calls.
        </p>
        <ul class="chips">
          <li class="chip">Fiverr Level 2 Seller</li>
          <li class="chip"><span class="stars" aria-hidden="true">★</span>4.9 Rated</li>
          <li class="chip">243 Reviews</li>
        </ul>
        <p class="footer__small">Built for local businesses that want visibility, trust, and real growth.</p>
        <p class="footer__small">Based in Bangladesh · Serving local businesses worldwide</p>
      </div>

      {
        footerColumns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="footer__title">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="footer__title">Contact</h2>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.whatsapp} rel="noopener" target="_blank">Chat on WhatsApp</a></li>
        </ul>
        <p class="footer__small">Prefer WhatsApp for faster replies.</p>
      </div>
    </div>

    <p class="footer__word" aria-hidden="true">Ratul Roy</p>

    <div class="footer__bottom">
      <p>© {year} Ratul Roy. All rights reserved.</p>
      <p>Built for the new era of Google Maps, Local SEO, and AI-driven search visibility.</p>
      <p class="footer__legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    padding: 88px 0 32px;
    font-size: 0.9rem;
    background:
      radial-gradient(60% 50% at 50% 100%, rgb(255 61 74 / 10%), transparent 70%),
      var(--bg);
  }
  .footer__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.6fr repeat(4, 1fr);
    }
  }
  .footer__logo {
    display: inline-block;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 14px;
  }
  .footer__brand .chips {
    margin-bottom: 18px;
  }
  .footer__title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 16px;
  }
  .footer li {
    margin-bottom: 10px;
  }
  .footer a {
    color: var(--muted);
  }
  .footer a:hover {
    color: var(--text);
  }
  .footer__small {
    font-size: 0.85rem;
    color: var(--dim);
    margin-bottom: 6px;
  }
  .footer__word {
    margin: 64px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(4.5rem, 17vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(255 255 255 / 14%), rgb(255 255 255 / 0%) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }
  .footer__bottom {
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--dim);
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    gap: 18px;
  }
</style>
