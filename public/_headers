# Cloudflare Pages response headers.
# After ratulroy.com is live, also add this block so the preview domain is never indexed:
#   https://:project.pages.dev/*
#     X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted build assets never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Social cards change only when titles change.
/og/*
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

# Private dashboard: never indexed, cached or framed (see docs/BACKEND.md).
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  X-Frame-Options: DENY
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  X-Frame-Options: DENY
